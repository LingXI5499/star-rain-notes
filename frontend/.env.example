# 前端构建的公开环境模板；这里的值可被浏览器读到，不能配置密码或访问令牌。
# Public footer identity only; never put secrets in VITE_* variables.
# 页脚展示的公开域名；VITE 变量会写入浏览器产物。
VITE_SITE_DOMAIN=
# 公开展示的 ICP 备案文字；留空则不展示。
VITE_ICP_RECORD=
# 公开展示的公安备案文字；与跳转编码分别配置。
VITE_PUBLIC_SECURITY_RECORD=
# 公安备案查询链接的公开编号；不属于服务端认证信息。
VITE_PUBLIC_SECURITY_CODE=
