# Publish only the active source and verification configuration.
/*
!/backend/
!/frontend/
!/.github/
!/README.md
!/LICENSE
!/.gitignore
!/.gitattributes
**/node_modules/
**/target/
**/dist/
**/.vite/
**/.local/
**/uploads/
**/data/
/backend/media/
**/.idea/
**/.vscode/
**/test-results/
**/playwright-report/
*.log
*.iml
*.jar
*.zip
*.bak
*.dump
*.sql.gz
*.sql.zip
Thumbs.db
.DS_Store
# Keep real configuration private; publish placeholder templates only.
**/.env
**/.env.*
!**/.env.example
**/application-*-secret.yml
**/application-*-secret.yaml
!**/application-local-secret.example.yml
**/flyway-local.conf
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/.codex-maven-settings.xml
