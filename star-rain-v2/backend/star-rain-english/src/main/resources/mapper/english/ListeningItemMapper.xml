<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.starrainnotes.english.listening.mapper.ListeningItemMapper">
    <resultMap id="itemMap" type="com.starrainnotes.english.listening.dto.ListeningItemDto$Item">
        <id property="id" column="id"/>
        <result property="slug" column="slug"/>
        <result property="title" column="title"/>
        <result property="summary" column="summary"/>
        <result property="bodyMarkdown" column="transcript_markdown"/>
        <result property="cefrLevel" column="cefr_level"/>
        <result property="difficultyLevel" column="listening_level"/>
        <result property="audioMediaId" column="audio_media_id"/>
        <result property="durationSeconds" column="duration_seconds"/>
        <result property="sourceName" column="source_name"/>
        <result property="sourceUrl" column="source_url"/>
        <result property="publishStatus" column="publish_status"/>
        <result property="sortOrder" column="sort_order"/>
    </resultMap>
    <sql id="columns">
        id,slug,title,summary,transcript_markdown,cefr_level,listening_level,
        audio_media_id,duration_seconds,source_name,source_url,publish_status,sort_order
    </sql>
    <sql id="filter">
        <where>
            <if test="publicOnly">publish_status='PUBLISHED'</if>
            <if test="search != null and search != ''">AND title LIKE CONCAT('%',#{search},'%')</if>
        </where>
    </sql>
    <select id="count" resultType="long">
        SELECT COUNT(*) FROM sr_english_listening_item <include refid="filter"/>
    </select>
    <select id="list" resultMap="itemMap">
        SELECT <include refid="columns"/> FROM sr_english_listening_item
        <include refid="filter"/> ORDER BY sort_order,id LIMIT #{limit} OFFSET #{offset}
    </select>
    <select id="byId" resultMap="itemMap">
        SELECT <include refid="columns"/> FROM sr_english_listening_item WHERE id=#{id}
    </select>
    <select id="publicBySlug" resultMap="itemMap">
        SELECT <include refid="columns"/> FROM sr_english_listening_item
        WHERE slug=#{slug} AND publish_status='PUBLISHED'
    </select>
    <insert id="insert" parameterType="com.starrainnotes.english.listening.dto.ListeningItemDto$Item"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sr_english_listening_item
        (slug,title,summary,transcript_markdown,cefr_level,listening_level,audio_media_id,
         duration_seconds,source_name,source_url,sort_order)
        VALUES (#{slug},#{title},#{summary},#{bodyMarkdown},#{cefrLevel},#{difficultyLevel},
                #{audioMediaId},#{durationSeconds},#{sourceName},#{sourceUrl},#{sortOrder})
    </insert>
    <update id="update">
        UPDATE sr_english_listening_item SET slug=#{slug},title=#{title},summary=#{summary},
        transcript_markdown=#{bodyMarkdown},cefr_level=#{cefrLevel},listening_level=#{difficultyLevel},
        audio_media_id=#{audioMediaId},duration_seconds=#{durationSeconds},
        source_name=#{sourceName},source_url=#{sourceUrl},sort_order=#{sortOrder} WHERE id=#{id}
    </update>
    <update id="setStatus">
        UPDATE sr_english_listening_item SET publish_status=#{status},
        published_at=COALESCE(published_at,NOW(3)) WHERE id=#{id}
    </update>
    <delete id="deleteSegments">
        DELETE FROM sr_english_listening_segment WHERE listening_item_id=#{itemId}
    </delete>
    <delete id="delete">DELETE FROM sr_english_listening_item WHERE id=#{id}</delete>
</mapper>
