<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.starrainnotes.english.writing.mapper.WritingPromptMapper">
    <resultMap id="promptMap" type="com.starrainnotes.english.writing.dto.WritingPromptDto$Prompt">
        <id property="id" column="id"/>
        <result property="slug" column="slug"/>
        <result property="title" column="title"/>
        <result property="summary" column="summary"/>
        <result property="bodyMarkdown" column="background_markdown"/>
        <result property="requirementsMarkdown" column="requirements_markdown"/>
        <result property="cefrLevel" column="cefr_level"/>
        <result property="wordMin" column="word_min"/>
        <result property="wordMax" column="word_max"/>
        <result property="estimatedMinutes" column="estimated_minutes"/>
        <result property="publishStatus" column="publish_status"/>
        <result property="sortOrder" column="sort_order"/>
    </resultMap>
    <sql id="columns">
        id,slug,title,summary,background_markdown,requirements_markdown,
        cefr_level,word_min,word_max,estimated_minutes,publish_status,sort_order
    </sql>
    <sql id="filter">
        <where>
            <if test="publicOnly">publish_status='PUBLISHED'</if>
            <if test="search != null and search != ''">AND title LIKE CONCAT('%',#{search},'%')</if>
        </where>
    </sql>
    <select id="count" resultType="long">
        SELECT COUNT(*) FROM sr_english_writing_prompt <include refid="filter"/>
    </select>
    <select id="list" resultMap="promptMap">
        SELECT <include refid="columns"/> FROM sr_english_writing_prompt
        <include refid="filter"/> ORDER BY sort_order,id LIMIT #{limit} OFFSET #{offset}
    </select>
    <select id="byId" resultMap="promptMap">
        SELECT <include refid="columns"/> FROM sr_english_writing_prompt WHERE id=#{id}
    </select>
    <select id="publicBySlug" resultMap="promptMap">
        SELECT <include refid="columns"/> FROM sr_english_writing_prompt
        WHERE slug=#{slug} AND publish_status='PUBLISHED'
    </select>
    <insert id="insert" parameterType="com.starrainnotes.english.writing.dto.WritingPromptDto$Prompt"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sr_english_writing_prompt
        (title,slug,summary,background_markdown,requirements_markdown,cefr_level,
         word_min,word_max,estimated_minutes,sort_order)
        VALUES (#{title},#{slug},#{summary},#{bodyMarkdown},#{requirementsMarkdown},
                #{cefrLevel},#{wordMin},#{wordMax},#{estimatedMinutes},#{sortOrder})
    </insert>
    <update id="update">
        UPDATE sr_english_writing_prompt SET title=#{title},slug=#{slug},summary=#{summary},
        background_markdown=#{bodyMarkdown},requirements_markdown=#{requirementsMarkdown},
        cefr_level=#{cefrLevel},word_min=#{wordMin},word_max=#{wordMax},
        estimated_minutes=#{estimatedMinutes},sort_order=#{sortOrder} WHERE id=#{id}
    </update>
    <update id="setStatus">
        UPDATE sr_english_writing_prompt SET publish_status=#{status},
        published_at=COALESCE(published_at,NOW(3)) WHERE id=#{id}
    </update>
    <delete id="delete">DELETE FROM sr_english_writing_prompt WHERE id=#{id}</delete>
</mapper>
