<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.starrainnotes.english.writing.mapper.WritingResourceMapper">
    <resultMap id="resourceMap" type="com.starrainnotes.english.writing.dto.WritingResourceDto$Resource">
        <id property="id" column="id"/>
        <result property="slug" column="slug"/>
        <result property="resourceKind" column="resource_kind"/>
        <result property="title" column="title"/>
        <result property="summary" column="summary"/>
        <result property="bodyMarkdown" column="body_markdown"/>
        <result property="cefrLevel" column="cefr_level"/>
        <result property="publishStatus" column="publish_status"/>
        <result property="sortOrder" column="sort_order"/>
    </resultMap>
    <sql id="columns">id,slug,resource_kind,title,summary,body_markdown,cefr_level,publish_status,sort_order</sql>
    <sql id="filter">
        <where>
            <if test="publicOnly">publish_status='PUBLISHED'</if>
            <if test="search != null and search != ''">AND title LIKE CONCAT('%',#{search},'%')</if>
        </where>
    </sql>
    <select id="count" resultType="long">
        SELECT COUNT(*) FROM sr_english_writing_resource <include refid="filter"/>
    </select>
    <select id="list" resultMap="resourceMap">
        SELECT <include refid="columns"/> FROM sr_english_writing_resource
        <include refid="filter"/> ORDER BY sort_order,id LIMIT #{limit} OFFSET #{offset}
    </select>
    <select id="byId" resultMap="resourceMap">
        SELECT <include refid="columns"/> FROM sr_english_writing_resource WHERE id=#{id}
    </select>
    <select id="publicBySlug" resultMap="resourceMap">
        SELECT <include refid="columns"/> FROM sr_english_writing_resource
        WHERE slug=#{slug} AND publish_status='PUBLISHED'
    </select>
    <insert id="insert" parameterType="com.starrainnotes.english.writing.dto.WritingResourceDto$Resource"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sr_english_writing_resource
        (resource_kind,title,slug,summary,body_markdown,cefr_level,sort_order)
        VALUES (#{resourceKind},#{title},#{slug},#{summary},#{bodyMarkdown},#{cefrLevel},#{sortOrder})
    </insert>
    <update id="update">
        UPDATE sr_english_writing_resource SET resource_kind=#{resourceKind},title=#{title},
        slug=#{slug},summary=#{summary},body_markdown=#{bodyMarkdown},
        cefr_level=#{cefrLevel},sort_order=#{sortOrder} WHERE id=#{id}
    </update>
    <update id="setStatus">
        UPDATE sr_english_writing_resource SET publish_status=#{status},
        published_at=COALESCE(published_at,NOW(3)) WHERE id=#{id}
    </update>
    <delete id="delete">DELETE FROM sr_english_writing_resource WHERE id=#{id}</delete>
</mapper>
