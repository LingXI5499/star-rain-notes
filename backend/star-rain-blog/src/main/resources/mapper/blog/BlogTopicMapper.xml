<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.starrainnotes.blog.mapper.BlogTopicMapper">
    <!--
      BlogTopicMapper.xml：com.starrainnotes.blog.mapper.BlogTopicMapper 的 MyBatis SQL 映射。
      语句 id 对应 Mapper 接口方法；#{...} 使用预编译参数，字段别名及结果映射约定保持一致。
      读写行为由每条语句决定；需要锁的查询应由业务层开启事务并在同一连接内执行。
    -->


    <!--
      topicColumns：专题投影列；可复用 SQL 片段。
      通过 include 引用，复用相同列或条件，避免列表与计数的过滤口径分散。
    -->
    <sql id="topicColumns">
        t.id, t.slug, t.name, t.description, t.sort_order, t.featured, t.status, t.created_at, t.updated_at
    </sql>

    <!--
      adminFilters：后台筛选条件；可复用 SQL 片段。
      通过 include 引用，复用相同列或条件，避免列表与计数的过滤口径分散。
      绑定参数：keyword、status；参数含义参见 Mapper 方法注释。
    -->
    <sql id="adminFilters">
        <!--
          统一生成 WHERE 并去除开头多余的 AND/OR；没有有效条件时不输出该子句。
        -->
        <where>
            <!--
              条件 keyword != null and keyword != '' 成立时才输出此段 SQL。
            -->
            <if test="keyword != null and keyword != ''">
                AND (LOWER(t.name) LIKE CONCAT('%', #{keyword}, '%')
                     OR LOWER(t.slug) LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <!--
              条件 status != null and status != '' 成立时才输出此段 SQL。
            -->
            <if test="status != null and status != ''">
                AND t.status = #{status}
            </if>
        </where>
    </sql>

    <!--
      insertTopic：新增专题；新增语句。
      涉及数据表：sr_blog_topic；关系条件与可见性筛选由下方 SQL 明确限定。
      输入对象：com.starrainnotes.blog.entity.BlogTopicEntity；占位符按其属性读取。
      执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
      插入成功后 JDBC 自动生成的主键回填到 id。
      绑定参数：slug、name、description、sortOrder、featured、status；参数含义参见 Mapper 方法注释。
    -->
    <insert id="insertTopic" parameterType="com.starrainnotes.blog.entity.BlogTopicEntity"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sr_blog_topic (slug, name, description, sort_order, featured, status)
        VALUES (#{slug}, #{name}, #{description}, #{sortOrder}, #{featured}, #{status})
    </insert>

    <!--
      topicById：专题依据标识；读取语句。
      涉及数据表：sr_blog_topic；关系条件与可见性筛选由下方 SQL 明确限定。
      结果类型或映射：com.starrainnotes.blog.entity.BlogTopicEntity；集合与单值形态由 Java 方法签名决定。
      复用片段：topicColumns。
      绑定参数：id；参数含义参见 Mapper 方法注释。
    -->
    <select id="topicById" resultType="com.starrainnotes.blog.entity.BlogTopicEntity">
        SELECT <include refid="topicColumns"/> FROM sr_blog_topic t WHERE t.id = #{id}
    </select>

    <!--
      topicByIdForUpdate：专题依据标识面向更新；读取语句。
      涉及数据表：sr_blog_topic；关系条件与可见性筛选由下方 SQL 明确限定。
      结果类型或映射：com.starrainnotes.blog.entity.BlogTopicEntity；集合与单值形态由 Java 方法签名决定。
      复用片段：topicColumns。
      绑定参数：id；参数含义参见 Mapper 方法注释。
      锁定命中的记录，直到事务结束；用于串行化当前对象的检查与写入。
    -->
    <select id="topicByIdForUpdate" resultType="com.starrainnotes.blog.entity.BlogTopicEntity">
        SELECT <include refid="topicColumns"/> FROM sr_blog_topic t WHERE t.id = #{id} FOR UPDATE
    </select>

    <!--
      countBySlug：数量依据固定链接标识；读取语句。
      涉及数据表：sr_blog_topic；关系条件与可见性筛选由下方 SQL 明确限定。
      结果类型或映射：long；集合与单值形态由 Java 方法签名决定。
      绑定参数：slug、excludeId；参数含义参见 Mapper 方法注释。
      返回匹配条件的数量，不返回完整实体。
    -->
    <select id="countBySlug" resultType="long">
        SELECT COUNT(*) FROM sr_blog_topic WHERE slug = #{slug}
        <!--
          条件 excludeId != null 成立时才输出此段 SQL。
        -->
        <if test="excludeId != null">
            AND id &lt;&gt; #{excludeId}
        </if>
    </select>

    <!--
      updateTopic：更新专题；更新语句。
      涉及数据表：sr_blog_topic；关系条件与可见性筛选由下方 SQL 明确限定。
      执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
      绑定参数：slug、name、description、id；参数含义参见 Mapper 方法注释。
    -->
    <update id="updateTopic">
        UPDATE sr_blog_topic
        SET slug = #{slug},
            name = #{name},
            description = #{description}
        WHERE id = #{id}
    </update>

    <!--
      updateStatus：更新状态；更新语句。
      涉及数据表：sr_blog_topic；关系条件与可见性筛选由下方 SQL 明确限定。
      执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
      绑定参数：status、id；参数含义参见 Mapper 方法注释。
    -->
    <update id="updateStatus">
        UPDATE sr_blog_topic SET status = #{status} WHERE id = #{id}
    </update>

    <!--
      删除专题本身。
      刻意不在这里级联删 sr_blog_topic_post：删除只对空专题开放，
      「有成员」必须在 Service 里报错，让调用方显式走移出接口（会压缩序号）。
    -->
    <!--
      deleteTopic：删除专题；删除语句。
      涉及数据表：sr_blog_topic；关系条件与可见性筛选由下方 SQL 明确限定。
      执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
      绑定参数：id；参数含义参见 Mapper 方法注释。
    -->
    <delete id="deleteTopic">
        DELETE FROM sr_blog_topic WHERE id = #{id}
    </delete>

    <!--
      minimumSortOrder：minimum排序顺序；读取语句。
      涉及数据表：sr_blog_topic；关系条件与可见性筛选由下方 SQL 明确限定。
      结果类型或映射：int；集合与单值形态由 Java 方法签名决定。
    -->
    <select id="minimumSortOrder" resultType="int">
        SELECT MIN(sort_order) FROM sr_blog_topic
    </select>

    <!--
      updatePresentation：更新Presentation；更新语句。
      涉及数据表：sr_blog_topic；关系条件与可见性筛选由下方 SQL 明确限定。
      执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
      绑定参数：sortOrder、featured、id；参数含义参见 Mapper 方法注释。
    -->
    <update id="updatePresentation">
        UPDATE sr_blog_topic SET sort_order = #{sortOrder}, featured = #{featured} WHERE id = #{id}
    </update>

    <!--
      adminPageCount：后台分页数量；读取语句。
      涉及数据表：sr_blog_topic；关系条件与可见性筛选由下方 SQL 明确限定。
      结果类型或映射：long；集合与单值形态由 Java 方法签名决定。
      复用片段：adminFilters。
      返回匹配条件的数量，不返回完整实体。
    -->
    <select id="adminPageCount" resultType="long">
        SELECT COUNT(*) FROM sr_blog_topic t
        <include refid="adminFilters"/>
    </select>

    <!-- member_count 统计全部成员（含未发布文章）：专题排序时草稿也会占位置 -->
    <!--
      adminPage：后台分页；读取语句。
      涉及数据表：sr_blog_topic、sr_blog_topic_post；关系条件与可见性筛选由下方 SQL 明确限定。
      结果类型或映射：com.starrainnotes.blog.vo.BlogTopicVO；集合与单值形态由 Java 方法签名决定。
      复用片段：topicColumns、adminFilters。
      绑定参数：limit、offset；参数含义参见 Mapper 方法注释。
      LIMIT 限定读取数量，若包含 OFFSET 则跳过对应记录；排序依据以本语句为准。
      返回匹配条件的数量，不返回完整实体。
    -->
    <select id="adminPage" resultType="com.starrainnotes.blog.vo.BlogTopicVO">
        SELECT <include refid="topicColumns"/>, COUNT(tp.id) AS member_count
        FROM sr_blog_topic t
        LEFT JOIN sr_blog_topic_post tp ON tp.topic_id = t.id
        <include refid="adminFilters"/>
        GROUP BY t.id, t.slug, t.name, t.description, t.sort_order, t.featured, t.status, t.created_at, t.updated_at
        ORDER BY t.sort_order, t.id
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <!--
      前台专题入口（博客首页顶部的专栏导航条）。
      只要有 ENABLED 就出现，**不再要求「至少有一篇已发布文章」**：
      专栏是站点预先划定的内容骨架，新开的专栏在还没有文章时也必须显示，
      否则导航条会随着发文进度时有时无。
      顺序使用后台保存的 sort_order；新专题默认插在最前面。
    -->
    <!--
      publishedTopics：已发布专题列表；读取语句。
      涉及数据表：sr_blog_topic、sr_blog_topic_post、sr_blog_post；关系条件与可见性筛选由下方 SQL 明确限定。
      结果类型或映射：com.starrainnotes.blog.vo.BlogTopicVO；集合与单值形态由 Java 方法签名决定。
      返回匹配条件的数量，不返回完整实体。
    -->
    <select id="publishedTopics" resultType="com.starrainnotes.blog.vo.BlogTopicVO">
        SELECT t.id, t.slug, t.name, t.description, t.sort_order, t.featured, t.status, t.updated_at, COUNT(p.id) AS member_count
        FROM sr_blog_topic t
        LEFT JOIN sr_blog_topic_post tp ON tp.topic_id = t.id
        LEFT JOIN sr_blog_post p ON p.id = tp.post_id AND p.status = 'PUBLISHED'
        WHERE t.status = 'ENABLED'
        GROUP BY t.id, t.slug, t.name, t.description, t.sort_order, t.featured, t.status, t.updated_at
        ORDER BY t.sort_order, t.id
    </select>

    <!--
      前台专题页的专题本身：可见性与 publishedTopics 一致（ENABLED 即可）。
      空专栏不再 404，而是正常渲染一个「还没有文章」的空列表 ——
      导航条里点得进来的入口却报 404 是说不通的。
      停用（DISABLED）与不存在的 slug 仍然 404。
    -->
    <!--
      publishedTopicBySlug：已发布专题依据固定链接标识；读取语句。
      涉及数据表：sr_blog_topic、sr_blog_topic_post、sr_blog_post；关系条件与可见性筛选由下方 SQL 明确限定。
      结果类型或映射：com.starrainnotes.blog.vo.BlogTopicVO；集合与单值形态由 Java 方法签名决定。
      绑定参数：slug；参数含义参见 Mapper 方法注释。
      返回匹配条件的数量，不返回完整实体。
    -->
    <select id="publishedTopicBySlug" resultType="com.starrainnotes.blog.vo.BlogTopicVO">
        SELECT t.id, t.slug, t.name, t.description, t.sort_order, t.featured, t.status, t.updated_at, COUNT(p.id) AS member_count
        FROM sr_blog_topic t
        LEFT JOIN sr_blog_topic_post tp ON tp.topic_id = t.id
        LEFT JOIN sr_blog_post p ON p.id = tp.post_id AND p.status = 'PUBLISHED'
        WHERE t.status = 'ENABLED' AND t.slug = #{slug}
        GROUP BY t.id, t.slug, t.name, t.description, t.sort_order, t.featured, t.status, t.updated_at
    </select>

    <!-- 公开页面上的专题标记：停用专题不出现 -->
    <!--
      publicTopicsByPostId：公开专题列表依据文章标识；读取语句。
      涉及数据表：sr_blog_topic_post、sr_blog_topic；关系条件与可见性筛选由下方 SQL 明确限定。
      结果类型或映射：com.starrainnotes.blog.vo.BlogTopicVO；集合与单值形态由 Java 方法签名决定。
      绑定参数：postId；参数含义参见 Mapper 方法注释。
    -->
    <select id="publicTopicsByPostId" resultType="com.starrainnotes.blog.vo.BlogTopicVO">
        SELECT t.id, t.slug, t.name, t.description, t.status
        FROM sr_blog_topic_post tp
        JOIN sr_blog_topic t ON t.id = tp.topic_id
        WHERE tp.post_id = #{postId} AND t.status = 'ENABLED'
        ORDER BY tp.sort_order ASC, t.id ASC
    </select>

    <!--
      publicTopicsByPostIds：公开专题列表依据文章标识集合；读取语句。
      涉及数据表：sr_blog_topic_post、sr_blog_topic；关系条件与可见性筛选由下方 SQL 明确限定。
      结果类型或映射：com.starrainnotes.blog.dto.BlogPostTopicRow；集合与单值形态由 Java 方法签名决定。
      绑定参数：postId；参数含义参见 Mapper 方法注释。
    -->
    <select id="publicTopicsByPostIds" resultType="com.starrainnotes.blog.dto.BlogPostTopicRow">
        SELECT tp.post_id AS post_id, t.id AS topic_id, t.slug AS slug, t.name AS name,
               tp.sort_order AS sort_order
        FROM sr_blog_topic_post tp
        JOIN sr_blog_topic t ON t.id = tp.topic_id
        WHERE t.status = 'ENABLED'
          AND tp.post_id IN
        <!--
          遍历 postIds，元素名为 postId；open/close/separator 控制 SQL 列表格式。
          集合是否允许为空由外围条件和业务校验决定。
        -->
        <foreach collection="postIds" item="postId" open="(" separator="," close=")">
            #{postId}
        </foreach>
        ORDER BY tp.sort_order ASC, t.id ASC
    </select>

    <!--
      topicsByPostId：专题列表依据文章标识；读取语句。
      涉及数据表：sr_blog_topic_post、sr_blog_topic；关系条件与可见性筛选由下方 SQL 明确限定。
      结果类型或映射：com.starrainnotes.blog.vo.BlogTopicVO；集合与单值形态由 Java 方法签名决定。
      绑定参数：postId；参数含义参见 Mapper 方法注释。
    -->
    <select id="topicsByPostId" resultType="com.starrainnotes.blog.vo.BlogTopicVO">
        SELECT t.id, t.slug, t.name, t.description, t.status
        FROM sr_blog_topic_post tp
        JOIN sr_blog_topic t ON t.id = tp.topic_id
        WHERE tp.post_id = #{postId}
        ORDER BY tp.sort_order ASC, t.id ASC
    </select>

    <!--
      topicsByPostIds：专题列表依据文章标识集合；读取语句。
      涉及数据表：sr_blog_topic_post、sr_blog_topic；关系条件与可见性筛选由下方 SQL 明确限定。
      结果类型或映射：com.starrainnotes.blog.dto.BlogPostTopicRow；集合与单值形态由 Java 方法签名决定。
      绑定参数：postId；参数含义参见 Mapper 方法注释。
    -->
    <select id="topicsByPostIds" resultType="com.starrainnotes.blog.dto.BlogPostTopicRow">
        SELECT tp.post_id AS post_id, t.id AS topic_id, t.slug AS slug, t.name AS name,
               tp.sort_order AS sort_order
        FROM sr_blog_topic_post tp
        JOIN sr_blog_topic t ON t.id = tp.topic_id
        WHERE tp.post_id IN
        <!--
          遍历 postIds，元素名为 postId；open/close/separator 控制 SQL 列表格式。
          集合是否允许为空由外围条件和业务校验决定。
        -->
        <foreach collection="postIds" item="postId" open="(" separator="," close=")">
            #{postId}
        </foreach>
        ORDER BY tp.sort_order ASC, t.id ASC
    </select>

    <!--
      topicMembers：专题Members；读取语句。
      涉及数据表：sr_blog_topic_post、sr_blog_post；关系条件与可见性筛选由下方 SQL 明确限定。
      结果类型或映射：com.starrainnotes.blog.dto.BlogTopicMemberRow；集合与单值形态由 Java 方法签名决定。
      绑定参数：topicId；参数含义参见 Mapper 方法注释。
    -->
    <select id="topicMembers" resultType="com.starrainnotes.blog.dto.BlogTopicMemberRow">
        SELECT p.id AS post_id, p.slug AS slug, p.title AS title, p.status AS status,
               tp.sort_order AS sort_order, p.published_at AS published_at, p.updated_at AS updated_at
        FROM sr_blog_topic_post tp
        JOIN sr_blog_post p ON p.id = tp.post_id
        WHERE tp.topic_id = #{topicId}
        ORDER BY tp.sort_order ASC, tp.id ASC
    </select>

    <!--
      countTopicPosts：数量专题文章列表；读取语句。
      涉及数据表：sr_blog_topic_post；关系条件与可见性筛选由下方 SQL 明确限定。
      结果类型或映射：long；集合与单值形态由 Java 方法签名决定。
      绑定参数：topicId；参数含义参见 Mapper 方法注释。
      返回匹配条件的数量，不返回完整实体。
    -->
    <select id="countTopicPosts" resultType="long">
        SELECT COUNT(*) FROM sr_blog_topic_post WHERE topic_id = #{topicId}
    </select>

    <!--
      maxSortOrder：最大排序顺序；读取语句。
      涉及数据表：sr_blog_topic_post；关系条件与可见性筛选由下方 SQL 明确限定。
      结果类型或映射：java.lang.Integer；集合与单值形态由 Java 方法签名决定。
      绑定参数：topicId；参数含义参见 Mapper 方法注释。
    -->
    <select id="maxSortOrder" resultType="java.lang.Integer">
        SELECT MAX(sort_order) FROM sr_blog_topic_post WHERE topic_id = #{topicId}
    </select>

    <!--
      insertTopicPost：新增专题文章；新增语句。
      涉及数据表：sr_blog_topic_post；关系条件与可见性筛选由下方 SQL 明确限定。
      执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
      绑定参数：topicId、postId、sortOrder；参数含义参见 Mapper 方法注释。
    -->
    <insert id="insertTopicPost">
        INSERT INTO sr_blog_topic_post (topic_id, post_id, sort_order)
        VALUES (#{topicId}, #{postId}, #{sortOrder})
    </insert>

    <!--
      deleteTopicPost：删除专题文章；删除语句。
      涉及数据表：sr_blog_topic_post；关系条件与可见性筛选由下方 SQL 明确限定。
      执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
      绑定参数：topicId、postId；参数含义参见 Mapper 方法注释。
    -->
    <delete id="deleteTopicPost">
        DELETE FROM sr_blog_topic_post WHERE topic_id = #{topicId} AND post_id = #{postId}
    </delete>

    <!--
      deleteTopicPostsByPostId：删除专题文章列表依据文章标识；删除语句。
      涉及数据表：sr_blog_topic_post；关系条件与可见性筛选由下方 SQL 明确限定。
      执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
      绑定参数：postId；参数含义参见 Mapper 方法注释。
    -->
    <delete id="deleteTopicPostsByPostId">
        DELETE FROM sr_blog_topic_post WHERE post_id = #{postId}
    </delete>

    <!--
      countTopicPost：数量专题文章；读取语句。
      涉及数据表：sr_blog_topic_post；关系条件与可见性筛选由下方 SQL 明确限定。
      结果类型或映射：long；集合与单值形态由 Java 方法签名决定。
      绑定参数：topicId、postId；参数含义参见 Mapper 方法注释。
      返回匹配条件的数量，不返回完整实体。
    -->
    <select id="countTopicPost" resultType="long">
        SELECT COUNT(*) FROM sr_blog_topic_post WHERE topic_id = #{topicId} AND post_id = #{postId}
    </select>

    <!--
      批量重排序用 CASE WHEN 写成单条 UPDATE。
      不用 foreach + 分号拼多条语句：那要求 JDBC 打开 allowMultiQueries，
      而打开它会让所有 SQL 都具备多语句执行能力，代价远大于这里省下的几行。
      移除成员后的序号压缩也走这条语句，由 Service 按下标重算 1..n。
    -->
    <!--
      updateTopicOrder：更新专题顺序；更新语句。
      涉及数据表：sr_blog_topic_post；关系条件与可见性筛选由下方 SQL 明确限定。
      执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
      绑定参数：item.postId、item.sortOrder、topicId；参数含义参见 Mapper 方法注释。
    -->
    <update id="updateTopicOrder">
        UPDATE sr_blog_topic_post
        SET sort_order = CASE post_id
            <!--
              遍历 items，元素名为 item；open/close/separator 控制 SQL 列表格式。
              集合是否允许为空由外围条件和业务校验决定。
            -->
            <foreach collection="items" item="item">
                WHEN #{item.postId} THEN #{item.sortOrder}
            </foreach>
            END
        WHERE topic_id = #{topicId}
          AND post_id IN
          <!--
            遍历 items，元素名为 item；open/close/separator 控制 SQL 列表格式。
            集合是否允许为空由外围条件和业务校验决定。
          -->
          <foreach collection="items" item="item" open="(" separator="," close=")">
              #{item.postId}
          </foreach>
    </update>
</mapper>
