<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.starrainnotes.english.knowledge.mapper.DocumentMetadataMapper">
    <!--
      DocumentMetadataMapper.xml：com.starrainnotes.english.knowledge.mapper.DocumentMetadataMapper 的 MyBatis SQL 映射。
      语句 id 对应 Mapper 接口方法；#{...} 使用预编译参数，字段别名及结果映射约定保持一致。
      读写行为由每条语句决定；需要锁的查询应由业务层开启事务并在同一连接内执行。
    -->

 <!--
   tagsTable：标签列表Table；可复用 SQL 片段。
   通过 include 引用，复用相同列或条件，避免列表与计数的过滤口径分散。
 -->
 <sql id="tagsTable">
    <!--
      只采用第一个成立的 when 分支；否则使用 otherwise 分支（如有）。
    -->
    <choose>
    <!--
      条件 kind == 'READING' 成立时才输出此段 SQL。
    -->
    <when test="kind == 'READING'">sr_english_reading_tag</when>
    <!--
      前面的 when 均不成立时使用此兜底分支。
    -->
    <otherwise>sr_english_writing_article_tag</otherwise></choose></sql>
 <!--
   revisionTable：修订Table；可复用 SQL 片段。
   通过 include 引用，复用相同列或条件，避免列表与计数的过滤口径分散。
 -->
 <sql id="revisionTable">
    <!--
      只采用第一个成立的 when 分支；否则使用 otherwise 分支（如有）。
    -->
    <choose>
    <!--
      条件 kind == 'READING' 成立时才输出此段 SQL。
    -->
    <when test="kind == 'READING'">sr_english_reading_revision</when>
    <!--
      前面的 when 均不成立时使用此兜底分支。
    -->
    <otherwise>sr_english_writing_revision</otherwise></choose></sql>
 <!--
   tags：标签列表；读取语句。
   涉及数据表：sr_english_taxonomy_term；关系条件与可见性筛选由下方 SQL 明确限定。
   结果类型或映射：com.starrainnotes.english.taxonomy.dto.TaxonomyDto$Node；集合与单值形态由 Java 方法签名决定。
   复用片段：tagsTable。
   绑定参数：id；参数含义参见 Mapper 方法注释。
 -->
 <select id="tags" resultType="com.starrainnotes.english.taxonomy.dto.TaxonomyDto$Node">SELECT t.id,t.dimension,t.name,t.name_en,t.slug FROM sr_english_taxonomy_term t JOIN <include refid="tagsTable"/> r ON r.term_id=t.id WHERE r.article_id=#{id} ORDER BY t.dimension,t.sort_order,t.id</select>
 <!--
   clearTags：clear标签列表；删除语句。
   执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
   复用片段：tagsTable。
   绑定参数：id；参数含义参见 Mapper 方法注释。
 -->
 <delete id="clearTags">DELETE FROM <include refid="tagsTable"/> WHERE article_id=#{id}</delete>
 <!--
   insertTags：新增标签列表；新增语句。
   执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
   复用片段：tagsTable。
   绑定参数：id、term；参数含义参见 Mapper 方法注释。
 -->
 <insert id="insertTags">INSERT INTO <include refid="tagsTable"/>(article_id,term_id) VALUES
    <!--
      遍历 ids，元素名为 term；open/close/separator 控制 SQL 列表格式。
      集合是否允许为空由外围条件和业务校验决定。
    -->
    <foreach collection="ids" item="term" separator=",">(#{id},#{term})</foreach></insert>
 <!--
   revisionCount：修订数量；读取语句。
   结果类型或映射：long；集合与单值形态由 Java 方法签名决定。
   复用片段：revisionTable。
   绑定参数：id；参数含义参见 Mapper 方法注释。
   返回匹配条件的数量，不返回完整实体。
 -->
 <select id="revisionCount" resultType="long">SELECT COUNT(*) FROM <include refid="revisionTable"/> WHERE article_id=#{id}</select>
 <!--
   nextRevision：下一项修订；读取语句。
   结果类型或映射：long；集合与单值形态由 Java 方法签名决定。
   复用片段：revisionTable。
   绑定参数：id；参数含义参见 Mapper 方法注释。
 -->
 <select id="nextRevision" resultType="long">SELECT COALESCE(MAX(revision_no),0)+1 FROM <include refid="revisionTable"/> WHERE article_id=#{id}</select>
 <!--
   revisions：revisions；读取语句。
   结果类型或映射：com.starrainnotes.english.knowledge.dto.RevisionDto$Revision；集合与单值形态由 Java 方法签名决定。
   复用片段：revisionTable。
   绑定参数：id、limit、offset；参数含义参见 Mapper 方法注释。
   LIMIT 限定读取数量，若包含 OFFSET 则跳过对应记录；排序依据以本语句为准。
 -->
 <select id="revisions" resultType="com.starrainnotes.english.knowledge.dto.RevisionDto$Revision">SELECT revision_no,created_at,change_note FROM <include refid="revisionTable"/> WHERE article_id=#{id} ORDER BY revision_no DESC LIMIT #{limit} OFFSET #{offset}</select>
 <!--
   revision：修订；读取语句。
   结果类型或映射：com.starrainnotes.english.knowledge.dto.RevisionDto$Revision；集合与单值形态由 Java 方法签名决定。
   复用片段：revisionTable。
   绑定参数：id、no；参数含义参见 Mapper 方法注释。
 -->
 <select id="revision" resultType="com.starrainnotes.english.knowledge.dto.RevisionDto$Revision">SELECT revision_no,created_at,change_note,snapshot_json FROM <include refid="revisionTable"/> WHERE article_id=#{id} AND revision_no=#{no}</select>
 <!--
   insertRevision：新增修订；新增语句。
   执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
   复用片段：revisionTable。
   绑定参数：id、no、snapshot、actor、note；参数含义参见 Mapper 方法注释。
 -->
 <insert id="insertRevision">INSERT INTO <include refid="revisionTable"/>(article_id,revision_no,snapshot_json,editor_account_id,change_note) VALUES(#{id},#{no},#{snapshot},#{actor},#{note})</insert>
</mapper>
