<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.starrainnotes.english.reading.mapper.ReadingMapper">
    <!--
      ReadingMapper.xml：com.starrainnotes.english.reading.mapper.ReadingMapper 的 MyBatis SQL 映射。
      语句 id 对应 Mapper 接口方法；#{...} 使用预编译参数，字段别名及结果映射约定保持一致。
      读写行为由每条语句决定；需要锁的查询应由业务层开启事务并在同一连接内执行。
    -->

<!--
  articleMap：articleMap；结果映射。
  将数据库列装配为 com.starrainnotes.english.reading.dto.ReadingDto$Article；id/result 区分标识字段与普通属性。
-->
<resultMap id="articleMap" type="com.starrainnotes.english.reading.dto.ReadingDto$Article"><result property="id" column="id"/><result property="slug" column="slug"/><result property="title" column="title"/><result property="summary" column="summary"/><result property="bodyMarkdown" column="body_markdown"/><result property="translationZhMarkdown" column="translation_zh_markdown"/><result property="primaryTopicId" column="primary_topic_id"/><result property="rowVersion" column="row_version"/><result property="sourceName" column="source_name"/><result property="sourceUrl" column="source_url"/><result property="contentOrigin" column="content_origin"/><result property="publishStatus" column="publish_status"/><result property="publishedAt" column="published_at"/><result property="updatedAt" column="updated_at"/><result property="sortOrder" column="sort_order"/></resultMap>
    <!--
      columns：投影列；可复用 SQL 片段。
      通过 include 引用，复用相同列或条件，避免列表与计数的过滤口径分散。
    -->
    <sql id="columns">a.id,a.slug,a.title,a.summary,a.body_markdown,a.translation_zh_markdown,a.primary_topic_id,a.row_version,a.source_name,a.source_url,a.content_origin,a.publish_status,a.published_at,a.updated_at,a.sort_order</sql>
    <!--
      publicCheck：公开检查；可复用 SQL 片段。
      涉及数据表：sr_english_reading_rights；关系条件与可见性筛选由下方 SQL 明确限定。
      通过 include 引用，复用相同列或条件，避免列表与计数的过滤口径分散。
    -->
    <sql id="publicCheck">a.publish_status='PUBLISHED' AND (a.content_origin='ORIGINAL' AND NOT EXISTS(SELECT 1 FROM sr_english_reading_rights r WHERE r.article_id=a.id AND r.rights_status='BLOCKED') OR EXISTS(SELECT 1 FROM sr_english_reading_rights r WHERE r.article_id=a.id AND r.rights_status='CLEARED' AND COALESCE(TRIM(r.rights_basis),'')!=''))</sql>
<!--
  filter：筛选；可复用 SQL 片段。
  涉及数据表：sr_english_reading_tag；关系条件与可见性筛选由下方 SQL 明确限定。
  通过 include 引用，复用相同列或条件，避免列表与计数的过滤口径分散。
  复用片段：com.starrainnotes.english.reading.mapper.ReadingMapper.publicCheck。
  绑定参数：search、term；参数含义参见 Mapper 方法注释。
-->
<sql id="filter">
    <!--
      统一生成 WHERE 并去除开头多余的 AND/OR；没有有效条件时不输出该子句。
    -->
    <where>a.deleted_at IS NULL
    <!--
      条件 publicOnly 成立时才输出此段 SQL。
    -->
    <if test="publicOnly">AND <include refid="com.starrainnotes.english.reading.mapper.ReadingMapper.publicCheck"/></if>
    <!--
      条件 search != null and search != '' 成立时才输出此段 SQL。
    -->
    <if test="search != null and search != ''">AND (a.title LIKE CONCAT('%',#{search},'%') OR a.summary LIKE CONCAT('%',#{search},'%'))</if>
    <!--
      条件  成立时才输出此段 SQL。
    -->
    <if test="topics != null and topics.size()>0">AND (a.primary_topic_id IN
    <!--
      遍历 topics，元素名为 term；open/close/separator 控制 SQL 列表格式。
      集合是否允许为空由外围条件和业务校验决定。
    -->
    <foreach collection="topics" item="term" open="(" close=")" separator=",">#{term}</foreach> OR EXISTS(SELECT 1 FROM sr_english_reading_tag t WHERE t.article_id=a.id AND t.term_id IN
    <!--
      遍历 topics，元素名为 term；open/close/separator 控制 SQL 列表格式。
      集合是否允许为空由外围条件和业务校验决定。
    -->
    <foreach collection="topics" item="term" open="(" close=")" separator=",">#{term}</foreach>))</if>
    <!--
      条件  成立时才输出此段 SQL。
    -->
    <if test="genres != null and genres.size()>0">AND EXISTS(SELECT 1 FROM sr_english_reading_tag t WHERE t.article_id=a.id AND t.term_id IN
    <!--
      遍历 genres，元素名为 term；open/close/separator 控制 SQL 列表格式。
      集合是否允许为空由外围条件和业务校验决定。
    -->
    <foreach collection="genres" item="term" open="(" close=")" separator=",">#{term}</foreach>)</if>
    <!--
      条件  成立时才输出此段 SQL。
    -->
    <if test="purposes != null and purposes.size()>0">AND EXISTS(SELECT 1 FROM sr_english_reading_tag t WHERE t.article_id=a.id AND t.term_id IN
    <!--
      遍历 purposes，元素名为 term；open/close/separator 控制 SQL 列表格式。
      集合是否允许为空由外围条件和业务校验决定。
    -->
    <foreach collection="purposes" item="term" open="(" close=")" separator=",">#{term}</foreach>)</if></where></sql>
<!--
  count：数量；读取语句。
  涉及数据表：sr_english_reading_article；关系条件与可见性筛选由下方 SQL 明确限定。
  结果类型或映射：long；集合与单值形态由 Java 方法签名决定。
  复用片段：filter。
  返回匹配条件的数量，不返回完整实体。
-->
<select id="count" resultType="long">SELECT COUNT(*) FROM sr_english_reading_article a <include refid="filter"/></select>
<!--
  list：list；读取语句。
  涉及数据表：sr_english_reading_article；关系条件与可见性筛选由下方 SQL 明确限定。
  结果类型或映射：articleMap；集合与单值形态由 Java 方法签名决定。
  复用片段：columns、filter。
  绑定参数：limit、offset；参数含义参见 Mapper 方法注释。
  LIMIT 限定读取数量，若包含 OFFSET 则跳过对应记录；排序依据以本语句为准。
-->
<select id="list" resultMap="articleMap">SELECT <include refid="columns"/> FROM sr_english_reading_article a <include refid="filter"/> ORDER BY a.published_at DESC,a.id DESC LIMIT #{limit} OFFSET #{offset}</select>
<!--
  byId：依据标识；读取语句。
  涉及数据表：sr_english_reading_article；关系条件与可见性筛选由下方 SQL 明确限定。
  结果类型或映射：articleMap；集合与单值形态由 Java 方法签名决定。
  复用片段：columns。
  绑定参数：id；参数含义参见 Mapper 方法注释。
-->
<select id="byId" resultMap="articleMap">SELECT <include refid="columns"/> FROM sr_english_reading_article a WHERE a.id=#{id} AND a.deleted_at IS NULL</select>
<!--
  lockById：锁依据标识；读取语句。
  涉及数据表：sr_english_reading_article；关系条件与可见性筛选由下方 SQL 明确限定。
  结果类型或映射：articleMap；集合与单值形态由 Java 方法签名决定。
  复用片段：columns。
  绑定参数：id；参数含义参见 Mapper 方法注释。
  锁定命中的记录，直到事务结束；用于串行化当前对象的检查与写入。
-->
<select id="lockById" resultMap="articleMap">SELECT <include refid="columns"/> FROM sr_english_reading_article a WHERE a.id=#{id} AND a.deleted_at IS NULL FOR UPDATE</select>
<!--
  publicBySlug：公开依据固定链接标识；读取语句。
  涉及数据表：sr_english_reading_article；关系条件与可见性筛选由下方 SQL 明确限定。
  结果类型或映射：articleMap；集合与单值形态由 Java 方法签名决定。
  复用片段：columns、com.starrainnotes.english.reading.mapper.ReadingMapper.publicCheck。
  绑定参数：slug；参数含义参见 Mapper 方法注释。
-->
<select id="publicBySlug" resultMap="articleMap">SELECT <include refid="columns"/> FROM sr_english_reading_article a WHERE a.slug=#{slug} AND a.deleted_at IS NULL AND <include refid="com.starrainnotes.english.reading.mapper.ReadingMapper.publicCheck"/></select>
<!--
  insert：新增；新增语句。
  涉及数据表：sr_english_reading_article；关系条件与可见性筛选由下方 SQL 明确限定。
  执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
  插入成功后 JDBC 自动生成的主键回填到 id。
  绑定参数：slug、title、summary、bodyMarkdown、translationZhMarkdown、primaryTopicId、sourceName、sourceUrl、contentOrigin、sortOrder；参数含义参见 Mapper 方法注释。
-->
<insert id="insert" useGeneratedKeys="true" keyProperty="id">INSERT INTO sr_english_reading_article(slug,title,summary,body_markdown,translation_zh_markdown,primary_topic_id,source_name,source_url,content_origin,sort_order) VALUES(#{slug},#{title},#{summary},#{bodyMarkdown},#{translationZhMarkdown},#{primaryTopicId},#{sourceName},#{sourceUrl},#{contentOrigin},#{sortOrder})</insert>
<!--
  finishSlug：finish固定链接标识；更新语句。
  涉及数据表：sr_english_reading_article；关系条件与可见性筛选由下方 SQL 明确限定。
  执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
  绑定参数：slug、id；参数含义参见 Mapper 方法注释。
-->
<update id="finishSlug">UPDATE sr_english_reading_article SET slug=#{slug} WHERE id=#{id}</update>
<!--
  update：更新；更新语句。
  涉及数据表：sr_english_reading_article；关系条件与可见性筛选由下方 SQL 明确限定。
  执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
  绑定参数：title、summary、bodyMarkdown、translationZhMarkdown、primaryTopicId、sourceName、sourceUrl、contentOrigin、sortOrder、id、rowVersion；参数含义参见 Mapper 方法注释。
-->
<update id="update">UPDATE sr_english_reading_article SET title=#{title},summary=#{summary},body_markdown=#{bodyMarkdown},translation_zh_markdown=#{translationZhMarkdown},primary_topic_id=#{primaryTopicId},source_name=#{sourceName},source_url=#{sourceUrl},content_origin=#{contentOrigin},sort_order=#{sortOrder},row_version=row_version+1 WHERE id=#{id} AND row_version=#{rowVersion} AND deleted_at IS NULL</update>
<!--
  setStatus：set状态；更新语句。
  涉及数据表：sr_english_reading_article；关系条件与可见性筛选由下方 SQL 明确限定。
  执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
  绑定参数：status、id、version；参数含义参见 Mapper 方法注释。
-->
<update id="setStatus">UPDATE sr_english_reading_article SET publish_status=#{status},published_at=CASE WHEN #{status}='PUBLISHED' THEN COALESCE(published_at,NOW(3)) ELSE published_at END,row_version=row_version+1 WHERE id=#{id} AND row_version=#{version} AND deleted_at IS NULL</update>
<!--
  delete：删除；更新语句。
  涉及数据表：sr_english_reading_article；关系条件与可见性筛选由下方 SQL 明确限定。
  执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
  绑定参数：id、version；参数含义参见 Mapper 方法注释。
-->
<update id="delete">UPDATE sr_english_reading_article SET deleted_at=NOW(3),publish_status='WITHDRAWN',row_version=row_version+1 WHERE id=#{id} AND row_version=#{version} AND deleted_at IS NULL</update>
<!--
  rights：rights；读取语句。
  涉及数据表：sr_english_reading_rights；关系条件与可见性筛选由下方 SQL 明确限定。
  结果类型或映射：com.starrainnotes.english.reading.dto.ReadingDto$Rights；集合与单值形态由 Java 方法签名决定。
  绑定参数：id；参数含义参见 Mapper 方法注释。
-->
<select id="rights" resultType="com.starrainnotes.english.reading.dto.ReadingDto$Rights">SELECT rights_status,rights_basis,original_author,license_notice FROM sr_english_reading_rights WHERE article_id=#{id}</select>
<!--
  saveRights：saveRights；新增语句。
  涉及数据表：sr_english_reading_rights；关系条件与可见性筛选由下方 SQL 明确限定。
  执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
  绑定参数：id、sourceName、sourceUrl、rights.rightsStatus、rights.rightsBasis、rights.originalAuthor、rights.licenseNotice；参数含义参见 Mapper 方法注释。
-->
<insert id="saveRights">INSERT INTO sr_english_reading_rights(article_id,source_name,source_url,rights_status,rights_basis,original_author,license_notice) VALUES(#{id},#{sourceName},#{sourceUrl},#{rights.rightsStatus},#{rights.rightsBasis},#{rights.originalAuthor},#{rights.licenseNotice}) ON DUPLICATE KEY UPDATE source_name=#{sourceName},source_url=#{sourceUrl},rights_status=#{rights.rightsStatus},rights_basis=#{rights.rightsBasis},original_author=#{rights.originalAuthor},license_notice=#{rights.licenseNotice}</insert>
</mapper>
