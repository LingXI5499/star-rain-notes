<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.starrainnotes.english.overview.mapper.EnglishOverviewMapper">
    <!--
      EnglishOverviewMapper.xml：com.starrainnotes.english.overview.mapper.EnglishOverviewMapper 的 MyBatis SQL 映射。
      语句 id 对应 Mapper 接口方法；#{...} 使用预编译参数，字段别名及结果映射约定保持一致。
      读写行为由每条语句决定；需要锁的查询应由业务层开启事务并在同一连接内执行。
    -->


    <!-- 列清单在一处维护：resultType 依赖 map-underscore-to-camel-case 做列名到属性名的映射 -->
    <!--
      columns：投影列；可复用 SQL 片段。
      通过 include 引用，复用相同列或条件，避免列表与计数的过滤口径分散。
    -->
    <sql id="columns">
        id, title, subtitle, introduction, current_stage, roadmap_markdown, created_at, updated_at
    </sql>

    <!-- 表上有 CHECK (id = 1)，全表只有这一行；没有行时返回 null，由服务层抛 404 -->
    <!--
      selectSingleton：查询Singleton；读取语句。
      涉及数据表：sr_english_overview；关系条件与可见性筛选由下方 SQL 明确限定。
      结果类型或映射：com.starrainnotes.english.overview.entity.EnglishOverviewEntity；集合与单值形态由 Java 方法签名决定。
      复用片段：columns。
    -->
    <select id="selectSingleton" resultType="com.starrainnotes.english.overview.entity.EnglishOverviewEntity">
        SELECT <include refid="columns"/> FROM sr_english_overview WHERE id = 1
    </select>

    <!--
        subtitle / introduction / roadmap_markdown 允许被清空，无条件 SET 即「传 null 就写 NULL」。
        current_stage 不在这条路径里：它由英语模块的学习阶段决定，编辑文案不应改动它。
    -->
    <!--
      updateContent：更新内容；更新语句。
      涉及数据表：sr_english_overview；关系条件与可见性筛选由下方 SQL 明确限定。
      执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
      绑定参数：title、subtitle、introduction、roadmapMarkdown；参数含义参见 Mapper 方法注释。
    -->
    <update id="updateContent">
        UPDATE sr_english_overview SET title=#{title},subtitle=#{subtitle},
        introduction=#{introduction},roadmap_markdown=#{roadmapMarkdown},
        updated_at=CURRENT_TIMESTAMP(3) WHERE id=1
    </update>
</mapper>
