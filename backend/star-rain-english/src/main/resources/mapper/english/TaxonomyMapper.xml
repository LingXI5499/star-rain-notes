<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.starrainnotes.english.taxonomy.mapper.TaxonomyMapper">
    <!--
      TaxonomyMapper.xml：com.starrainnotes.english.taxonomy.mapper.TaxonomyMapper 的 MyBatis SQL 映射。
      语句 id 对应 Mapper 接口方法；#{...} 使用预编译参数，字段别名及结果映射约定保持一致。
      读写行为由每条语句决定；需要锁的查询应由业务层开启事务并在同一连接内执行。
    -->

 <!--
   node：node；结果映射。
   将数据库列装配为 com.starrainnotes.english.taxonomy.dto.TaxonomyDto$Node；id/result 区分标识字段与普通属性。
 -->
 <resultMap id="node" type="com.starrainnotes.english.taxonomy.dto.TaxonomyDto$Node">
  <id property="id" column="id"/><result property="parentId" column="parent_id"/><result property="dimension" column="dimension"/><result property="libraryModule" column="library_module"/><result property="code" column="code"/>
  <result property="name" column="name"/><result property="nameEn" column="name_en"/><result property="slug" column="slug"/>
  <result property="description" column="description"/><result property="sortOrder" column="sort_order"/><result property="enabled" column="enabled"/><result property="worldBaseline" column="is_world_baseline"/>
 </resultMap>
 <!--
   columns：投影列；可复用 SQL 片段。
   通过 include 引用，复用相同列或条件，避免列表与计数的过滤口径分散。
 -->
 <sql id="columns">id,parent_id,dimension,library_module,code,name,name_en,slug,description,sort_order,enabled,is_world_baseline</sql>
 <!--
   list：list；读取语句。
   涉及数据表：sr_english_taxonomy_term；关系条件与可见性筛选由下方 SQL 明确限定。
   结果类型或映射：node；集合与单值形态由 Java 方法签名决定。
   复用片段：columns。
 -->
 <select id="list" resultMap="node">SELECT <include refid="columns"/> FROM sr_english_taxonomy_term
    <!--
      条件 !admin 成立时才输出此段 SQL。
    -->
    <if test="!admin">WHERE enabled=1</if> ORDER BY dimension,sort_order,id</select>
 <!--
   byId：依据标识；读取语句。
   涉及数据表：sr_english_taxonomy_term；关系条件与可见性筛选由下方 SQL 明确限定。
   结果类型或映射：node；集合与单值形态由 Java 方法签名决定。
   复用片段：columns。
   绑定参数：id；参数含义参见 Mapper 方法注释。
 -->
 <select id="byId" resultMap="node">SELECT <include refid="columns"/> FROM sr_english_taxonomy_term WHERE id=#{id}</select>
 <!--
   bySlug：依据固定链接标识；读取语句。
   涉及数据表：sr_english_taxonomy_term；关系条件与可见性筛选由下方 SQL 明确限定。
   结果类型或映射：node；集合与单值形态由 Java 方法签名决定。
   复用片段：columns。
   绑定参数：slug；参数含义参见 Mapper 方法注释。
 -->
 <select id="bySlug" resultMap="node">SELECT <include refid="columns"/> FROM sr_english_taxonomy_term WHERE slug=#{slug}</select>
 <!--
   insert：新增；新增语句。
   涉及数据表：sr_english_taxonomy_term；关系条件与可见性筛选由下方 SQL 明确限定。
   执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
   插入成功后 JDBC 自动生成的主键回填到 id。
   绑定参数：parentId、dimension、name、nameEn、slug、description、sortOrder；参数含义参见 Mapper 方法注释。
 -->
 <insert id="insert" useGeneratedKeys="true" keyProperty="id">INSERT INTO sr_english_taxonomy_term(parent_id,dimension,library_module,code,name,name_en,slug,description,sort_order,enabled,is_world_baseline) VALUES(#{parentId},#{dimension},#{libraryModule},#{code},#{name},#{nameEn},#{slug},#{description},#{sortOrder},1,0)</insert>
 <!--
   update：更新；更新语句。
   涉及数据表：sr_english_taxonomy_term；关系条件与可见性筛选由下方 SQL 明确限定。
   执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
   绑定参数：name、nameEn、description、sortOrder、id；参数含义参见 Mapper 方法注释。
 -->
 <update id="update">UPDATE sr_english_taxonomy_term SET name=#{name},name_en=#{nameEn},description=#{description},sort_order=#{sortOrder} WHERE id=#{id}</update>
 <!--
   disable：disable；更新语句。
   涉及数据表：sr_english_taxonomy_term；关系条件与可见性筛选由下方 SQL 明确限定。
   执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
   绑定参数：id；参数含义参见 Mapper 方法注释。
 -->
 <update id="disable">UPDATE sr_english_taxonomy_term SET enabled=0 WHERE id=#{id} OR parent_id=#{id}</update>
</mapper>
