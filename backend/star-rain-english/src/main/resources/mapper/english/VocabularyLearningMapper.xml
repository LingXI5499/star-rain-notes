<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.starrainnotes.english.vocabulary.mapper.VocabularyLearningMapper">
    <!--
      VocabularyLearningMapper.xml：com.starrainnotes.english.vocabulary.mapper.VocabularyLearningMapper 的 MyBatis SQL 映射。
      语句 id 对应 Mapper 接口方法；#{...} 使用预编译参数，字段别名及结果映射约定保持一致。
      读写行为由每条语句决定；需要锁的查询应由业务层开启事务并在同一连接内执行。
    -->

    <!--
      planColumns：计划投影列；可复用 SQL 片段。
      通过 include 引用，复用相同列或条件，避免列表与计数的过滤口径分散。
    -->
    <sql id="planColumns">p.account_id,p.revision,p.status,p.name,p.source_theme_id,p.source_name,p.batch_size,p.total_words,p.created_at,p.updated_at</sql>
    <!--
      modeColumns：mode投影列；可复用 SQL 片段。
      通过 include 引用，复用相同列或条件，避免列表与计数的过滤口径分散。
    -->
    <sql id="modeColumns">word_id,direction,rating_count,ema_score,review_step,recent_good_count,last_rating,first_rated_at,last_rated_at,next_review_at,audio_verified</sql>
    <!--
      wordFrom：单词来源；可复用 SQL 片段。
      涉及数据表：sr_english_vocabulary_word、sr_english_vocabulary_memory；关系条件与可见性筛选由下方 SQL 明确限定。
      通过 include 引用，复用相同列或条件，避免列表与计数的过滤口径分散。
      绑定参数：accountId；参数含义参见 Mapper 方法注释。
    -->
    <sql id="wordFrom">
        FROM sr_english_vocabulary_word w
        LEFT JOIN sr_english_vocabulary_memory m ON m.account_id=#{accountId} AND m.word_id=w.id
    </sql>
    <!--
      filter：筛选；可复用 SQL 片段。
      涉及数据表：sr_english_vocabulary_plan_item、sr_english_vocabulary_mode_memory；关系条件与可见性筛选由下方 SQL 明确限定。
      通过 include 引用，复用相同列或条件，避免列表与计数的过滤口径分散。
      绑定参数：f.themeId、f.q、f.mastery、accountId、f.direction、f.lastRating；参数含义参见 Mapper 方法注释。
    -->
    <sql id="filter">
        <!--
          条件 f.themeId != null 成立时才输出此段 SQL。
        -->
        <if test="f.themeId != null">AND w.theme_id=#{f.themeId}</if>
        <!--
          条件 f.q != null and f.q != '' 成立时才输出此段 SQL。
        -->
        <if test="f.q != null and f.q != ''">AND (w.word LIKE CONCAT('%',#{f.q},'%') OR w.translation LIKE CONCAT('%',#{f.q},'%'))</if>
        <!--
          条件 f.learned == 'YES' 成立时才输出此段 SQL。
        -->
        <if test="f.learned == 'YES'">AND (m.memory_count &gt; 0 OR m.first_rated_at IS NOT NULL)</if>
        <!--
          条件 f.learned == 'NO' 成立时才输出此段 SQL。
        -->
        <if test="f.learned == 'NO'">AND COALESCE(m.memory_count,0)=0 AND m.first_rated_at IS NULL</if>
        <!--
          条件 f.mastery == 'UNRATED' 成立时才输出此段 SQL。
        -->
        <if test="f.mastery == 'UNRATED'">AND m.first_rated_at IS NULL</if>
        <!--
          条件 f.mastery != null and f.mastery != 'ANY' and f.mastery != 'UNRATED' 成立时才输出此段 SQL。
        -->
        <if test="f.mastery != null and f.mastery != 'ANY' and f.mastery != 'UNRATED'">AND m.mastery_rank=#{f.mastery}</if>
        <!--
          条件 f.inPlan == 'YES' 成立时才输出此段 SQL。
        -->
        <if test="f.inPlan == 'YES'">AND EXISTS (SELECT 1 FROM sr_english_vocabulary_plan_item pi WHERE pi.account_id=#{accountId} AND pi.word_id=w.id)</if>
        <!--
          条件 f.inPlan == 'NO' 成立时才输出此段 SQL。
        -->
        <if test="f.inPlan == 'NO'">AND NOT EXISTS (SELECT 1 FROM sr_english_vocabulary_plan_item pi WHERE pi.account_id=#{accountId} AND pi.word_id=w.id)</if>
        <!--
          条件 f.direction != 'ANY' or f.lastRating != 'ANY' 成立时才输出此段 SQL。
        -->
        <if test="f.direction != 'ANY' or f.lastRating != 'ANY'">
            AND EXISTS (SELECT 1 FROM sr_english_vocabulary_mode_memory mm WHERE mm.account_id=#{accountId} AND mm.word_id=w.id
                <!--
                  条件 f.direction != 'ANY' 成立时才输出此段 SQL。
                -->
                <if test="f.direction != 'ANY'">AND mm.direction=#{f.direction}</if>
                <!--
                  条件 f.lastRating != 'ANY' 成立时才输出此段 SQL。
                -->
                <if test="f.lastRating != 'ANY'">AND mm.last_rating=#{f.lastRating}</if>)
        </if>
    </sql>
    <!--
      selection：selection；可复用 SQL 片段。
      通过 include 引用，复用相同列或条件，避免列表与计数的过滤口径分散。
      复用片段：filter。
      绑定参数：id；参数含义参见 Mapper 方法注释。
    -->
    <sql id="selection">
        AND (
            <!--
              只采用第一个成立的 when 分支；否则使用 otherwise 分支（如有）。
            -->
            <choose>
                <!--
                  条件 s.selectAllMatched 成立时才输出此段 SQL。
                -->
                <when test="s.selectAllMatched">
                    (1=1 <include refid="filter"/>
                    <!--
                      条件 !s.excludedWordIds.isEmpty() 成立时才输出此段 SQL。
                    -->
                    <if test="!s.excludedWordIds.isEmpty()">AND w.id NOT IN
    <!--
      遍历 s.excludedWordIds，元素名为 id；open/close/separator 控制 SQL 列表格式。
      集合是否允许为空由外围条件和业务校验决定。
    -->
    <foreach collection="s.excludedWordIds" item="id" open="(" close=")" separator=",">#{id}</foreach></if>)
                </when>
                <!--
                  前面的 when 均不成立时使用此兜底分支。
                -->
                <otherwise>1=0</otherwise>
            </choose>
            <!--
              条件 !s.wordIds.isEmpty() 成立时才输出此段 SQL。
            -->
            <if test="!s.wordIds.isEmpty()">OR w.id IN
    <!--
      遍历 s.wordIds，元素名为 id；open/close/separator 控制 SQL 列表格式。
      集合是否允许为空由外围条件和业务校验决定。
    -->
    <foreach collection="s.wordIds" item="id" open="(" close=")" separator=",">#{id}</foreach></if>
        )
    </sql>
    <!--
      ensureSlot：ensureSlot；新增语句。
      涉及数据表：sr_english_vocabulary_plan；关系条件与可见性筛选由下方 SQL 明确限定。
      执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
      绑定参数：accountId；参数含义参见 Mapper 方法注释。
    -->
    <insert id="ensureSlot">INSERT INTO sr_english_vocabulary_plan(account_id) VALUES(#{accountId}) ON DUPLICATE KEY UPDATE account_id=account_id</insert>
    <!--
      lockSlot：锁Slot；读取语句。
      涉及数据表：sr_english_vocabulary_plan；关系条件与可见性筛选由下方 SQL 明确限定。
      结果类型或映射：com.starrainnotes.english.vocabulary.learning.VocabularyLearningModels$Plan；集合与单值形态由 Java 方法签名决定。
      复用片段：planColumns。
      绑定参数：accountId；参数含义参见 Mapper 方法注释。
      锁定命中的记录，直到事务结束；用于串行化当前对象的检查与写入。
    -->
    <select id="lockSlot" resultType="com.starrainnotes.english.vocabulary.learning.VocabularyLearningModels$Plan">
        SELECT <include refid="planColumns"/> FROM sr_english_vocabulary_plan p WHERE p.account_id=#{accountId} FOR UPDATE
    </select>
    <!--
      plan：计划；读取语句。
      涉及数据表：sr_english_vocabulary_plan_item、sr_english_vocabulary_plan；关系条件与可见性筛选由下方 SQL 明确限定。
      结果类型或映射：com.starrainnotes.english.vocabulary.learning.VocabularyLearningModels$Plan；集合与单值形态由 Java 方法签名决定。
      复用片段：planColumns。
      绑定参数：accountId；参数含义参见 Mapper 方法注释。
    -->
    <select id="plan" resultType="com.starrainnotes.english.vocabulary.learning.VocabularyLearningModels$Plan">
        SELECT <include refid="planColumns"/>,
            (SELECT COALESCE(MAX(group_no),0) FROM sr_english_vocabulary_plan_item WHERE account_id=#{accountId}) AS total_groups,
            (SELECT COALESCE(SUM(BIT_COUNT(done_mask)),0) FROM sr_english_vocabulary_plan_item WHERE account_id=#{accountId}) AS completed_ratings
        FROM sr_english_vocabulary_plan p WHERE p.account_id=#{accountId}
    </select>
    <!--
      defaultEntry：默认入口；读取语句。
      涉及数据表：sr_english_vocabulary_plan_item；关系条件与可见性筛选由下方 SQL 明确限定。
      结果类型或映射：com.starrainnotes.english.vocabulary.learning.VocabularyLearningModels$Entry；集合与单值形态由 Java 方法签名决定。
      绑定参数：accountId；参数含义参见 Mapper 方法注释。
      LIMIT 限定读取数量，若包含 OFFSET 则跳过对应记录；排序依据以本语句为准。
    -->
    <select id="defaultEntry" resultType="com.starrainnotes.english.vocabulary.learning.VocabularyLearningModels$Entry">
        SELECT word_id,group_no,sort_no,
            CASE WHEN (done_mask &amp; 1)=0 THEN 'EN_TO_ZH' WHEN (done_mask &amp; 2)=0 THEN 'ZH_TO_EN' ELSE 'AUDIO_TO_BOTH' END AS direction
        FROM sr_english_vocabulary_plan_item WHERE account_id=#{accountId} AND done_mask!=7
        ORDER BY group_no, CASE WHEN (done_mask &amp; 1)=0 THEN 0 WHEN (done_mask &amp; 2)=0 THEN 1 ELSE 2 END,sort_no LIMIT 1
    </select>
    <!--
      groups：分组列表；读取语句。
      涉及数据表：sr_english_vocabulary_plan_item；关系条件与可见性筛选由下方 SQL 明确限定。
      结果类型或映射：com.starrainnotes.english.vocabulary.learning.VocabularyLearningModels$GroupProgress；集合与单值形态由 Java 方法签名决定。
      绑定参数：accountId、after、limit；参数含义参见 Mapper 方法注释。
      LIMIT 限定读取数量，若包含 OFFSET 则跳过对应记录；排序依据以本语句为准。
      返回匹配条件的数量，不返回完整实体。
    -->
    <select id="groups" resultType="com.starrainnotes.english.vocabulary.learning.VocabularyLearningModels$GroupProgress">
        SELECT group_no,COUNT(*) AS total,SUM((done_mask &amp; 1)!=0) AS en_to_zh,
            SUM((done_mask &amp; 2)!=0) AS zh_to_en,SUM((done_mask &amp; 4)!=0) AS audio_to_both
        FROM sr_english_vocabulary_plan_item WHERE account_id=#{accountId} AND group_no &gt; #{after}
        GROUP BY group_no ORDER BY group_no LIMIT #{limit}
    </select>
    <!--
      items：条目集合；读取语句。
      涉及数据表：sr_english_vocabulary_plan_item、sr_english_vocabulary_word；关系条件与可见性筛选由下方 SQL 明确限定。
      结果类型或映射：com.starrainnotes.english.vocabulary.learning.VocabularyLearningModels$PlanItem；集合与单值形态由 Java 方法签名决定。
      绑定参数：accountId、after、groupNo、limit；参数含义参见 Mapper 方法注释。
      LIMIT 限定读取数量，若包含 OFFSET 则跳过对应记录；排序依据以本语句为准。
    -->
    <select id="items" resultType="com.starrainnotes.english.vocabulary.learning.VocabularyLearningModels$PlanItem">
        SELECT pi.word_id,pi.sort_no,pi.group_no,pi.done_mask,pi.word_json,(w.id IS NULL) AS unavailable
        FROM sr_english_vocabulary_plan_item pi LEFT JOIN sr_english_vocabulary_word w ON w.id=pi.word_id
        WHERE pi.account_id=#{accountId} AND pi.sort_no &gt; #{after}
        <!--
          条件 groupNo != null 成立时才输出此段 SQL。
        -->
        <if test="groupNo != null">AND pi.group_no=#{groupNo}</if>
        ORDER BY pi.sort_no LIMIT #{limit}
    </select>
    <!--
      item：item；读取语句。
      涉及数据表：sr_english_vocabulary_plan_item；关系条件与可见性筛选由下方 SQL 明确限定。
      结果类型或映射：com.starrainnotes.english.vocabulary.learning.VocabularyLearningModels$PlanItem；集合与单值形态由 Java 方法签名决定。
      绑定参数：accountId、wordId；参数含义参见 Mapper 方法注释。
    -->
    <select id="item" resultType="com.starrainnotes.english.vocabulary.learning.VocabularyLearningModels$PlanItem">
        SELECT word_id,sort_no,group_no,done_mask,word_json FROM sr_english_vocabulary_plan_item WHERE account_id=#{accountId} AND word_id=#{wordId}
    </select>
    <!--
      clearItems：clear条目集合；删除语句。
      涉及数据表：sr_english_vocabulary_plan_item；关系条件与可见性筛选由下方 SQL 明确限定。
      执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
      绑定参数：accountId；参数含义参见 Mapper 方法注释。
    -->
    <delete id="clearItems">DELETE FROM sr_english_vocabulary_plan_item WHERE account_id=#{accountId}</delete>
    <!--
      replacePlan：replace计划；更新语句。
      涉及数据表：sr_english_vocabulary_plan；关系条件与可见性筛选由下方 SQL 明确限定。
      执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
      绑定参数：plan.name、plan.sourceThemeId、plan.sourceName、plan.batchSize、plan.totalWords、plan.createdAt、accountId；参数含义参见 Mapper 方法注释。
    -->
    <update id="replacePlan">
        UPDATE sr_english_vocabulary_plan SET revision=revision+1,status='ACTIVE',name=#{plan.name},source_theme_id=#{plan.sourceThemeId},
            source_name=#{plan.sourceName},batch_size=#{plan.batchSize},total_words=#{plan.totalWords},created_at=#{plan.createdAt},updated_at=#{plan.createdAt}
        WHERE account_id=#{accountId}
    </update>
    <!--
      insertItems：新增条目集合；新增语句。
      涉及数据表：sr_english_vocabulary_plan_item；关系条件与可见性筛选由下方 SQL 明确限定。
      执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
      绑定参数：accountId、i.wordId、i.sortNo、i.groupNo、i.wordJson；参数含义参见 Mapper 方法注释。
    -->
    <insert id="insertItems">
        INSERT INTO sr_english_vocabulary_plan_item(account_id,word_id,sort_no,group_no,word_json) VALUES
        <!--
          遍历 items，元素名为 i；open/close/separator 控制 SQL 列表格式。
          集合是否允许为空由外围条件和业务校验决定。
        -->
        <foreach collection="items" item="i" separator=",">(#{accountId},#{i.wordId},#{i.sortNo},#{i.groupNo},#{i.wordJson})</foreach>
    </insert>
    <!--
      markDone：markDone；更新语句。
      涉及数据表：sr_english_vocabulary_plan_item；关系条件与可见性筛选由下方 SQL 明确限定。
      执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
      绑定参数：bit、now、accountId、wordId；参数含义参见 Mapper 方法注释。
    -->
    <update id="markDone">
        UPDATE sr_english_vocabulary_plan_item SET done_mask=done_mask | #{bit},started_at=COALESCE(started_at,#{now}) WHERE account_id=#{accountId} AND word_id=#{wordId}
    </update>
    <!--
      updatePlanStatus：更新计划状态；更新语句。
      涉及数据表：sr_english_vocabulary_plan、sr_english_vocabulary_plan_item；关系条件与可见性筛选由下方 SQL 明确限定。
      执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
      绑定参数：accountId、now；参数含义参见 Mapper 方法注释。
    -->
    <update id="updatePlanStatus">
        UPDATE sr_english_vocabulary_plan SET status=CASE WHEN EXISTS
            (SELECT 1 FROM sr_english_vocabulary_plan_item WHERE account_id=#{accountId} AND done_mask!=7) THEN 'ACTIVE' ELSE 'COMPLETED' END,
            updated_at=#{now} WHERE account_id=#{accountId}
    </update>
    <!--
      cancelPlan：cancel计划；更新语句。
      涉及数据表：sr_english_vocabulary_plan；关系条件与可见性筛选由下方 SQL 明确限定。
      执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
      绑定参数：now、accountId；参数含义参见 Mapper 方法注释。
    -->
    <update id="cancelPlan">UPDATE sr_english_vocabulary_plan SET revision=revision+1,status='NONE',total_words=0,updated_at=#{now} WHERE account_id=#{accountId}</update>
    <!--
      lastStartedGroup：最近Started分组；读取语句。
      涉及数据表：sr_english_vocabulary_plan_item；关系条件与可见性筛选由下方 SQL 明确限定。
      结果类型或映射：int；集合与单值形态由 Java 方法签名决定。
      绑定参数：accountId；参数含义参见 Mapper 方法注释。
    -->
    <select id="lastStartedGroup" resultType="int">SELECT COALESCE(MAX(group_no),0) FROM sr_english_vocabulary_plan_item WHERE account_id=#{accountId} AND started_at IS NOT NULL</select>
    <!--
      firstRemainingSort：首次剩余排序；读取语句。
      涉及数据表：sr_english_vocabulary_plan_item；关系条件与可见性筛选由下方 SQL 明确限定。
      结果类型或映射：java.lang.Integer；集合与单值形态由 Java 方法签名决定。
      绑定参数：accountId、frozen；参数含义参见 Mapper 方法注释。
    -->
    <select id="firstRemainingSort" resultType="java.lang.Integer">SELECT MIN(sort_no) FROM sr_english_vocabulary_plan_item WHERE account_id=#{accountId} AND group_no &gt; #{frozen}</select>
    <!--
      regroup：regroup；更新语句。
      涉及数据表：sr_english_vocabulary_plan_item；关系条件与可见性筛选由下方 SQL 明确限定。
      执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
      绑定参数：frozen、firstSort、batchSize、accountId；参数含义参见 Mapper 方法注释。
    -->
    <update id="regroup">UPDATE sr_english_vocabulary_plan_item SET group_no=#{frozen}+1+FLOOR((sort_no-#{firstSort})/#{batchSize}) WHERE account_id=#{accountId} AND group_no &gt; #{frozen}</update>
    <!--
      resize：resize；更新语句。
      涉及数据表：sr_english_vocabulary_plan；关系条件与可见性筛选由下方 SQL 明确限定。
      执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
      绑定参数：batchSize、now、accountId；参数含义参见 Mapper 方法注释。
    -->
    <update id="resize">UPDATE sr_english_vocabulary_plan SET batch_size=#{batchSize},revision=revision+1,updated_at=#{now} WHERE account_id=#{accountId}</update>
    <!--
      countWords：数量Words；读取语句。
      结果类型或映射：long；集合与单值形态由 Java 方法签名决定。
      复用片段：wordFrom、filter。
      返回匹配条件的数量，不返回完整实体。
    -->
    <select id="countWords" resultType="long">SELECT COUNT(*) <include refid="wordFrom"/> WHERE 1=1 <include refid="filter"/></select>
    <!--
      wordPage：单词分页；读取语句。
      结果类型或映射：long；集合与单值形态由 Java 方法签名决定。
      复用片段：wordFrom、filter。
      绑定参数：limit、offset；参数含义参见 Mapper 方法注释。
      LIMIT 限定读取数量，若包含 OFFSET 则跳过对应记录；排序依据以本语句为准。
    -->
    <select id="wordPage" resultType="long">SELECT w.id <include refid="wordFrom"/> WHERE 1=1 <include refid="filter"/> ORDER BY w.sort_order,w.id LIMIT #{limit} OFFSET #{offset}</select>
    <!--
      selected：选中；读取语句。
      结果类型或映射：com.starrainnotes.english.vocabulary.learning.VocabularyLearningModels$SelectionRow；集合与单值形态由 Java 方法签名决定。
      复用片段：wordFrom、selection。
      绑定参数：after、limit；参数含义参见 Mapper 方法注释。
      LIMIT 限定读取数量，若包含 OFFSET 则跳过对应记录；排序依据以本语句为准。
    -->
    <select id="selected" resultType="com.starrainnotes.english.vocabulary.learning.VocabularyLearningModels$SelectionRow">
        <!--
          将表达式 s 绑定为 f，供后续参数占位符复用。
        -->
        <bind name="f" value="s"/>
        SELECT w.id AS word_id,MD5(CONCAT_WS('|',w.id,w.theme_id,w.word,w.translation,COALESCE(w.scene_meaning,''),COALESCE(w.phonetic_us,''),COALESCE(w.phonetic_uk,''),COALESCE(w.inflections,''),COALESCE(w.examples,''),w.sort_order)) AS token
        <include refid="wordFrom"/> WHERE w.id &gt; #{after} <include refid="selection"/> ORDER BY w.id LIMIT #{limit}
    </select>
    <!--
      learnedCount：已学习数量；读取语句。
      涉及数据表：sr_english_vocabulary_memory；关系条件与可见性筛选由下方 SQL 明确限定。
