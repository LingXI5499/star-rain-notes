<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.starrainnotes.account.mapper.AccountMapper">
    <!--
      AccountMapper.xml：com.starrainnotes.account.mapper.AccountMapper 的 MyBatis SQL 映射。
      语句 id 对应 Mapper 接口方法；#{...} 使用预编译参数，字段别名及结果映射约定保持一致。
      读写行为由每条语句决定；需要锁的查询应由业务层开启事务并在同一连接内执行。
    -->


    <!--
      accountColumns：账号投影列；可复用 SQL 片段。
      通过 include 引用，复用相同列或条件，避免列表与计数的过滤口径分散。
    -->
    <sql id="accountColumns">
        id, username, email, email_verified_at, display_name, status, auth_version, last_login_at, created_at
    </sql>
    <!--
      accountFilters：账号筛选条件；可复用 SQL 片段。
      通过 include 引用，复用相同列或条件，避免列表与计数的过滤口径分散。
      绑定参数：keyword、status；参数含义参见 Mapper 方法注释。
    -->
    <sql id="accountFilters">
        <!--
          统一生成 WHERE 并去除开头多余的 AND/OR；没有有效条件时不输出该子句。
        -->
        <where>
            <!--
              条件 keyword != null and keyword != '' 成立时才输出此段 SQL。
            -->
            <if test="keyword != null and keyword != ''">
                (username LIKE CONCAT('%', #{keyword}, '%')
                 OR email LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <!--
              条件 status != null and status != '' 成立时才输出此段 SQL。
            -->
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
    </sql>
    <!--
      auditFilters：审计筛选条件；可复用 SQL 片段。
      通过 include 引用，复用相同列或条件，避免列表与计数的过滤口径分散。
      绑定参数：actor、target、action、result、start、end；参数含义参见 Mapper 方法注释。
    -->
    <sql id="auditFilters">
        <!--
          统一生成 WHERE 并去除开头多余的 AND/OR；没有有效条件时不输出该子句。
        -->
        <where>
            <!--
              条件 actor != null 成立时才输出此段 SQL。
            -->
            <if test="actor != null">actor_account_id = #{actor}</if>
            <!--
              条件 target != null 成立时才输出此段 SQL。
            -->
            <if test="target != null">AND target_account_id = #{target}</if>
            <!--
              条件 action != null and action != '' 成立时才输出此段 SQL。
            -->
            <if test="action != null and action != ''">AND action_code = #{action}</if>
            <!--
              条件 result != null and result != '' 成立时才输出此段 SQL。
            -->
            <if test="result != null and result != ''">AND result = #{result}</if>
            <!--
              条件 start != null 成立时才输出此段 SQL。
            -->
            <if test="start != null">AND created_at &gt;= #{start}</if>
            <!--
              条件 end != null 成立时才输出此段 SQL。
            -->
            <if test="end != null">AND created_at &lt;= #{end}</if>
        </where>
    </sql>

    <!--
      accountByIdentifier：账号依据Identifier；读取语句。
      涉及数据表：sr_account；关系条件与可见性筛选由下方 SQL 明确限定。
      结果类型或映射：com.starrainnotes.account.entity.AccountEntity；集合与单值形态由 Java 方法签名决定。
      复用片段：accountColumns。
      绑定参数：identifier；参数含义参见 Mapper 方法注释。
      LIMIT 限定读取数量，若包含 OFFSET 则跳过对应记录；排序依据以本语句为准。
    -->
    <select id="accountByIdentifier" resultType="com.starrainnotes.account.entity.AccountEntity">
        SELECT <include refid="accountColumns"/> FROM sr_account
        WHERE username = #{identifier} OR email = #{identifier}
        LIMIT 1
    </select>
    <!--
      accountById：账号依据标识；读取语句。
      涉及数据表：sr_account；关系条件与可见性筛选由下方 SQL 明确限定。
      结果类型或映射：com.starrainnotes.account.entity.AccountEntity；集合与单值形态由 Java 方法签名决定。
      复用片段：accountColumns。
      绑定参数：id；参数含义参见 Mapper 方法注释。
    -->
    <select id="accountById" resultType="com.starrainnotes.account.entity.AccountEntity">
        SELECT <include refid="accountColumns"/> FROM sr_account WHERE id = #{id}
    </select>
    <!--
      accountByIdForUpdate：账号依据标识面向更新；读取语句。
      涉及数据表：sr_account；关系条件与可见性筛选由下方 SQL 明确限定。
      结果类型或映射：com.starrainnotes.account.entity.AccountEntity；集合与单值形态由 Java 方法签名决定。
      复用片段：accountColumns。
      绑定参数：id；参数含义参见 Mapper 方法注释。
      锁定命中的记录，直到事务结束；用于串行化当前对象的检查与写入。
    -->
    <select id="accountByIdForUpdate" resultType="com.starrainnotes.account.entity.AccountEntity">
        SELECT <include refid="accountColumns"/> FROM sr_account WHERE id = #{id} FOR UPDATE
    </select>
    <!--
      accountByEmail：账号依据邮箱；读取语句。
      涉及数据表：sr_account；关系条件与可见性筛选由下方 SQL 明确限定。
      结果类型或映射：com.starrainnotes.account.entity.AccountEntity；集合与单值形态由 Java 方法签名决定。
      复用片段：accountColumns。
      绑定参数：email；参数含义参见 Mapper 方法注释。
    -->
    <select id="accountByEmail" resultType="com.starrainnotes.account.entity.AccountEntity">
        SELECT <include refid="accountColumns"/> FROM sr_account WHERE email = #{email}
    </select>
    <!--
      usernameCount：用户名数量；读取语句。
      涉及数据表：sr_account；关系条件与可见性筛选由下方 SQL 明确限定。
      结果类型或映射：int；集合与单值形态由 Java 方法签名决定。
      绑定参数：username；参数含义参见 Mapper 方法注释。
      返回匹配条件的数量，不返回完整实体。
    -->
    <select id="usernameCount" resultType="int">
        SELECT COUNT(*) FROM sr_account WHERE username = #{username}
    </select>
    <!--
      emailCount：邮箱数量；读取语句。
      涉及数据表：sr_account；关系条件与可见性筛选由下方 SQL 明确限定。
      结果类型或映射：int；集合与单值形态由 Java 方法签名决定。
      绑定参数：email；参数含义参见 Mapper 方法注释。
      返回匹配条件的数量，不返回完整实体。
    -->
    <select id="emailCount" resultType="int">
        SELECT COUNT(*) FROM sr_account WHERE email = #{email}
    </select>
    <!--
      insertAccount：新增账号；新增语句。
      涉及数据表：sr_account；关系条件与可见性筛选由下方 SQL 明确限定。
      执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
      插入成功后 JDBC 自动生成的主键回填到 id。
      绑定参数：username、email、emailVerifiedAt、displayName、status；参数含义参见 Mapper 方法注释。
    -->
    <insert id="insertAccount" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sr_account(username, email, email_verified_at, display_name, status)
        VALUES (#{username}, #{email}, #{emailVerifiedAt}, #{displayName}, #{status})
    </insert>
    <!--
      verifyEmail：verify邮箱；更新语句。
      涉及数据表：sr_account；关系条件与可见性筛选由下方 SQL 明确限定。
      执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
      绑定参数：accountId；参数含义参见 Mapper 方法注释。
    -->
    <update id="verifyEmail">
        UPDATE sr_account SET email_verified_at = UTC_TIMESTAMP(6)
        WHERE id = #{accountId} AND email_verified_at IS NULL
    </update>
    <!--
      insertCredential：新增Credential；新增语句。
      涉及数据表：sr_account_credential；关系条件与可见性筛选由下方 SQL 明确限定。
      执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
      绑定参数：accountId、passwordHash；参数含义参见 Mapper 方法注释。
    -->
    <insert id="insertCredential">
        INSERT INTO sr_account_credential(account_id, password_hash)
        VALUES (#{accountId}, #{passwordHash})
    </insert>
    <!--
      passwordHash：密码的哈希值，不能作为明文密码或公开资料返回；读取语句。
      涉及数据表：sr_account_credential；关系条件与可见性筛选由下方 SQL 明确限定。
      结果类型或映射：string；集合与单值形态由 Java 方法签名决定。
      绑定参数：accountId；参数含义参见 Mapper 方法注释。
    -->
    <select id="passwordHash" resultType="string">
        SELECT password_hash FROM sr_account_credential WHERE account_id = #{accountId}
    </select>
    <!--
      updatePassword：更新密码；更新语句。
      涉及数据表：sr_account_credential；关系条件与可见性筛选由下方 SQL 明确限定。
      执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
      绑定参数：passwordHash、accountId；参数含义参见 Mapper 方法注释。
    -->
    <update id="updatePassword">
        UPDATE sr_account_credential
        SET password_hash = #{passwordHash}, password_changed_at = CURRENT_TIMESTAMP(3)
        WHERE account_id = #{accountId}
    </update>
    <!--
      updateDisplayName：更新显示名称；更新语句。
      涉及数据表：sr_account；关系条件与可见性筛选由下方 SQL 明确限定。
      执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
      绑定参数：displayName、accountId；参数含义参见 Mapper 方法注释。
    -->
    <update id="updateDisplayName">
        UPDATE sr_account SET display_name = #{displayName} WHERE id = #{accountId}
    </update>
    <!--
      updateLastLogin：更新最近Login；更新语句。
      涉及数据表：sr_account；关系条件与可见性筛选由下方 SQL 明确限定。
      执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
      绑定参数：accountId；参数含义参见 Mapper 方法注释。
    -->
    <update id="updateLastLogin">
        UPDATE sr_account SET last_login_at = CURRENT_TIMESTAMP(3) WHERE id = #{accountId}
    </update>
    <!--
      incrementAuthVersion：increment认证版本；更新语句。
      涉及数据表：sr_account；关系条件与可见性筛选由下方 SQL 明确限定。
      执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
      绑定参数：accountId；参数含义参见 Mapper 方法注释。
    -->
    <update id="incrementAuthVersion">
        UPDATE sr_account SET auth_version = auth_version + 1 WHERE id = #{accountId}
    </update>
    <!--
      incrementVersionsForRole：incrementVersions面向角色；更新语句。
      涉及数据表：sr_account、sr_account_role；关系条件与可见性筛选由下方 SQL 明确限定。
      执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
      绑定参数：roleId；参数含义参见 Mapper 方法注释。
    -->
    <update id="incrementVersionsForRole">
        UPDATE sr_account SET auth_version = auth_version + 1
        WHERE id IN (SELECT account_id FROM sr_account_role WHERE role_id = #{roleId})
    </update>
    <!--
      updateStatus：更新状态；更新语句。
      涉及数据表：sr_account；关系条件与可见性筛选由下方 SQL 明确限定。
      执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
      绑定参数：status、accountId；参数含义参见 Mapper 方法注释。
    -->
    <update id="updateStatus">
        UPDATE sr_account SET status = #{status}, auth_version = auth_version + 1
        WHERE id = #{accountId}
    </update>

    <!--
      roleByCode：角色依据代码；读取语句。
      涉及数据表：sr_role；关系条件与可见性筛选由下方 SQL 明确限定。
      结果类型或映射：com.starrainnotes.account.entity.RoleEntity；集合与单值形态由 Java 方法签名决定。
      绑定参数：code；参数含义参见 Mapper 方法注释。
    -->
    <select id="roleByCode" resultType="com.starrainnotes.account.entity.RoleEntity">
        SELECT id, code, name, description, status FROM sr_role WHERE code = #{code}
    </select>
    <!--
      roleById：角色依据标识；读取语句。
      涉及数据表：sr_role；关系条件与可见性筛选由下方 SQL 明确限定。
      结果类型或映射：com.starrainnotes.account.entity.RoleEntity；集合与单值形态由 Java 方法签名决定。
      绑定参数：id；参数含义参见 Mapper 方法注释。
    -->
    <select id="roleById" resultType="com.starrainnotes.account.entity.RoleEntity">
        SELECT id, code, name, description, status FROM sr_role WHERE id = #{id}
    </select>
    <!--
      allRoles：全部角色集合；读取语句。
      涉及数据表：sr_role；关系条件与可见性筛选由下方 SQL 明确限定。
      结果类型或映射：com.starrainnotes.account.entity.RoleEntity；集合与单值形态由 Java 方法签名决定。
    -->
    <select id="allRoles" resultType="com.starrainnotes.account.entity.RoleEntity">
        SELECT id, code, name, description, status FROM sr_role ORDER BY id
    </select>
    <!--
      allPermissions：全部权限集合；读取语句。
      涉及数据表：sr_permission；关系条件与可见性筛选由下方 SQL 明确限定。
      结果类型或映射：com.starrainnotes.account.entity.PermissionEntity；集合与单值形态由 Java 方法签名决定。
    -->
    <select id="allPermissions" resultType="com.starrainnotes.account.entity.PermissionEntity">
        SELECT id, code, resource, action, name, description, status
        FROM sr_permission ORDER BY resource, action
    </select>
    <!--
      roleCodes：角色Codes；读取语句。
      涉及数据表：sr_account_role、sr_role；关系条件与可见性筛选由下方 SQL 明确限定。
      结果类型或映射：string；集合与单值形态由 Java 方法签名决定。
      绑定参数：accountId；参数含义参见 Mapper 方法注释。
    -->
    <select id="roleCodes" resultType="string">
        SELECT DISTINCT r.code FROM sr_account_role ar
        JOIN sr_role r ON r.id = ar.role_id AND r.status = 'ENABLED'
        WHERE ar.account_id = #{accountId}
    </select>
    <!--
      permissionCodes：权限Codes；读取语句。
      涉及数据表：sr_account_role、sr_role、sr_role_permission、sr_permission；关系条件与可见性筛选由下方 SQL 明确限定。
      结果类型或映射：string；集合与单值形态由 Java 方法签名决定。
      绑定参数：accountId；参数含义参见 Mapper 方法注释。
    -->
    <select id="permissionCodes" resultType="string">
        SELECT DISTINCT p.code FROM sr_account_role ar
        JOIN sr_role r ON r.id = ar.role_id AND r.status = 'ENABLED'
        JOIN sr_role_permission rp ON rp.role_id = r.id
        JOIN sr_permission p ON p.id = rp.permission_id AND p.status = 'ENABLED'
        WHERE ar.account_id = #{accountId}
    </select>
    <!--
      roleIds：角色标识集合；读取语句。
      涉及数据表：sr_account_role；关系条件与可见性筛选由下方 SQL 明确限定。
      结果类型或映射：long；集合与单值形态由 Java 方法签名决定。
      绑定参数：accountId；参数含义参见 Mapper 方法注释。
    -->
    <select id="roleIds" resultType="long">
        SELECT role_id FROM sr_account_role WHERE account_id = #{accountId}
    </select>
    <!--
      permissionIdsForRole：权限标识集合面向角色；读取语句。
      涉及数据表：sr_role_permission；关系条件与可见性筛选由下方 SQL 明确限定。
      结果类型或映射：long；集合与单值形态由 Java 方法签名决定。
      绑定参数：roleId；参数含义参见 Mapper 方法注释。
    -->
    <select id="permissionIdsForRole" resultType="long">
        SELECT permission_id FROM sr_role_permission WHERE role_id = #{roleId}
    </select>
    <!--
      activeSuperAdminCount：有效Super后台数量；读取语句。
      涉及数据表：sr_account_role、sr_role、sr_account；关系条件与可见性筛选由下方 SQL 明确限定。
      结果类型或映射：int；集合与单值形态由 Java 方法签名决定。
      返回匹配条件的数量，不返回完整实体。
    -->
    <select id="activeSuperAdminCount" resultType="int">
        SELECT COUNT(*) FROM sr_account_role ar
        JOIN sr_role r ON r.id = ar.role_id AND r.code = 'SUPER_ADMIN'
        JOIN sr_account a ON a.id = ar.account_id AND a.status = 'ACTIVE'
    </select>
    <!--
      superAdminAssignmentCount：super后台Assignment数量；读取语句。
      涉及数据表：sr_account_role、sr_role；关系条件与可见性筛选由下方 SQL 明确限定。
      结果类型或映射：int；集合与单值形态由 Java 方法签名决定。
      返回匹配条件的数量，不返回完整实体。
    -->
    <select id="superAdminAssignmentCount" resultType="int">
        SELECT COUNT(*) FROM sr_account_role ar
        JOIN sr_role r ON r.id = ar.role_id AND r.code = 'SUPER_ADMIN'
    </select>
    <!--
      lockSuperAdminRole：锁Super后台角色；读取语句。
      涉及数据表：sr_role；关系条件与可见性筛选由下方 SQL 明确限定。
      结果类型或映射：long；集合与单值形态由 Java 方法签名决定。
      锁定命中的记录，直到事务结束；用于串行化当前对象的检查与写入。
    -->
    <select id="lockSuperAdminRole" resultType="long">
        SELECT id FROM sr_role WHERE code = 'SUPER_ADMIN' FOR UPDATE
    </select>
    <!--
      insertAccountRole：新增账号角色；新增语句。
      涉及数据表：sr_account_role；关系条件与可见性筛选由下方 SQL 明确限定。
      执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
      绑定参数：accountId、roleId、grantedBy；参数含义参见 Mapper 方法注释。
    -->
    <insert id="insertAccountRole">
        INSERT IGNORE INTO sr_account_role(account_id, role_id, granted_by)
        VALUES (#{accountId}, #{roleId}, #{grantedBy})
    </insert>
    <!--
      deleteAccountRoles：删除账号角色集合；删除语句。
      涉及数据表：sr_account_role；关系条件与可见性筛选由下方 SQL 明确限定。
      执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
      绑定参数：accountId；参数含义参见 Mapper 方法注释。
    -->
    <delete id="deleteAccountRoles">
        DELETE FROM sr_account_role WHERE account_id = #{accountId}
    </delete>
    <!--
      deleteRolePermissions：删除角色权限集合；删除语句。
      涉及数据表：sr_role_permission；关系条件与可见性筛选由下方 SQL 明确限定。
      执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
      绑定参数：roleId；参数含义参见 Mapper 方法注释。
    -->
    <delete id="deleteRolePermissions">
        DELETE FROM sr_role_permission WHERE role_id = #{roleId}
    </delete>
    <!--
      insertRolePermission：新增角色权限；新增语句。
      涉及数据表：sr_role_permission；关系条件与可见性筛选由下方 SQL 明确限定。
      执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
      绑定参数：roleId、permissionId；参数含义参见 Mapper 方法注释。
    -->
    <insert id="insertRolePermission">
        INSERT IGNORE INTO sr_role_permission(role_id, permission_id)
        VALUES (#{roleId}, #{permissionId})
    </insert>
    <!--
      permissionCount：权限数量；读取语句。
      涉及数据表：sr_permission；关系条件与可见性筛选由下方 SQL 明确限定。
      结果类型或映射：int；集合与单值形态由 Java 方法签名决定。
      绑定参数：id；参数含义参见 Mapper 方法注释。
      返回匹配条件的数量，不返回完整实体。
    -->
    <select id="permissionCount" resultType="int">
        SELECT COUNT(*) FROM sr_permission WHERE id = #{id} AND status = 'ENABLED'
    </select>
    <!--
      rolePermissionCount：角色权限数量；读取语句。
      涉及数据表：sr_role_permission；关系条件与可见性筛选由下方 SQL 明确限定。
      结果类型或映射：int；集合与单值形态由 Java 方法签名决定。
      绑定参数：roleId、permissionId；参数含义参见 Mapper 方法注释。
      返回匹配条件的数量，不返回完整实体。
    -->
    <select id="rolePermissionCount" resultType="int">
        SELECT COUNT(*) FROM sr_role_permission
        WHERE role_id = #{roleId} AND permission_id = #{permissionId}
    </select>

    <!--
      accountPageCount：账号分页数量；读取语句。
