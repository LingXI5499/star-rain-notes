<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <!--
      pom.xml：star-rain-common 的 Maven 构建描述。
      父 POM 统一版本与构建约定；本模块只声明自身装配所需的模块和库。
      依赖 scope、插件执行阶段与聚合 modules 共同决定编译、测试及产物，注释不改变构建参数。
    -->

    <modelVersion>4.0.0</modelVersion>

    <!--
      继承父项目的依赖管理、插件默认值与版本约定；relativePath 决定本地父 POM 的查找方式。
    -->
    <parent>
        <groupId>com.starrainnotes</groupId>
        <artifactId>star-rain-parent</artifactId>
        <version>2.0.1</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>star-rain-common</artifactId>

    <!--
      声明本模块实际依赖；内部模块提供跨模块契约，scope 限定使用阶段。
    -->
    <dependencies>
        <!--
          依赖 org.springframework.boot:spring-boot-starter-web。
          使用范围：compile；版本由父项目或依赖管理提供。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!--
          依赖 org.springframework.boot:spring-boot-starter-validation。
          使用范围：compile；版本由父项目或依赖管理提供。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!--
          依赖 org.springframework.boot:spring-boot-starter-security。
          使用范围：compile；版本由父项目或依赖管理提供。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!--
          依赖 org.projectlombok:lombok。
          使用范围：provided；版本为 1.18.42。
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.42</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
