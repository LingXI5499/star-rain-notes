<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.starrainnotes.tutorial.learning.mapper.LearningHistoryMapper">
    <!--
      LearningHistoryMapper.xml：com.starrainnotes.tutorial.learning.mapper.LearningHistoryMapper 的 MyBatis SQL 映射。
      语句 id 对应 Mapper 接口方法；#{...} 使用预编译参数，字段别名及结果映射约定保持一致。
      读写行为由每条语句决定；需要锁的查询应由业务层开启事务并在同一连接内执行。
    -->


  <!--
    columns：投影列；可复用 SQL 片段。
    通过 include 引用，复用相同列或条件，避免列表与计数的过滤口径分散。
  -->
  <sql id="columns">
    id, account_id, event_type, tutorial_id, group_id, chapter_id, knowledge_card_id,
    study_task_id, review_task_id, detail_json, occurred_at, created_at
  </sql>

  <!-- occurred_at / created_at 交给列默认值；事件链上的外键允许为空（不同事件携带的上下文不同） -->
  <!--
    insert：新增；新增语句。
    涉及数据表：sr_learning_history；关系条件与可见性筛选由下方 SQL 明确限定。
    输入对象：com.starrainnotes.tutorial.learning.entity.LearningHistoryEntity；占位符按其属性读取。
    执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
    插入成功后 JDBC 自动生成的主键回填到 id。
    绑定参数：accountId、eventType、tutorialId、groupId、chapterId、knowledgeCardId、studyTaskId、reviewTaskId、detailJson；参数含义参见 Mapper 方法注释。
  -->
  <insert id="insert" parameterType="com.starrainnotes.tutorial.learning.entity.LearningHistoryEntity"
          useGeneratedKeys="true" keyProperty="id">
    INSERT INTO sr_learning_history
      (account_id, event_type, tutorial_id, group_id, chapter_id, knowledge_card_id,
       study_task_id, review_task_id, detail_json)
    VALUES
      (#{accountId}, #{eventType}, #{tutorialId}, #{groupId}, #{chapterId}, #{knowledgeCardId},
       #{studyTaskId}, #{reviewTaskId}, #{detailJson})
  </insert>

  <!--
    countByAccountId：数量依据账号标识；读取语句。
    涉及数据表：sr_learning_history；关系条件与可见性筛选由下方 SQL 明确限定。
    结果类型或映射：long；集合与单值形态由 Java 方法签名决定。
    绑定参数：accountId；参数含义参见 Mapper 方法注释。
    返回匹配条件的数量，不返回完整实体。
  -->
  <select id="countByAccountId" resultType="long">
    SELECT COUNT(*) FROM sr_learning_history WHERE account_id = #{accountId}
  </select>

  <!--
    pageByAccountId：分页依据账号标识；读取语句。
    涉及数据表：sr_learning_history；关系条件与可见性筛选由下方 SQL 明确限定。
    结果类型或映射：com.starrainnotes.tutorial.learning.entity.LearningHistoryEntity；集合与单值形态由 Java 方法签名决定。
    复用片段：columns。
    绑定参数：accountId、limit、offset；参数含义参见 Mapper 方法注释。
    LIMIT 限定读取数量，若包含 OFFSET 则跳过对应记录；排序依据以本语句为准。
  -->
  <select id="pageByAccountId" resultType="com.starrainnotes.tutorial.learning.entity.LearningHistoryEntity">
    SELECT <include refid="columns"/> FROM sr_learning_history
    WHERE account_id = #{accountId}
    ORDER BY occurred_at DESC, id DESC
    LIMIT #{limit} OFFSET #{offset}
  </select>
</mapper>
