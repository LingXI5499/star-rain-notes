<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.starrainnotes.tutorial.learning.mapper.ReviewTaskMapper">
    <!--
      ReviewTaskMapper.xml：com.starrainnotes.tutorial.learning.mapper.ReviewTaskMapper 的 MyBatis SQL 映射。
      语句 id 对应 Mapper 接口方法；#{...} 使用预编译参数，字段别名及结果映射约定保持一致。
      读写行为由每条语句决定；需要锁的查询应由业务层开启事务并在同一连接内执行。
    -->


  <!--
    columns：投影列；可复用 SQL 片段。
    通过 include 引用，复用相同列或条件，避免列表与计数的过滤口径分散。
  -->
  <sql id="columns">
    id, schedule_id, account_id, knowledge_card_id, due_at, status,
    generated_at, completed_at, created_at
  </sql>

  <!-- 同一 schedule_id + due_at 只允许一条任务，重复入队由唯一键挡住 -->
  <!--
    insertDue：新增Due；新增语句。
    涉及数据表：sr_review_task；关系条件与可见性筛选由下方 SQL 明确限定。
    执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
    绑定参数：scheduleId、accountId、cardId、dueAt；参数含义参见 Mapper 方法注释。
  -->
  <insert id="insertDue">
    INSERT IGNORE INTO sr_review_task
                (schedule_id, account_id, knowledge_card_id, due_at, status)
            VALUES (#{scheduleId}, #{accountId}, #{cardId}, #{dueAt}, 'PENDING')
  </insert>

  <!--
    selectById：查询依据标识；读取语句。
    涉及数据表：sr_review_task；关系条件与可见性筛选由下方 SQL 明确限定。
    结果类型或映射：com.starrainnotes.tutorial.learning.entity.ReviewTaskEntity；集合与单值形态由 Java 方法签名决定。
    复用片段：columns。
    绑定参数：id；参数含义参见 Mapper 方法注释。
  -->
  <select id="selectById" resultType="com.starrainnotes.tutorial.learning.entity.ReviewTaskEntity">
    SELECT <include refid="columns"/> FROM sr_review_task WHERE id = #{id}
  </select>

  <!--
    listPendingByAccountId：list待处理依据账号标识；读取语句。
    涉及数据表：sr_review_task；关系条件与可见性筛选由下方 SQL 明确限定。
    结果类型或映射：com.starrainnotes.tutorial.learning.entity.ReviewTaskEntity；集合与单值形态由 Java 方法签名决定。
    复用片段：columns。
    绑定参数：accountId；参数含义参见 Mapper 方法注释。
    LIMIT 限定读取数量，若包含 OFFSET 则跳过对应记录；排序依据以本语句为准。
  -->
  <select id="listPendingByAccountId" resultType="com.starrainnotes.tutorial.learning.entity.ReviewTaskEntity">
    SELECT <include refid="columns"/> FROM sr_review_task
    WHERE account_id = #{accountId} AND status IN ('PENDING', 'OVERDUE')
    ORDER BY due_at
    LIMIT 100
  </select>

  <!--
    countCompletedByAccountId：数量已完成依据账号标识；读取语句。
    涉及数据表：sr_review_task；关系条件与可见性筛选由下方 SQL 明确限定。
    结果类型或映射：long；集合与单值形态由 Java 方法签名决定。
    绑定参数：accountId；参数含义参见 Mapper 方法注释。
    返回匹配条件的数量，不返回完整实体。
  -->
  <select id="countCompletedByAccountId" resultType="long">
    SELECT COUNT(*) FROM sr_review_task WHERE account_id = #{accountId} AND status = 'COMPLETED'
  </select>

  <!--
    markOverdue：markOverdue；更新语句。
    涉及数据表：sr_review_task；关系条件与可见性筛选由下方 SQL 明确限定。
    执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
    绑定参数：accountId、now；参数含义参见 Mapper 方法注释。
  -->
  <update id="markOverdue">
    UPDATE sr_review_task SET status = 'OVERDUE'
            WHERE account_id = #{accountId} AND due_at &lt; #{now} AND status = 'PENDING'
  </update>

  <!--
    complete：complete；更新语句。
    涉及数据表：sr_review_task；关系条件与可见性筛选由下方 SQL 明确限定。
    执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
    绑定参数：taskId、accountId；参数含义参见 Mapper 方法注释。
  -->
  <update id="complete">
    UPDATE sr_review_task SET status = 'COMPLETED', completed_at = UTC_TIMESTAMP(3)
            WHERE id = #{taskId} AND account_id = #{accountId}
              AND status IN ('PENDING', 'OVERDUE')
  </update>
</mapper>
