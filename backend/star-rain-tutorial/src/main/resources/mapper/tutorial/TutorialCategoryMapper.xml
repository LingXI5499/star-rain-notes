<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.starrainnotes.tutorial.content.mapper.TutorialCategoryMapper">
    <!--
      TutorialCategoryMapper.xml：com.starrainnotes.tutorial.content.mapper.TutorialCategoryMapper 的 MyBatis SQL 映射。
      语句 id 对应 Mapper 接口方法；#{...} 使用预编译参数，字段别名及结果映射约定保持一致。
      读写行为由每条语句决定；需要锁的查询应由业务层开启事务并在同一连接内执行。
    -->


  <!--
    columns：投影列；可复用 SQL 片段。
    通过 include 引用，复用相同列或条件，避免列表与计数的过滤口径分散。
  -->
  <sql id="columns">
    id, name, slug, sort_order, created_at, updated_at
  </sql>

  <!-- created_at / updated_at 交给列默认值，与原先 insert 跳过 null 字段的行为一致 -->
  <!--
    insert：新增；新增语句。
    涉及数据表：sr_tutorial_category；关系条件与可见性筛选由下方 SQL 明确限定。
    输入对象：com.starrainnotes.tutorial.content.entity.TutorialCategoryEntity；占位符按其属性读取。
    执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
    插入成功后 JDBC 自动生成的主键回填到 id。
    绑定参数：name、slug、sortOrder；参数含义参见 Mapper 方法注释。
  -->
  <insert id="insert" parameterType="com.starrainnotes.tutorial.content.entity.TutorialCategoryEntity"
          useGeneratedKeys="true" keyProperty="id">
    INSERT INTO sr_tutorial_category (name, slug, sort_order)
    VALUES (#{name}, #{slug}, #{sortOrder})
  </insert>

  <!--
    selectById：查询依据标识；读取语句。
    涉及数据表：sr_tutorial_category；关系条件与可见性筛选由下方 SQL 明确限定。
    结果类型或映射：com.starrainnotes.tutorial.content.entity.TutorialCategoryEntity；集合与单值形态由 Java 方法签名决定。
    复用片段：columns。
    绑定参数：id；参数含义参见 Mapper 方法注释。
  -->
  <select id="selectById" resultType="com.starrainnotes.tutorial.content.entity.TutorialCategoryEntity">
    SELECT <include refid="columns"/> FROM sr_tutorial_category WHERE id = #{id}
  </select>

  <!--
    listOrdered：listOrdered；读取语句。
    涉及数据表：sr_tutorial_category、sr_tutorial、sr_tutorial_chapter；关系条件与可见性筛选由下方 SQL 明确限定。
    结果类型或映射：com.starrainnotes.tutorial.content.entity.TutorialCategoryEntity；集合与单值形态由 Java 方法签名决定。
    返回匹配条件的数量，不返回完整实体。
  -->
  <select id="listOrdered" resultType="com.starrainnotes.tutorial.content.entity.TutorialCategoryEntity">
    SELECT c.id, c.name, c.slug, c.sort_order, c.created_at, c.updated_at,
      COALESCE(t.tutorial_count, 0) AS tutorial_count, COALESCE(ch.chapter_count, 0) AS chapter_count
    FROM sr_tutorial_category c
    LEFT JOIN (SELECT category_id, COUNT(*) AS tutorial_count FROM sr_tutorial GROUP BY category_id) t ON t.category_id = c.id
    LEFT JOIN (SELECT t.category_id, COUNT(*) AS chapter_count FROM sr_tutorial_chapter ch
      JOIN sr_tutorial t ON t.id = ch.tutorial_id GROUP BY t.category_id) ch ON ch.category_id = c.id
    ORDER BY c.sort_order, c.id
  </select>

  <!--
    countBySlug：数量依据固定链接标识；读取语句。
    涉及数据表：sr_tutorial_category；关系条件与可见性筛选由下方 SQL 明确限定。
    结果类型或映射：long；集合与单值形态由 Java 方法签名决定。
    绑定参数：slug；参数含义参见 Mapper 方法注释。
    返回匹配条件的数量，不返回完整实体。
  -->
  <select id="countBySlug" resultType="long">
    SELECT COUNT(*) FROM sr_tutorial_category WHERE slug = #{slug}
  </select>

  <!--
    updateName：更新名称；更新语句。
    涉及数据表：sr_tutorial_category；关系条件与可见性筛选由下方 SQL 明确限定。
    执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
    绑定参数：name、updatedAt、id；参数含义参见 Mapper 方法注释。
  -->
  <update id="updateName">
    UPDATE sr_tutorial_category SET name = #{name}, updated_at = #{updatedAt} WHERE id = #{id}
  </update>

  <!--
    updateSortOrder：更新排序顺序；更新语句。
    涉及数据表：sr_tutorial_category；关系条件与可见性筛选由下方 SQL 明确限定。
    执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
    绑定参数：sortOrder、updatedAt、id；参数含义参见 Mapper 方法注释。
  -->
  <update id="updateSortOrder">
    UPDATE sr_tutorial_category SET sort_order = #{sortOrder}, updated_at = #{updatedAt} WHERE id = #{id}
  </update>

  <!--
    deleteById：删除依据标识；删除语句。
    涉及数据表：sr_tutorial_category；关系条件与可见性筛选由下方 SQL 明确限定。
    执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
    绑定参数：id；参数含义参见 Mapper 方法注释。
  -->
  <delete id="deleteById">
    DELETE FROM sr_tutorial_category WHERE id = #{id}
  </delete>
</mapper>
