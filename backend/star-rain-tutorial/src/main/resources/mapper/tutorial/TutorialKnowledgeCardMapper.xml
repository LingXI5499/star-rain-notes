<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.starrainnotes.tutorial.content.mapper.TutorialKnowledgeCardMapper">
    <!--
      TutorialKnowledgeCardMapper.xml：com.starrainnotes.tutorial.content.mapper.TutorialKnowledgeCardMapper 的 MyBatis SQL 映射。
      语句 id 对应 Mapper 接口方法；#{...} 使用预编译参数，字段别名及结果映射约定保持一致。
      读写行为由每条语句决定；需要锁的查询应由业务层开启事务并在同一连接内执行。
    -->


  <!--
    columns：投影列；可复用 SQL 片段。
    通过 include 引用，复用相同列或条件，避免列表与计数的过滤口径分散。
  -->
  <sql id="columns">
    row_version, id, chapter_id, front_text, back_markdown, content_version, sort_order, status, created_at, updated_at
  </sql>

  <!--
    saveWorkspace：saveWorkspace；更新语句。
    涉及数据表：sr_tutorial_knowledge_card；关系条件与可见性筛选由下方 SQL 明确限定。
    执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
    绑定参数：frontText、backMarkdown、status、updatedAt、id、rowVersion；参数含义参见 Mapper 方法注释。
  -->
  <update id="saveWorkspace">
    UPDATE sr_tutorial_knowledge_card SET content_version = content_version + IF(NOT(front_text &lt;=&gt; #{frontText}) OR NOT(back_markdown &lt;=&gt; #{backMarkdown}), 1, 0),
      front_text = #{frontText}, back_markdown = #{backMarkdown},
      status = #{status}, updated_at = #{updatedAt}, row_version = row_version + 1
    WHERE id = #{id} AND row_version = #{rowVersion}
  </update>
  <!--
    insert：新增；新增语句。
    涉及数据表：sr_tutorial_knowledge_card；关系条件与可见性筛选由下方 SQL 明确限定。
    输入对象：com.starrainnotes.tutorial.content.entity.TutorialKnowledgeCardEntity；占位符按其属性读取。
    执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
    插入成功后 JDBC 自动生成的主键回填到 id。
    绑定参数：chapterId、frontText、backMarkdown、sortOrder、status；参数含义参见 Mapper 方法注释。
  -->
  <insert id="insert" parameterType="com.starrainnotes.tutorial.content.entity.TutorialKnowledgeCardEntity"
          useGeneratedKeys="true" keyProperty="id">
    INSERT INTO sr_tutorial_knowledge_card
      (chapter_id, front_text, back_markdown, sort_order, status)
    VALUES
      (#{chapterId}, #{frontText}, #{backMarkdown}, #{sortOrder}, #{status})
  </insert>

  <!--
    selectById：查询依据标识；读取语句。
    涉及数据表：sr_tutorial_knowledge_card；关系条件与可见性筛选由下方 SQL 明确限定。
    结果类型或映射：com.starrainnotes.tutorial.content.entity.TutorialKnowledgeCardEntity；集合与单值形态由 Java 方法签名决定。
    复用片段：columns。
    绑定参数：id；参数含义参见 Mapper 方法注释。
  -->
  <select id="selectById" resultType="com.starrainnotes.tutorial.content.entity.TutorialKnowledgeCardEntity">
    SELECT <include refid="columns"/> FROM sr_tutorial_knowledge_card WHERE id = #{id}
  </select>

  <!--
    listByChapterId：list依据章节标识；读取语句。
    涉及数据表：sr_tutorial_knowledge_card；关系条件与可见性筛选由下方 SQL 明确限定。
    结果类型或映射：com.starrainnotes.tutorial.content.entity.TutorialKnowledgeCardEntity；集合与单值形态由 Java 方法签名决定。
    复用片段：columns。
    绑定参数：chapterId；参数含义参见 Mapper 方法注释。
  -->
  <select id="listByChapterId" resultType="com.starrainnotes.tutorial.content.entity.TutorialKnowledgeCardEntity">
    SELECT <include refid="columns"/> FROM sr_tutorial_knowledge_card
    WHERE chapter_id = #{chapterId}
    ORDER BY sort_order, id
  </select>

  <!--
    listEnabledByChapterId：list已启用依据章节标识；读取语句。
    涉及数据表：sr_tutorial_knowledge_card；关系条件与可见性筛选由下方 SQL 明确限定。
    结果类型或映射：com.starrainnotes.tutorial.content.entity.TutorialKnowledgeCardEntity；集合与单值形态由 Java 方法签名决定。
    复用片段：columns。
    绑定参数：chapterId；参数含义参见 Mapper 方法注释。
  -->
  <select id="listEnabledByChapterId" resultType="com.starrainnotes.tutorial.content.entity.TutorialKnowledgeCardEntity">
    SELECT <include refid="columns"/> FROM sr_tutorial_knowledge_card
    WHERE chapter_id = #{chapterId} AND status = 'ENABLED'
    ORDER BY sort_order, id
  </select>

  <!--
    updateContent：更新内容；更新语句。
    涉及数据表：sr_tutorial_knowledge_card；关系条件与可见性筛选由下方 SQL 明确限定。
    执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
    绑定参数：frontText、backMarkdown、status、updatedAt、id；参数含义参见 Mapper 方法注释。
  -->
  <update id="updateContent">
    UPDATE sr_tutorial_knowledge_card
    SET content_version = content_version + IF(NOT(front_text &lt;=&gt; #{frontText}) OR NOT(back_markdown &lt;=&gt; #{backMarkdown}), 1, 0),
        front_text = #{frontText}, back_markdown = #{backMarkdown},
        status = #{status}, row_version = row_version + 1, updated_at = #{updatedAt}
    WHERE id = #{id}
  </update>

  <!-- 排序只改 sort_order：与原先 updateById 只带一个非空字段的效果相同 -->
  <!--
    updateSortOrder：更新排序顺序；更新语句。
    涉及数据表：sr_tutorial_knowledge_card；关系条件与可见性筛选由下方 SQL 明确限定。
    执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
    绑定参数：sortOrder、id；参数含义参见 Mapper 方法注释。
  -->
  <update id="updateSortOrder">
    UPDATE sr_tutorial_knowledge_card SET sort_order = #{sortOrder} WHERE id = #{id}
  </update>

  <!--
    deleteById：删除依据标识；删除语句。
    涉及数据表：sr_tutorial_knowledge_card；关系条件与可见性筛选由下方 SQL 明确限定。
    执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
    绑定参数：id；参数含义参见 Mapper 方法注释。
  -->
  <delete id="deleteById">
    DELETE FROM sr_tutorial_knowledge_card WHERE id = #{id}
  </delete>
</mapper>
