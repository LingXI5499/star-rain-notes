<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.starrainnotes.tutorial.content.mapper.TutorialChapterMapper">
    <!--
      TutorialChapterMapper.xml：com.starrainnotes.tutorial.content.mapper.TutorialChapterMapper 的 MyBatis SQL 映射。
      语句 id 对应 Mapper 接口方法；#{...} 使用预编译参数，字段别名及结果映射约定保持一致。
      读写行为由每条语句决定；需要锁的查询应由业务层开启事务并在同一连接内执行。
    -->


  <!-- body_markdown 很大，列表查询同样需要它：公开修订快照按列内容冻结 -->
  <!--
    columns：投影列；可复用 SQL 片段。
    通过 include 引用，复用相同列或条件，避免列表与计数的过滤口径分散。
  -->
  <sql id="columns">
    row_version, id, tutorial_id, group_id, slug, title, summary, body_markdown,
    sort_order, status, created_at, updated_at
  </sql>

  <!--
    saveWorkspace：saveWorkspace；更新语句。
    涉及数据表：sr_tutorial_chapter；关系条件与可见性筛选由下方 SQL 明确限定。
    执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
    绑定参数：title、summary、bodyMarkdown、updatedAt、id、rowVersion；参数含义参见 Mapper 方法注释。
  -->
  <update id="saveWorkspace">
    UPDATE sr_tutorial_chapter
    SET title = #{title}, summary = #{summary}, body_markdown = #{bodyMarkdown},
        row_version = row_version + 1, updated_at = #{updatedAt}
    WHERE id = #{id} AND row_version = #{rowVersion}
  </update>
  <!--
    bumpVersion：bump版本；更新语句。
    涉及数据表：sr_tutorial_chapter；关系条件与可见性筛选由下方 SQL 明确限定。
    执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
    绑定参数：id；参数含义参见 Mapper 方法注释。
  -->
  <update id="bumpVersion">
    UPDATE sr_tutorial_chapter SET row_version = row_version + 1 WHERE id = #{id}
  </update>

  <!--
    insert：新增；新增语句。
    涉及数据表：sr_tutorial_chapter；关系条件与可见性筛选由下方 SQL 明确限定。
    输入对象：com.starrainnotes.tutorial.content.entity.TutorialChapterEntity；占位符按其属性读取。
    执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
    插入成功后 JDBC 自动生成的主键回填到 id。
    绑定参数：tutorialId、groupId、slug、title、summary、bodyMarkdown、sortOrder、status；参数含义参见 Mapper 方法注释。
  -->
  <insert id="insert" parameterType="com.starrainnotes.tutorial.content.entity.TutorialChapterEntity"
          useGeneratedKeys="true" keyProperty="id">
    INSERT INTO sr_tutorial_chapter
      (tutorial_id, group_id, slug, title, summary, body_markdown, sort_order, status)
    VALUES
      (#{tutorialId}, #{groupId}, #{slug}, #{title}, #{summary}, #{bodyMarkdown}, #{sortOrder}, #{status})
  </insert>

  <!--
    selectById：查询依据标识；读取语句。
    涉及数据表：sr_tutorial_chapter；关系条件与可见性筛选由下方 SQL 明确限定。
    结果类型或映射：com.starrainnotes.tutorial.content.entity.TutorialChapterEntity；集合与单值形态由 Java 方法签名决定。
    复用片段：columns。
    绑定参数：id；参数含义参见 Mapper 方法注释。
  -->
  <select id="selectById" resultType="com.starrainnotes.tutorial.content.entity.TutorialChapterEntity">
    SELECT <include refid="columns"/> FROM sr_tutorial_chapter WHERE id = #{id}
  </select>

  <!--
    listByGroupId：list依据分组标识；读取语句。
    涉及数据表：sr_tutorial_chapter；关系条件与可见性筛选由下方 SQL 明确限定。
    结果类型或映射：com.starrainnotes.tutorial.content.entity.TutorialChapterEntity；集合与单值形态由 Java 方法签名决定。
    复用片段：columns。
    绑定参数：groupId；参数含义参见 Mapper 方法注释。
  -->
  <select id="listByGroupId" resultType="com.starrainnotes.tutorial.content.entity.TutorialChapterEntity">
    SELECT <include refid="columns"/> FROM sr_tutorial_chapter
    WHERE group_id = #{groupId}
    ORDER BY sort_order, id
  </select>

  <!--
    listActiveByGroupId：list有效依据分组标识；读取语句。
    涉及数据表：sr_tutorial_chapter；关系条件与可见性筛选由下方 SQL 明确限定。
    结果类型或映射：com.starrainnotes.tutorial.content.entity.TutorialChapterEntity；集合与单值形态由 Java 方法签名决定。
    复用片段：columns。
    绑定参数：groupId；参数含义参见 Mapper 方法注释。
  -->
  <select id="listActiveByGroupId" resultType="com.starrainnotes.tutorial.content.entity.TutorialChapterEntity">
    SELECT <include refid="columns"/> FROM sr_tutorial_chapter
    WHERE group_id = #{groupId} AND status = 'PUBLISHED'
    ORDER BY sort_order, id
  </select>

  <!--
    countByTutorialId：数量依据教程标识；读取语句。
    涉及数据表：sr_tutorial_chapter；关系条件与可见性筛选由下方 SQL 明确限定。
    结果类型或映射：long；集合与单值形态由 Java 方法签名决定。
    绑定参数：tutorialId；参数含义参见 Mapper 方法注释。
    返回匹配条件的数量，不返回完整实体。
  -->
  <select id="countByTutorialId" resultType="long">
    SELECT COUNT(*) FROM sr_tutorial_chapter WHERE tutorial_id = #{tutorialId}
  </select>

  <!--
    countActiveByGroupId：数量有效依据分组标识；读取语句。
    涉及数据表：sr_tutorial_chapter；关系条件与可见性筛选由下方 SQL 明确限定。
    结果类型或映射：long；集合与单值形态由 Java 方法签名决定。
    绑定参数：groupId；参数含义参见 Mapper 方法注释。
    返回匹配条件的数量，不返回完整实体。
  -->
  <select id="countActiveByGroupId" resultType="long">
    SELECT COUNT(*) FROM sr_tutorial_chapter WHERE group_id = #{groupId} AND status = 'PUBLISHED'
  </select>

  <!--
    countByTutorialIdAndSlug：数量依据教程标识及固定链接标识；读取语句。
    涉及数据表：sr_tutorial_chapter；关系条件与可见性筛选由下方 SQL 明确限定。
    结果类型或映射：long；集合与单值形态由 Java 方法签名决定。
    绑定参数：tutorialId、slug；参数含义参见 Mapper 方法注释。
    返回匹配条件的数量，不返回完整实体。
  -->
  <select id="countByTutorialIdAndSlug" resultType="long">
    SELECT COUNT(*) FROM sr_tutorial_chapter WHERE tutorial_id = #{tutorialId} AND slug = #{slug}
  </select>

  <!--
    summary 允许被清空：它必须无条件出现在 SET 里，null 表示「删除章节摘要」。
    这与原先 @TableField(updateStrategy = FieldStrategy.ALWAYS) 的行为一致；
    写成 <if test="summary != null"> 会让「清空摘要」这个已经支持的操作失效。
  -->
  <!--
    updateContent：更新内容；更新语句。
    涉及数据表：sr_tutorial_chapter；关系条件与可见性筛选由下方 SQL 明确限定。
    执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
    绑定参数：title、summary、updatedAt、id；参数含义参见 Mapper 方法注释。
  -->
  <update id="updateContent">
    UPDATE sr_tutorial_chapter
    SET title = #{title}, summary = #{summary}, updated_at = #{updatedAt}
    WHERE id = #{id}
  </update>

  <!--
    updateBody：更新正文；更新语句。
    涉及数据表：sr_tutorial_chapter；关系条件与可见性筛选由下方 SQL 明确限定。
    执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
    绑定参数：bodyMarkdown、updatedAt、id；参数含义参见 Mapper 方法注释。
  -->
  <update id="updateBody">
    UPDATE sr_tutorial_chapter
    SET body_markdown = #{bodyMarkdown}, updated_at = #{updatedAt}
    WHERE id = #{id}
  </update>

  <!--
    updateStatus：更新状态；更新语句。
    涉及数据表：sr_tutorial_chapter；关系条件与可见性筛选由下方 SQL 明确限定。
    执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
    绑定参数：status、updatedAt、id；参数含义参见 Mapper 方法注释。
  -->
  <update id="updateStatus">
    UPDATE sr_tutorial_chapter SET status = #{status}, updated_at = #{updatedAt} WHERE id = #{id}
  </update>

  <!--
    updateSortOrder：更新排序顺序；更新语句。
    涉及数据表：sr_tutorial_chapter；关系条件与可见性筛选由下方 SQL 明确限定。
    执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
    绑定参数：sortOrder、updatedAt、id；参数含义参见 Mapper 方法注释。
  -->
  <update id="updateSortOrder">
    UPDATE sr_tutorial_chapter SET sort_order = #{sortOrder}, updated_at = #{updatedAt} WHERE id = #{id}
  </update>

  <!--
    moveToGroup：move目标分组；更新语句。
    涉及数据表：sr_tutorial_chapter；关系条件与可见性筛选由下方 SQL 明确限定。
    执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
    绑定参数：groupId、sortOrder、updatedAt、id；参数含义参见 Mapper 方法注释。
  -->
  <update id="moveToGroup">
    UPDATE sr_tutorial_chapter
    SET group_id = #{groupId}, sort_order = #{sortOrder}, updated_at = #{updatedAt}
    WHERE id = #{id}
  </update>
  <!--
    deleteById：删除依据标识；删除语句。
    涉及数据表：sr_tutorial_chapter；关系条件与可见性筛选由下方 SQL 明确限定。
    执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
    绑定参数：id；参数含义参见 Mapper 方法注释。
  -->
  <delete id="deleteById">DELETE FROM sr_tutorial_chapter WHERE id = #{id}</delete>
</mapper>
