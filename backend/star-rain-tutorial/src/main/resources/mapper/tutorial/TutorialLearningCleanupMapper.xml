<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.starrainnotes.tutorial.content.mapper.TutorialLearningCleanupMapper">
    <!--
      TutorialLearningCleanupMapper.xml：com.starrainnotes.tutorial.content.mapper.TutorialLearningCleanupMapper 的 MyBatis SQL 映射。
      语句 id 对应 Mapper 接口方法；#{...} 使用预编译参数，字段别名及结果映射约定保持一致。
      读写行为由每条语句决定；需要锁的查询应由业务层开启事务并在同一连接内执行。
    -->

 <!--
   affectedPlan：affected计划；可复用 SQL 片段。
   涉及数据表：sr_study_plan_chapter；关系条件与可见性筛选由下方 SQL 明确限定。
   通过 include 引用，复用相同列或条件，避免列表与计数的过滤口径分散。
   绑定参数：id；参数含义参见 Mapper 方法注释。
 -->
 <sql id="affectedPlan">
  <!--
    只采用第一个成立的 when 分支；否则使用 otherwise 分支（如有）。
  -->
  <choose>
   <!--
     条件 scope == 'TUTORIAL' 成立时才输出此段 SQL。
   -->
   <when test="scope == 'TUTORIAL'">p.tutorial_id=#{id}</when>
   <!--
     条件 scope == 'GROUP' 成立时才输出此段 SQL。
   -->
   <when test="scope == 'GROUP'">(p.scope_type='GROUP' AND p.scope_id=#{id} OR EXISTS(SELECT 1 FROM sr_study_plan_chapter pc WHERE pc.plan_id=p.id AND pc.group_id=#{id}))</when>
   <!--
     条件 scope == 'CHAPTER' 成立时才输出此段 SQL。
   -->
   <when test="scope == 'CHAPTER'">(p.scope_type='CHAPTER' AND p.scope_id=#{id} OR EXISTS(SELECT 1 FROM sr_study_plan_chapter pc WHERE pc.plan_id=p.id AND pc.chapter_id=#{id}))</when>
   <!--
     前面的 when 均不成立时使用此兜底分支。
   -->
   <otherwise>1=0</otherwise>
  </choose>
 </sql>
 <!--
   cancelPlans：cancelPlans；更新语句。
   涉及数据表：sr_study_plan；关系条件与可见性筛选由下方 SQL 明确限定。
   执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
   复用片段：affectedPlan。
 -->
 <update id="cancelPlans">
  UPDATE sr_study_plan p SET p.status='CANCELLED'
  WHERE p.status IN ('DRAFT','ACTIVE','PAUSED') AND <include refid="affectedPlan"/>
 </update>
 <!--
   skipCancelledTasks：skipCancelledTasks；更新语句。
   涉及数据表：sr_study_task、sr_study_plan；关系条件与可见性筛选由下方 SQL 明确限定。
   执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
   复用片段：affectedPlan。
 -->
 <update id="skipCancelledTasks">
  UPDATE sr_study_task t JOIN sr_study_plan p ON p.id=t.plan_id SET t.status='SKIPPED'
  WHERE p.status='CANCELLED' AND t.status IN ('PENDING','IN_PROGRESS','TODO','OVERDUE') AND <include refid="affectedPlan"/>
 </update>
 <!--
   deleteChapterRelations：删除章节Relations；删除语句。
   涉及数据表：sr_tutorial_question_card、sr_tutorial_question、sr_tutorial_knowledge_card；关系条件与可见性筛选由下方 SQL 明确限定。
   执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
   绑定参数：chapterId；参数含义参见 Mapper 方法注释。
 -->
 <delete id="deleteChapterRelations">
  DELETE r FROM sr_tutorial_question_card r
  LEFT JOIN sr_tutorial_question q ON q.id=r.question_id
  LEFT JOIN sr_tutorial_knowledge_card c ON c.id=r.knowledge_card_id
  WHERE q.chapter_id=#{chapterId} OR c.chapter_id=#{chapterId}
 </delete>
</mapper>
