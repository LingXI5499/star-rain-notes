<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.starrainnotes.tutorial.content.mapper.TutorialQuestionCardMapper">
    <!--
      TutorialQuestionCardMapper.xml：com.starrainnotes.tutorial.content.mapper.TutorialQuestionCardMapper 的 MyBatis SQL 映射。
      语句 id 对应 Mapper 接口方法；#{...} 使用预编译参数，字段别名及结果映射约定保持一致。
      读写行为由每条语句决定；需要锁的查询应由业务层开启事务并在同一连接内执行。
    -->

 <!--
   cardIds：卡片标识集合；读取语句。
   涉及数据表：sr_tutorial_question_card；关系条件与可见性筛选由下方 SQL 明确限定。
   结果类型或映射：java.lang.Long；集合与单值形态由 Java 方法签名决定。
   绑定参数：questionId；参数含义参见 Mapper 方法注释。
 -->
 <select id="cardIds" resultType="java.lang.Long">SELECT knowledge_card_id FROM sr_tutorial_question_card WHERE question_id=#{questionId} ORDER BY sort_order,id</select>
 <!--
   deleteQuestion：删除问题；删除语句。
   涉及数据表：sr_tutorial_question_card；关系条件与可见性筛选由下方 SQL 明确限定。
   执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
   绑定参数：questionId；参数含义参见 Mapper 方法注释。
 -->
 <delete id="deleteQuestion">DELETE FROM sr_tutorial_question_card WHERE question_id=#{questionId}</delete>
 <!--
   deleteCard：删除卡片；删除语句。
   涉及数据表：sr_tutorial_question_card；关系条件与可见性筛选由下方 SQL 明确限定。
   执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
   绑定参数：cardId；参数含义参见 Mapper 方法注释。
 -->
 <delete id="deleteCard">DELETE FROM sr_tutorial_question_card WHERE knowledge_card_id=#{cardId}</delete>
 <!--
   insert：新增；新增语句。
   涉及数据表：sr_tutorial_question_card；关系条件与可见性筛选由下方 SQL 明确限定。
   执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
   绑定参数：questionId、cardId、sortOrder；参数含义参见 Mapper 方法注释。
 -->
 <insert id="insert">INSERT INTO sr_tutorial_question_card(question_id,knowledge_card_id,sort_order) VALUES(#{questionId},#{cardId},#{sortOrder})</insert>
</mapper>
