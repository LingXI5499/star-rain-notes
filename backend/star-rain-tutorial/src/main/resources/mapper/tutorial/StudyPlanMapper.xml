<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.starrainnotes.tutorial.learning.mapper.StudyPlanMapper">
    <!--
      StudyPlanMapper.xml：com.starrainnotes.tutorial.learning.mapper.StudyPlanMapper 的 MyBatis SQL 映射。
      语句 id 对应 Mapper 接口方法；#{...} 使用预编译参数，字段别名及结果映射约定保持一致。
      读写行为由每条语句决定；需要锁的查询应由业务层开启事务并在同一连接内执行。
    -->


  <!--
    columns：投影列；可复用 SQL 片段。
    通过 include 引用，复用相同列或条件，避免列表与计数的过滤口径分散。
  -->
  <sql id="columns">
    id, account_id, tutorial_id, name, scope_type, scope_id, start_date, end_date,
    study_weekdays_json, daily_target_minutes, status, generated_version, created_at, updated_at
  </sql>

  <!-- end_date / daily_target_minutes 允许为空，显式写 NULL 与原先 insert 跳过 null 字段等价 -->
  <!--
    insert：新增；新增语句。
    涉及数据表：sr_study_plan；关系条件与可见性筛选由下方 SQL 明确限定。
    输入对象：com.starrainnotes.tutorial.learning.entity.StudyPlanEntity；占位符按其属性读取。
    执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
    插入成功后 JDBC 自动生成的主键回填到 id。
    绑定参数：accountId、tutorialId、name、scopeType、scopeId、startDate、endDate、studyWeekdaysJson、dailyTargetMinutes、status、generatedVersion；参数含义参见 Mapper 方法注释。
  -->
  <insert id="insert" parameterType="com.starrainnotes.tutorial.learning.entity.StudyPlanEntity"
          useGeneratedKeys="true" keyProperty="id">
    INSERT INTO sr_study_plan
      (account_id, tutorial_id, name, scope_type, scope_id, start_date, end_date,
       study_weekdays_json, daily_target_minutes, status, generated_version)
    VALUES
      (#{accountId}, #{tutorialId}, #{name}, #{scopeType}, #{scopeId}, #{startDate}, #{endDate},
       #{studyWeekdaysJson}, #{dailyTargetMinutes}, #{status}, #{generatedVersion})
  </insert>

  <!--
    selectById：查询依据标识；读取语句。
    涉及数据表：sr_study_plan；关系条件与可见性筛选由下方 SQL 明确限定。
    结果类型或映射：com.starrainnotes.tutorial.learning.entity.StudyPlanEntity；集合与单值形态由 Java 方法签名决定。
    复用片段：columns。
    绑定参数：id；参数含义参见 Mapper 方法注释。
  -->
  <select id="selectById" resultType="com.starrainnotes.tutorial.learning.entity.StudyPlanEntity">
    SELECT <include refid="columns"/> FROM sr_study_plan WHERE id = #{id}
  </select>

  <!--
    listRecentByAccountId：listRecent依据账号标识；读取语句。
    涉及数据表：sr_study_plan；关系条件与可见性筛选由下方 SQL 明确限定。
    结果类型或映射：com.starrainnotes.tutorial.learning.entity.StudyPlanEntity；集合与单值形态由 Java 方法签名决定。
    复用片段：columns。
    绑定参数：accountId；参数含义参见 Mapper 方法注释。
    LIMIT 限定读取数量，若包含 OFFSET 则跳过对应记录；排序依据以本语句为准。
  -->
  <select id="listRecentByAccountId" resultType="com.starrainnotes.tutorial.learning.entity.StudyPlanEntity">
    SELECT <include refid="columns"/> FROM sr_study_plan
    WHERE account_id = #{accountId}
    ORDER BY updated_at DESC
    LIMIT 100
  </select>

  <!--
    countActiveByAccountId：数量有效依据账号标识；读取语句。
    涉及数据表：sr_study_plan；关系条件与可见性筛选由下方 SQL 明确限定。
    结果类型或映射：long；集合与单值形态由 Java 方法签名决定。
    绑定参数：accountId；参数含义参见 Mapper 方法注释。
    返回匹配条件的数量，不返回完整实体。
  -->
  <select id="countActiveByAccountId" resultType="long">
    SELECT COUNT(*) FROM sr_study_plan WHERE account_id = #{accountId} AND status = 'ACTIVE'
  </select>

  <!--
    保存计划定义。end_date / daily_target_minutes 的 <if> 不是「把 Wrappers 搬进 XML」，而是把
    原先 updateById 的 NOT_NULL 字段策略显式写出来：请求里没带这两个字段时保留库里的旧值。
    无条件 SET 会把「没传」变成「清空」，属于业务行为改变。
    updated_at 不写进 SET，由列上的 ON UPDATE CURRENT_TIMESTAMP(3) 维护，
    与原先 updateById 不携带 updated_at 时由 MySQL 自动更新时间戳的行为一致。
  -->
  <!--
    updateDefinition：更新Definition；更新语句。
    涉及数据表：sr_study_plan；关系条件与可见性筛选由下方 SQL 明确限定。
    输入对象：com.starrainnotes.tutorial.learning.entity.StudyPlanEntity；占位符按其属性读取。
    执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
    绑定参数：tutorialId、name、scopeType、scopeId、startDate、endDate、studyWeekdaysJson、dailyTargetMinutes、status、generatedVersion、id；参数含义参见 Mapper 方法注释。
  -->
  <update id="updateDefinition" parameterType="com.starrainnotes.tutorial.learning.entity.StudyPlanEntity">
    UPDATE sr_study_plan
    SET tutorial_id = #{tutorialId},
        name = #{name},
        scope_type = #{scopeType},
        scope_id = #{scopeId},
        start_date = #{startDate},
        <!--
          条件 endDate != null 成立时才输出此段 SQL。
        -->
        <if test="endDate != null">end_date = #{endDate},</if>
        study_weekdays_json = #{studyWeekdaysJson},
        <!--
          条件 dailyTargetMinutes != null 成立时才输出此段 SQL。
        -->
        <if test="dailyTargetMinutes != null">daily_target_minutes = #{dailyTargetMinutes},</if>
        status = #{status},
        generated_version = #{generatedVersion}
    WHERE id = #{id}
  </update>

  <!--
    updateStatus：更新状态；更新语句。
    涉及数据表：sr_study_plan；关系条件与可见性筛选由下方 SQL 明确限定。
    执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
    绑定参数：status、generatedVersion、id；参数含义参见 Mapper 方法注释。
  -->
  <update id="updateStatus">
    UPDATE sr_study_plan
    SET status = #{status}, generated_version = #{generatedVersion}
    WHERE id = #{id}
  </update>
</mapper>
