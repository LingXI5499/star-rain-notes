<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.starrainnotes.tutorial.content.mapper.TutorialGroupMapper">
    <!--
      TutorialGroupMapper.xml：com.starrainnotes.tutorial.content.mapper.TutorialGroupMapper 的 MyBatis SQL 映射。
      语句 id 对应 Mapper 接口方法；#{...} 使用预编译参数，字段别名及结果映射约定保持一致。
      读写行为由每条语句决定；需要锁的查询应由业务层开启事务并在同一连接内执行。
    -->


  <!--
    columns：投影列；可复用 SQL 片段。
    通过 include 引用，复用相同列或条件，避免列表与计数的过滤口径分散。
  -->
  <sql id="columns">
    id, tutorial_id, title, description, sort_order, status, created_at, updated_at
  </sql>

  <!--
    insert：新增；新增语句。
    涉及数据表：sr_tutorial_group；关系条件与可见性筛选由下方 SQL 明确限定。
    输入对象：com.starrainnotes.tutorial.content.entity.TutorialGroupEntity；占位符按其属性读取。
    执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
    插入成功后 JDBC 自动生成的主键回填到 id。
    绑定参数：tutorialId、title、sortOrder、status；参数含义参见 Mapper 方法注释。
  -->
  <insert id="insert" parameterType="com.starrainnotes.tutorial.content.entity.TutorialGroupEntity"
          useGeneratedKeys="true" keyProperty="id">
    INSERT INTO sr_tutorial_group (tutorial_id, title, sort_order, status)
    VALUES (#{tutorialId}, #{title}, #{sortOrder}, #{status})
  </insert>

  <!--
    selectById：查询依据标识；读取语句。
    涉及数据表：sr_tutorial_group；关系条件与可见性筛选由下方 SQL 明确限定。
    结果类型或映射：com.starrainnotes.tutorial.content.entity.TutorialGroupEntity；集合与单值形态由 Java 方法签名决定。
    复用片段：columns。
    绑定参数：id；参数含义参见 Mapper 方法注释。
  -->
  <select id="selectById" resultType="com.starrainnotes.tutorial.content.entity.TutorialGroupEntity">
    SELECT <include refid="columns"/> FROM sr_tutorial_group WHERE id = #{id}
  </select>

  <!--
    listByTutorialId：list依据教程标识；读取语句。
    涉及数据表：sr_tutorial_group；关系条件与可见性筛选由下方 SQL 明确限定。
    结果类型或映射：com.starrainnotes.tutorial.content.entity.TutorialGroupEntity；集合与单值形态由 Java 方法签名决定。
    复用片段：columns。
    绑定参数：tutorialId；参数含义参见 Mapper 方法注释。
  -->
  <select id="listByTutorialId" resultType="com.starrainnotes.tutorial.content.entity.TutorialGroupEntity">
    SELECT <include refid="columns"/> FROM sr_tutorial_group
    WHERE tutorial_id = #{tutorialId}
    ORDER BY sort_order, id
  </select>

  <!--
    listActiveByTutorialId：list有效依据教程标识；读取语句。
    涉及数据表：sr_tutorial_group；关系条件与可见性筛选由下方 SQL 明确限定。
    结果类型或映射：com.starrainnotes.tutorial.content.entity.TutorialGroupEntity；集合与单值形态由 Java 方法签名决定。
    复用片段：columns。
    绑定参数：tutorialId；参数含义参见 Mapper 方法注释。
  -->
  <select id="listActiveByTutorialId" resultType="com.starrainnotes.tutorial.content.entity.TutorialGroupEntity">
    SELECT <include refid="columns"/> FROM sr_tutorial_group
    WHERE tutorial_id = #{tutorialId} AND status = 'ACTIVE'
    ORDER BY sort_order, id
  </select>

  <!--
    countByTutorialId：数量依据教程标识；读取语句。
    涉及数据表：sr_tutorial_group；关系条件与可见性筛选由下方 SQL 明确限定。
    结果类型或映射：long；集合与单值形态由 Java 方法签名决定。
    绑定参数：tutorialId；参数含义参见 Mapper 方法注释。
    返回匹配条件的数量，不返回完整实体。
  -->
  <select id="countByTutorialId" resultType="long">
    SELECT COUNT(*) FROM sr_tutorial_group WHERE tutorial_id = #{tutorialId}
  </select>

  <!--
    updateTitle：更新标题；更新语句。
    涉及数据表：sr_tutorial_group；关系条件与可见性筛选由下方 SQL 明确限定。
    执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
    绑定参数：title、updatedAt、id；参数含义参见 Mapper 方法注释。
  -->
  <update id="updateTitle">
    UPDATE sr_tutorial_group SET title = #{title}, updated_at = #{updatedAt} WHERE id = #{id}
  </update>

  <!--
    updateStatus：更新状态；更新语句。
    涉及数据表：sr_tutorial_group；关系条件与可见性筛选由下方 SQL 明确限定。
    执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
    绑定参数：status、updatedAt、id；参数含义参见 Mapper 方法注释。
  -->
  <update id="updateStatus">
    UPDATE sr_tutorial_group SET status = #{status}, updated_at = #{updatedAt} WHERE id = #{id}
  </update>

  <!--
    updateSortOrder：更新排序顺序；更新语句。
    涉及数据表：sr_tutorial_group；关系条件与可见性筛选由下方 SQL 明确限定。
    执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
    绑定参数：sortOrder、updatedAt、id；参数含义参见 Mapper 方法注释。
  -->
  <update id="updateSortOrder">
    UPDATE sr_tutorial_group SET sort_order = #{sortOrder}, updated_at = #{updatedAt} WHERE id = #{id}
  </update>
  <!--
    deleteById：删除依据标识；删除语句。
    涉及数据表：sr_tutorial_group；关系条件与可见性筛选由下方 SQL 明确限定。
    执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
    绑定参数：id；参数含义参见 Mapper 方法注释。
  -->
  <delete id="deleteById">DELETE FROM sr_tutorial_group WHERE id = #{id}</delete>
</mapper>
