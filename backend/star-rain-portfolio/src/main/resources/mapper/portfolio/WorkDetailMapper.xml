<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.starrainnotes.portfolio.mapper.WorkDetailMapper">
    <!--
      WorkDetailMapper.xml：com.starrainnotes.portfolio.mapper.WorkDetailMapper 的 MyBatis SQL 映射。
      语句 id 对应 Mapper 接口方法；#{...} 使用预编译参数，字段别名及结果映射约定保持一致。
      读写行为由每条语句决定；需要锁的查询应由业务层开启事务并在同一连接内执行。
    -->


  <!--
    columns：投影列；可复用 SQL 片段。
    通过 include 引用，复用相同列或条件，避免列表与计数的过滤口径分散。
  -->
  <sql id="columns">
    id, work_id, work_type, detail_json, created_at, updated_at
  </sql>

  <!-- detail_json 为 JSON 列，由默认的 String 类型处理器按字符串写入与读回 -->
  <!--
    insert：新增；新增语句。
    涉及数据表：sr_portfolio_work_detail；关系条件与可见性筛选由下方 SQL 明确限定。
    输入对象：com.starrainnotes.portfolio.entity.WorkDetailEntity；占位符按其属性读取。
    执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
    插入成功后 JDBC 自动生成的主键回填到 id。
    绑定参数：workId、workType、detailJson；参数含义参见 Mapper 方法注释。
  -->
  <insert id="insert" parameterType="com.starrainnotes.portfolio.entity.WorkDetailEntity"
          useGeneratedKeys="true" keyProperty="id">
    INSERT INTO sr_portfolio_work_detail (work_id, work_type, detail_json)
    VALUES (#{workId}, #{workType}, #{detailJson})
  </insert>

  <!--
    selectByWorkId：查询依据作品标识；读取语句。
    涉及数据表：sr_portfolio_work_detail；关系条件与可见性筛选由下方 SQL 明确限定。
    结果类型或映射：com.starrainnotes.portfolio.entity.WorkDetailEntity；集合与单值形态由 Java 方法签名决定。
    复用片段：columns。
    绑定参数：workId；参数含义参见 Mapper 方法注释。
  -->
  <select id="selectByWorkId" resultType="com.starrainnotes.portfolio.entity.WorkDetailEntity">
    SELECT <include refid="columns"/> FROM sr_portfolio_work_detail WHERE work_id = #{workId}
  </select>

  <!--
    只改 detail_json：work_id 与 work_type 由 work detail 的唯一键与作品类型决定，更新路径不涉及。
    updated_at 写回服务层实体里读出来的值，与原先 updateById 的行为一致。
  -->
  <!--
    updateDetailJson：更新详情JSON；更新语句。
    涉及数据表：sr_portfolio_work_detail；关系条件与可见性筛选由下方 SQL 明确限定。
    输入对象：com.starrainnotes.portfolio.entity.WorkDetailEntity；占位符按其属性读取。
    执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
    绑定参数：detailJson、updatedAt、id；参数含义参见 Mapper 方法注释。
  -->
  <update id="updateDetailJson" parameterType="com.starrainnotes.portfolio.entity.WorkDetailEntity">
    UPDATE sr_portfolio_work_detail
    SET detail_json = #{detailJson},
        updated_at = #{updatedAt}
    WHERE id = #{id}
  </update>

  <!--
    deleteById：删除依据标识；删除语句。
    涉及数据表：sr_portfolio_work_detail；关系条件与可见性筛选由下方 SQL 明确限定。
    执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
    绑定参数：id；参数含义参见 Mapper 方法注释。
  -->
  <delete id="deleteById">
    DELETE FROM sr_portfolio_work_detail WHERE id = #{id}
  </delete>
</mapper>
