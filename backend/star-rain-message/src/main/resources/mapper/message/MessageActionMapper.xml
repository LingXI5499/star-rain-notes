<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.starrainnotes.message.mapper.MessageActionMapper">
    <!--
      MessageActionMapper.xml：com.starrainnotes.message.mapper.MessageActionMapper 的 MyBatis SQL 映射。
      语句 id 对应 Mapper 接口方法；#{...} 使用预编译参数，字段别名及结果映射约定保持一致。
      读写行为由每条语句决定；需要锁的查询应由业务层开启事务并在同一连接内执行。
    -->


  <!--
    insert：新增；新增语句。
    涉及数据表：sr_message_action；关系条件与可见性筛选由下方 SQL 明确限定。
    输入对象：com.starrainnotes.message.entity.MessageActionEntity；占位符按其属性读取。
    执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
    插入成功后 JDBC 自动生成的主键回填到 id。
    绑定参数：messageId、actionType、actorAccountId、actorType、note、createdAt；参数含义参见 Mapper 方法注释。
  -->
  <insert id="insert" parameterType="com.starrainnotes.message.entity.MessageActionEntity"
          useGeneratedKeys="true" keyProperty="id">
    INSERT INTO sr_message_action
      (message_id, action_type, actor_account_id, actor_type, note, created_at)
    VALUES
      (#{messageId}, #{actionType}, #{actorAccountId}, #{actorType}, #{note}, #{createdAt})
  </insert>

  <!--
    listByMessage：list依据留言；读取语句。
    涉及数据表：sr_message_action；关系条件与可见性筛选由下方 SQL 明确限定。
    结果类型或映射：com.starrainnotes.message.entity.MessageActionEntity；集合与单值形态由 Java 方法签名决定。
    绑定参数：messageId；参数含义参见 Mapper 方法注释。
  -->
  <select id="listByMessage" resultType="com.starrainnotes.message.entity.MessageActionEntity">
    SELECT id, message_id, action_type, actor_account_id, actor_type, note, created_at
    FROM sr_message_action
    WHERE message_id = #{messageId}
    ORDER BY created_at ASC, id ASC
  </select>
</mapper>
