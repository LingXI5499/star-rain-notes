# Optional: use only if this deployment is managed by systemd, not simultaneously by BaoTa Java.
[Unit]
Description=Star Rain Notes
After=network.target

[Service]
Type=simple
User=star-rain
Group=star-rain
WorkingDirectory=/srv/star-rain/current/backend
ExecStart=/usr/bin/java -Xms128m -Xmx384m -jar /srv/star-rain/current/backend/star-rain-boot-2.0.1.jar --spring.config.import=file:/etc/star-rain/application-local-secret.yml
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
