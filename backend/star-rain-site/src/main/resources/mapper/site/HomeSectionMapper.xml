<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.starrainnotes.site.mapper.HomeSectionMapper">
    <!--
      HomeSectionMapper.xml：com.starrainnotes.site.mapper.HomeSectionMapper 的 MyBatis SQL 映射。
      语句 id 对应 Mapper 接口方法；#{...} 使用预编译参数，字段别名及结果映射约定保持一致。
      读写行为由每条语句决定；需要锁的查询应由业务层开启事务并在同一连接内执行。
    -->

    <!--
      all：全部；读取语句。
      涉及数据表：sr_site_home_section；关系条件与可见性筛选由下方 SQL 明确限定。
      结果类型或映射：com.starrainnotes.site.entity.HomeSectionEntity；集合与单值形态由 Java 方法签名决定。
    -->
    <select id="all" resultType="com.starrainnotes.site.entity.HomeSectionEntity">
        SELECT id, section_code, display_name, enabled, sort_order, config_json,
               created_at, updated_at
        FROM sr_site_home_section
        ORDER BY sort_order, id
    </select>

    <!--
      byCode：依据代码；读取语句。
      涉及数据表：sr_site_home_section；关系条件与可见性筛选由下方 SQL 明确限定。
      结果类型或映射：com.starrainnotes.site.entity.HomeSectionEntity；集合与单值形态由 Java 方法签名决定。
      绑定参数：code；参数含义参见 Mapper 方法注释。
    -->
    <select id="byCode" resultType="com.starrainnotes.site.entity.HomeSectionEntity">
        SELECT id, section_code, display_name, enabled, sort_order, config_json,
               created_at, updated_at
        FROM sr_site_home_section
        WHERE section_code = #{code}
    </select>

    <!--
      update：更新；更新语句。
      涉及数据表：sr_site_home_section；关系条件与可见性筛选由下方 SQL 明确限定。
      执行结果通常为受影响行数；状态、版本或条件不匹配时需由调用方检查结果。
      绑定参数：displayName、enabled、sortOrder、configJson、updatedAt、id；参数含义参见 Mapper 方法注释。
    -->
    <update id="update">
        UPDATE sr_site_home_section
        SET display_name = #{displayName}, enabled = #{enabled}, sort_order = #{sortOrder},
            config_json = #{configJson}, updated_at = #{updatedAt}
        WHERE id = #{id}
    </update>
</mapper>
