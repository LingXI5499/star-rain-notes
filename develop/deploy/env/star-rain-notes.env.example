# Star Rain Notes V1 — production environment template (NO SECRETS!)
#
# Copy to the server as /etc/star-rain-notes/star-rain-notes.env, then:
#   sudo chown root:starrain /etc/star-rain-notes/star-rain-notes.env
#   sudo chmod 640 /etc/star-rain-notes/star-rain-notes.env
# and fill in the real values. This file is read by systemd
# (EnvironmentFile=). Never commit this file or its real values.
#
# DB password, SMTP authorization code and TLS
# private keys must never enter Git. The nginx .key and .pem are excluded by
# the repository .gitignore.

# Active Spring profile — prod defaults live in application-prod.yml
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=24680
SERVER_ADDRESS=127.0.0.1

# --- MySQL (dedicated user, not root) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=star_rain_notes
MYSQL_USER=star_rain
# MYSQL_PASSWORD=CHANGE_ME          # generate: openssl rand -base64 24

# Small connection pool for a 2-core / 2GB ECS. Increase only after measuring.
DB_POOL_MAX_SIZE=4
DB_POOL_MIN_IDLE=1

# --- Account and real 163 email ---
# This is the only super administrator identity. First activation is performed
# at https://your-domain/admin/activate using a verification code sent here.
# APP_SUPER_ADMIN_EMAIL=owner@example.com
# MAIL_HOST=smtp.163.com
# MAIL_PORT=465
# MAIL_USERNAME=sender@163.com
# MAIL_AUTH_CODE=CHANGE_ME              # 163 SMTP authorization code, not the mailbox password
# MAIL_FROM=sender@163.com
# MAIL_SSL_ENABLED=true
# MAIL_BASE_URL=https://your-domain.com # no trailing slash; used in invitation links

# --- Two-core resource bounds ---
TOMCAT_MAX_THREADS=32
TOMCAT_MIN_SPARE_THREADS=4
TOMCAT_MAX_CONNECTIONS=200
TOMCAT_ACCEPT_COUNT=50
TOMCAT_CONNECTION_TIMEOUT=10s

# --- Media ---
# Absolute media directory; must be non-executable (06 §8). Nginx serves it.
MEDIA_STORAGE_DIR=/srv/star-rain-notes/uploads

# --- Session cookie ---
# Production is HTTPS, so the cookie must be Secure.
SESSION_COOKIE_SECURE=true

# --- JVM ---
# (optional; can also be set in the systemd unit)
# JAVA_TOOL_OPTIONS=-Xms256m -Xmx512m
