# Star Rain Notes V1 — production environment template (NO SECRETS!)
#
# Copy to the server as /etc/star-rain-notes/star-rain-notes.env, then:
#   sudo chown root:starrain /etc/star-rain-notes/star-rain-notes.env
#   sudo chmod 600 /etc/star-rain-notes/star-rain-notes.env
# and fill in the real values. This file is read by systemd
# (EnvironmentFile=). Never commit this file or its real values.
#
# 06-testing-deployment.md §9: DB password, APP_SETUP_TOKEN, API keys and TLS
# private keys must never enter Git. The nginx .key and .pem are excluded by
# the repository .gitignore.

# Active Spring profile — prod defaults live in application-prod.yml
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=24680

# --- MySQL (dedicated user, not root) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=star_rain_notes
MYSQL_USER=star_rain
# MYSQL_PASSWORD=CHANGE_ME          # generate: openssl rand -base64 24

# --- First-time setup token (06 §10) ---
# Generate: openssl rand -hex 32
# 1) set it here, 2) start the app, 3) open /admin/setup and create the admin,
# 4) remove this line and restart (setup is then disabled).
# APP_SETUP_TOKEN=CHANGE_ME

# --- Media ---
# Absolute media directory; must be non-executable (06 §8). Nginx serves it.
MEDIA_STORAGE_DIR=/srv/star-rain-notes/uploads

# --- Session cookie ---
# Production is HTTPS, so the cookie must be Secure.
SESSION_COOKIE_SECURE=true

# --- JVM ---
# (optional; can also be set in the systemd unit)
# JAVA_TOOL_OPTIONS=-Xms256m -Xmx512m
