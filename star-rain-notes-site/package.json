{
  "name": "star-rain-notes-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "validate": "node scripts/sync-catalog.mjs && node scripts/validate-content.mjs",
    "check": "astro check",
    "build": "npm run validate && astro check && astro build && node scripts/verify-build.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "import:public": "node scripts/import-public.mjs",
    "package": "node scripts/package.mjs",
    "predev": "node scripts/sync-catalog.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/vue": "7.1.1",
    "@mdit/plugin-katex": "1.1.3",
    "astro": "7.4.1",
    "cheerio": "1.2.0",
    "fuse.js": "7.5.0",
    "katex": "0.19.0",
    "markdown-it": "15.0.3",
    "sanitize-html": "2.18.1",
    "shiki": "4.5.0",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.5",
    "@types/sanitize-html": "2.16.2",
    "lighthouse": "13.5.0",
    "typescript": "6.0.3"
  }
}
