---
import { renderBody,type Course,type Chapter } from '../utils/content';
import OriginalReadingAside from '../components/astro/OriginalReadingAside.astro';
interface Props { course:Course;chapter:Chapter; }
const {course,chapter}=Astro.props;
const body=await renderBody(`tutorials/${course.slug}/chapters/${chapter.slug}.html`);
const chapters=course.groups.flatMap(g=>g.chapters),index=chapters.findIndex(c=>c.slug===chapter.slug),group=course.groups.find(g=>g.chapters.some(c=>c.slug===chapter.slug));
const previous=chapters[index-1],next=chapters[index+1],progress=Math.round((index+1)/chapters.length*100);
const charCount='wordCount' in chapter?Number(chapter.wordCount):body.text.replace(/\s/g,'').length;
const minutes=Math.max(1,Math.ceil(charCount/400));
---
<section class="page-container tutorial-reader"><aside class="tutorial-reader__sidebar" aria-label="课程目录"><a href={course.path} class="tutorial-reader__course">{course.title}</a><div class="tutorial-reader__progress"><span style={`width:${progress}%`}></span></div><p class="tutorial-reader__progress-label">课程目录位置 {index+1} / {chapters.length}</p><nav class="curriculum" data-reading-course aria-label="课程目录">{course.groups.map(item=><section class="curriculum__group"><div class="curriculum__group-head"><h3>{item.title}</h3><span>{item.chapters.length}</span></div><ol class="curriculum__chapters">{item.chapters.map((entry,i)=><li><a href={entry.path} class:list={['curriculum__chapter',{'curriculum__chapter--active':entry.slug===chapter.slug}]} aria-current={entry.slug===chapter.slug?'page':undefined}><span class="curriculum__index">{String(i+1).padStart(2,'0')}</span><span class="curriculum__title">{entry.title}</span></a></li>)}</ol></section>)}</nav></aside><article class="tutorial-reader__article" data-reading-content><nav class="tutorial-reader__breadcrumb" aria-label="面包屑"><a href="/tutorials/">教程</a> / <a href={course.path}>{course.title}</a> / {group?.title} / {chapter.title}</nav><header><p>DOCUMENTATION · {course.title}</p><h1>{chapter.title}</h1><small>字数 {charCount} · 预计阅读 {minutes} 分钟</small></header>{body.toc.length>0&&<details class="static-toc"><summary>本页导航</summary><nav>{body.toc.map(h=><a href={`#${h.id}`}>{h.title}</a>)}</nav></details>}<div class="blog-prose markdown-body" set:html={body.html}/>{!body.text.trim()&&<p class="notice">原站当前仅公开本章标题与摘要，尚未补充正文。</p>}<nav class="tutorial-reader__prevnext" aria-label="章节导航">{previous?<a href={previous.path}><small>上一篇</small><strong>← {previous.title}</strong></a>:<span/>}{next&&<a href={next.path}><small>下一篇</small><strong>{next.title} →</strong></a>}</nav></article><OriginalReadingAside class="tutorial-reader__outline" items={body.toc} charCount={charCount} minutes={minutes} extra={[{label:'阅读进度',value:`${progress}%`},{label:'所属教程',value:course.title}]}/></section>
<script>
const sidebar=document.querySelector<HTMLElement>('.tutorial-reader__sidebar');const active=sidebar?.querySelector<HTMLElement>('[aria-current="page"]');if(sidebar&&active){const top=active.getBoundingClientRect().top-sidebar.getBoundingClientRect().top+sidebar.scrollTop-sidebar.clientHeight/2+active.clientHeight/2;sidebar.scrollTop=Math.max(0,top)}
const links=[...document.querySelectorAll<HTMLAnchorElement>('.article-outline a[href^="#"]')];if('IntersectionObserver'in window){const observer=new IntersectionObserver(entries=>{for(const entry of entries)if(entry.isIntersecting)links.forEach(a=>{const active=a.hash===`#${entry.target.id}`;a.closest('li')?.classList.toggle('is-active',active);a.classList.toggle('is-active',active)})},{rootMargin:'-100px 0px -65% 0px'});links.forEach(a=>{const section=document.getElementById(decodeURIComponent(a.hash.slice(1)));if(section)observer.observe(section)})}
</script>
