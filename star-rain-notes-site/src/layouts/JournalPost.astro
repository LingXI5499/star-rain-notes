---
import type {RenderedBody} from '../utils/content';
import OriginalReadingAside from '../components/astro/OriginalReadingAside.astro';
interface Link {title:string;path:string;}
interface Props {
  title:string; description:string; body:RenderedBody; publishedAt:string; updatedAt?:string|null;
  tags:{name:string;path:string}[]; topics?:{name:string;path:string}[];
  charCount:number; minutes:number; previous?:Link; next?:Link;
  returnPath:string; returnLabel:string; locale?:'zh'|'en'; language?:string;
  extra?:{label:string;value:string}[]; source?:{title:string;url?:string}|null;
  translation?:RenderedBody;
}
const {title,description,body,publishedAt,updatedAt,tags,topics=[],charCount,minutes,previous,next,returnPath,returnLabel,locale='zh',language,extra=[],source,translation}=Astro.props;
const en=locale==='en';
const date=(d:string)=>en?new Intl.DateTimeFormat('en',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'}).format(new Date(d)):`${d.slice(0,4)}年${Number(d.slice(5,7))}月${Number(d.slice(8,10))}日`;
const html=en?body.html.replaceAll('aria-label="复制代码">复制</button>','aria-label="Copy code">Copy</button>'):body.html;
const translationHTML=translation?.html.replace(/id="([^"]+)"/g,'id="translation-$1"').replace(/href="#([^"]+)"/g,'href="#translation-$1"');
---
<section class:list={['article-page',{'essay-article':en}]} lang={en?'en':undefined}>
  <div class="reading-progress" aria-hidden="true"><span data-reading-progress></span></div>
  <article class="article page-container"><div class="article__reading reading-layout">
    <OriginalReadingAside class="article__toc reading-layout__sidebar" curriculum items={body.toc} charCount={charCount} minutes={minutes} locale={locale} extra={extra}/>
    <div class="article__body" data-reading-content>
      <header class="article-hero">
        <nav aria-label={en?'Breadcrumb':undefined}><a href={returnPath}>{returnLabel}</a><span aria-hidden="true">/</span><span>{en?'Essay':'文章详情'}</span></nav>
        {tags.length>0&&<div class="article-hero__tags">{tags.map(tag=><a href={tag.path}># {tag.name}</a>)}</div>}
        {topics.length>0&&<div class="article-hero__topics"><span>{en?'Topics':'专题'}</span>{topics.map(topic=><a href={topic.path}>{topic.name}</a>)}</div>}
        <h1>{title}</h1><p class="article-hero__summary">{description}</p>
        <div class="article-hero__meta"><span>{en?'Published':'发布于'} <time datetime={publishedAt}>{date(publishedAt)}</time></span><span>{en?`${charCount.toLocaleString('en')} words · ${minutes} min read`:`字数 ${charCount} · 预计阅读 ${minutes} 分钟`}</span>{updatedAt&&updatedAt!==publishedAt&&<span>{en?'Updated':'更新于'} <time datetime={updatedAt}>{date(updatedAt)}</time></span>}</div>
        {source&&<p class="english-source">{en?'Source':'来源'}: {source.url?<a href={source.url} target="_blank" rel="noopener noreferrer">{source.title}</a>:source.title}</p>}
      </header>
      {body.toc.length>0&&<details class="static-toc"><summary>{en?'Contents':'本页导航'}</summary><nav aria-label={en?'Table of contents':'文章目录'}>{body.toc.map(h=><a href={`#${h.id}`}>{h.title}</a>)}</nav></details>}
      <div class="blog-prose markdown-body" lang={language} set:html={html}/>
      {translationHTML&&<details class="english-translation"><summary>Chinese translation</summary><div class="blog-prose markdown-body" lang="zh-CN" set:html={translationHTML}/></details>}
      <nav class="article__neighbors" aria-label={en?'Adjacent essays':'相邻文章'}>{previous?<a href={previous.path}><small>{en?'Previous essay':'上一篇'}</small><strong>← {previous.title}</strong></a>:<span/>}{next&&<a class="article__neighbors-next" href={next.path}><small>{en?'Next essay':'下一篇'}</small><strong>{next.title} →</strong></a>}</nav>
      <p class="article__back"><a href={returnPath}>← {en?'Back to essays':'返回博客时间线'}</a></p>
    </div>
  </div></article>
</section>
<script>
  const bar=document.querySelector<HTMLElement>('[data-reading-progress]');
  const progress=()=>{if(bar){const range=document.documentElement.scrollHeight-innerHeight;bar.style.width=`${range>0?Math.min(100,Math.max(0,scrollY/range*100)):100}%`}};
  window.addEventListener('scroll',progress,{passive:true});window.addEventListener('resize',progress);progress();
</script>
