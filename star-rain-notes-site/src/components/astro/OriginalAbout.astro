---
import {profile,catalog,readJSON,renderBody} from '../../utils/content';
import ThemeHero from './ThemeHero.astro';
import CareerSnapshot from './OriginalCareer.astro';
import TechFlow from './OriginalTechFlow.astro';
interface Featured{contentType:'PORTFOLIO'|'TUTORIAL'|'BLOG';title:string;summary?:string;coverUrl?:string;url:string;}
const view=readJSON('profile-view.json') as {excerpt:string;locationText:string;featuredContents:Featured[]};
const focus=profile.skills.filter(s=>s.category==='DIRECTION').map(s=>s.name);
const items=view.featuredContents;
const tutorials=items.filter(i=>i.contentType==='TUTORIAL').slice(0,2);
const git=catalog.courses.find(c=>c.slug==='git');if(tutorials.length<2&&git&&!tutorials.some(t=>t.url===git.path))tutorials.push({contentType:'TUTORIAL',title:git.title,summary:git.description,url:git.path});
const featured=[...items.filter(i=>i.contentType==='PORTFOLIO'&&i.title==='星雨笔录').slice(0,1),...tutorials,...items.filter(i=>i.contentType==='BLOG').slice(0,2)];
const [direction,journey,story]=await Promise.all(['direction','journey','story'].map(s=>renderBody(`profile/${s}.html`)));
const sections=[{id:'work',label:'代表作品',visible:featured.length>0},{id:'direction',label:'技术地图',visible:!!direction.text.trim()},{id:'journey',label:'学习与实践',visible:!!journey.text.trim()},{id:'knowledge',label:'知识内容',visible:items.some(i=>i.contentType!=='PORTFOLIO')},{id:'story',label:'个人说明',visible:!!story.text.trim()},{id:'contact',label:'保持联系',visible:profile.socialLinks.length>0}].filter(s=>s.visible);
const labels={PORTFOLIO:{category:'精选项目',action:'查看项目复盘'},TUTORIAL:{category:'精选教程',action:'查看教程'},BLOG:{category:'精选博客',action:'阅读全文'}};
---
<section class="profile-page" data-reading-content><header class="profile-page__hero"><ThemeHero src="/brand/themes/about-hero.webp"/><div class="profile-page__identity"><div><p class="public-eyebrow">ABOUT · STAR RAIN NOTES</p><h1>{profile.displayName}</h1><h2>{profile.headline}</h2></div><p class="profile-page__excerpt">{view.excerpt}</p><p class="profile-page__tagline">A wider world, a brighter you.</p>{view.locationText&&<p class="profile-page__location">{view.locationText}</p>}<div class="profile-page__hero-actions">{profile.socialLinks.map(link=><a href={link.url} target={link.url.startsWith('mailto:')?undefined:'_blank'} rel="noopener noreferrer">{link.url.startsWith('mailto:')?'写邮件':link.label} <span aria-hidden="true">↗</span></a>)}</div></div></header><section class="profile-page__career"><CareerSnapshot headline={profile.headline} focus={focus.slice(0,3)} featured={featured[0]?.title} status="持续学习与构建中"/></section>{focus.length>0&&<section class="profile-page__techflow"><div><p class="public-eyebrow">CURRENT FOCUS</p><h2>此刻关注</h2></div><TechFlow items={focus}/></section>}<nav class="profile-page__nav" aria-label="关于页章节">{sections.map((item,index)=><a href={`#${item.id}`}><span>{String(index+1).padStart(2,'0')}</span>{item.label}</a>)}</nav>{featured.length>0&&<section id="work" class="profile-page__section"><header><div><p class="public-eyebrow">SELECTED WORK</p><h2 class="public-section-title">代表作品</h2></div><p>用真实项目说明我如何理解问题、组织工程并持续复盘。</p></header><div class="profile-page__work">{featured.map((item,index)=><a href={item.url} class:list={['profile-page__work-card','editorial-card','public-interactive',{'is-primary':index===0&&item.contentType==='PORTFOLIO','is-text':item.contentType!=='PORTFOLIO'}]}>{item.contentType==='PORTFOLIO'&&<div class="profile-page__work-visual">{item.coverUrl?<img src={item.coverUrl} alt={item.title} loading={index?'lazy':'eager'} width="1200" height="750"/>:<span aria-hidden="true">{item.title.slice(0,1)}</span>}<small>PORTFOLIO</small></div>}<article><small>{labels[item.contentType].category} · {String(index+1).padStart(2,'0')}</small><h3>{item.title}</h3>{item.summary&&<p class="profile-page__work-summary">{item.summary}</p>}<span>{labels[item.contentType].action} <i aria-hidden="true">→</i></span></article></a>)}</div></section>}<div class="profile-page__reading"><aside><p class="public-eyebrow">ON THIS PAGE</p>{sections.map(item=><a href={`#${item.id}`}>{item.label}</a>)}</aside><div>{direction.text.trim()&&<section id="direction" class="profile-page__section profile-page__prose-section"><header><div><p class="public-eyebrow">TECHNICAL MAP</p><h2 class="public-section-title">技术方向</h2></div><p>不是技能清单，而是正在建立的能力结构。</p></header><div class="blog-prose markdown-body" set:html={direction.html}/></section>}{journey.text.trim()&&<section id="journey" class="profile-page__section"><header><div><p class="public-eyebrow">JOURNEY</p><h2 class="public-section-title">学习与实践</h2></div><p>在理解、动手和复盘之间缓慢积累。</p></header><div class="blog-prose markdown-body profile-page__prose-section" set:html={journey.html}/></section>}{items.some(i=>i.contentType!=='PORTFOLIO')&&<section id="knowledge" class="profile-page__section"><header><div><p class="public-eyebrow">SELECTED KNOWLEDGE</p><h2 class="public-section-title">知识内容</h2></div><p>系统教程与阶段性思考，共同构成可以回看的学习坐标。</p></header><div class="profile-page__knowledge">{(['TUTORIAL','BLOG'] as const).map(type=><div><h3>{type==='TUTORIAL'?'系统教程':'思考记录'}</h3>{items.filter(i=>i.contentType===type).map(item=><a href={item.url}><span>{item.title}</span><i aria-hidden="true">→</i></a>)}</div>)}</div></section>}</div></div><section id="story" class="profile-page__story"><div><p class="public-eyebrow">PERSONAL NOTE</p><h2>关于学习、实践与这套笔录</h2></div><div class="blog-prose markdown-body" set:html={story.html}/></section><section id="contact" class="profile-page__contact"><p class="public-eyebrow">LET'S KEEP IN TOUCH</p><h2>如果你也在构建自己的知识世界，欢迎交流。</h2><div>{profile.socialLinks.map(link=><a href={link.url} target={link.url.startsWith('mailto:')?undefined:'_blank'} rel="noopener noreferrer"><span>{link.url.startsWith('mailto:')?'邮箱':'代码主页'}</span><b>{link.url.startsWith('mailto:')?link.url.slice(7):'查看公开项目'}</b><i aria-hidden="true">↗</i></a>)}</div></section><blockquote class="profile-page__note"><span>EDITORIAL PRINCIPLE</span><p>把复杂的知识梳理成路径，把每一次实践沉淀成可以再次抵达的坐标。</p></blockquote></section>
