---
import { catalog,readJSON } from '../../utils/content';
import OriginalPagination from './OriginalPagination.astro';
const categories=readJSON('categories.json') as {id:string;name:string;slug:string}[];
const chapterCount=catalog.courses.reduce((n,c)=>n+c.chapterCount,0);
const wordCount=catalog.courses.reduce((n,c)=>n+('wordCount'in c?Number(c.wordCount):0),0);
---
<section class="page-container tutorial-catalog" data-filter-scope data-static-pagination data-pagination-unit="门" data-pagination-size="12"><header class="tutorial-catalog__hero"><div><p class="tutorial-catalog__eyebrow">LEARNING PATHS · 教程中心</p><h1>选择一门教程，开始系统学习</h1><p>左侧按知识体系浏览，右侧从教程卡片进入；课程内提供完整目录、上下篇与页内导航。</p></div><div class="tutorial-catalog__summary"><strong>{catalog.courses.length}</strong><span>公开教程</span></div></header><div class="tutorial-catalog__layout"><aside class="tutorial-catalog__sidebar"><div class="tutorial-catalog__sidebar-head"><span>教程目录</span><small>{categories.length} 类</small></div><nav aria-label="教程分类"><button type="button" class="tutorial-catalog__all tutorial-catalog__all--active" data-filter="全部" aria-pressed="true"><span>全部教程</span><span class="tutorial-catalog__all-count">{catalog.courses.length}</span><span class="tutorial-catalog__all-arrow" aria-hidden="true">›</span></button><ul class="tutorial-catalog__category-tree">{categories.map(category=><li class="tutorial-catalog__category-item"><button type="button" class="tutorial-catalog__category" data-filter={category.name} data-category-slug={category.slug} aria-pressed="false"><span class="tutorial-catalog__category-name">{category.name}</span><span class="tutorial-catalog__category-count">{catalog.courses.filter(c=>c.category===category.name).length}</span><span class="tutorial-catalog__category-arrow" aria-hidden="true">›</span></button></li>)}</ul></nav><section class="tutorial-catalog__stats" aria-label="教程统计"><h3>教程统计</h3><dl><div><dt>教程</dt><dd>{catalog.courses.length} 门</dd></div><div><dt>公开章节</dt><dd>{chapterCount} 章</dd></div><div><dt>正文总字数</dt><dd>{wordCount.toLocaleString()} 字</dd></div></dl></section></aside><div class="tutorial-catalog__content"><div class="tutorial-catalog__content-head"><div><p class="tutorial-catalog__path">教程 / <span data-category-heading>全部教程</span></p><h2 data-category-heading>全部教程</h2><p>共 <span data-category-total>{catalog.courses.length}</span> 门可学习教程</p></div></div><div class="tutorial-catalog__grid" data-stagger>{catalog.courses.map((tutorial,index)=><a href={tutorial.path} class="tutorial-card" data-filter-item data-category={tutorial.category} hidden={index>=12}><div class="tutorial-card__body"><p class="tutorial-card__category">{tutorial.category}</p><h3>{tutorial.title}</h3><p class="tutorial-card__summary">{tutorial.description}</p><div class="tutorial-card__footer"><span class="tutorial-card__chapter-count"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5z"/><path d="M4 5.5v15M8 7h8M8 11h6"/></svg>{tutorial.chapterCount} 个章节</span><strong class="tutorial-card__cta">进入课程 <span aria-hidden="true">→</span></strong></div></div></a>)}</div><p class="tutorial-catalog__empty" data-filter-empty hidden>当前分类暂无匹配教程。</p><OriginalPagination total={catalog.courses.length} size={12} unit="门"/></div></div></section>
