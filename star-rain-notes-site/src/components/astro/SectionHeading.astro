---
interface Props { eyebrow: string; title: string; href?: string; link?: string; }
const { eyebrow, title, href, link = '浏览全部' } = Astro.props;
---
<header class="section-heading"><div><p class="public-eyebrow">{eyebrow}</p><h2 class="public-section-title">{title}</h2></div>{href && <a class="text-link" href={href}>{link} <span aria-hidden="true">→</span></a>}</header>
