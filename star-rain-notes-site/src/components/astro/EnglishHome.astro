---
import {vocabularyTaxonomy,worldTaxonomy,vocabularyEntries,grammar,worldArticles,essays,publishedArticles} from '../../utils/content';
import ThemeHero from './ThemeHero.astro';
const lessons=grammar.sections.flatMap(s=>s.lessons);
const directions=[
  {name:'词汇',en:'VOCABULARY',path:'/english/vocabulary/',icon:'Aa',description:`${vocabularyTaxonomy.categories.length} 个一级主题，${vocabularyTaxonomy.categories.flatMap(c=>c.topics).length} 个已识别二级主题。按主题探索单词、音标、词性与语境。`},
  {name:'语法',en:'GRAMMAR',path:'/english/grammar/',icon:'◇',description:`${grammar.sections.length} 章 ${lessons.length} 课，沿着既有课程，建立理解和表达的语法框架。`},
  {name:'世界',en:'WORLD',path:'/english/world/',icon:'◎',description:`${worldTaxonomy.categories.length} 个一级主题、${worldTaxonomy.categories.flatMap(c=>c.topics).length} 个知识主题。通过英语阅读科学、技术、社会和生活。已发布 ${publishedArticles(worldArticles).length} 篇文章。`},
  {name:'随笔',en:'ESSAYS',path:'/english/essays/',icon:'✎',description:`站长自己的英语与双语文章，记录经历、观察和思考。已发布 ${publishedArticles(essays).length} 篇随笔。`},
];
---
<div class="english-home"><header class="english-hero"><ThemeHero src="/brand/themes/english-hero.webp"/><div class="english-hero__copy"><p class="public-eyebrow">STAR RAIN NOTES · ENGLISH</p><h1>用英语连接更大的世界</h1><p class="english-hero__lead">积累词汇，理解语法，在阅读与表达中持续成长。</p><div class="english-hero__actions"><a class="is-primary" href="/english/vocabulary/">探索词汇地图 →</a><a href="/english/world/">走进世界 ↗</a></div><p class="english-hero__quote">Knowledge leaves a trail.</p><ul class="english-hero__traits" aria-label="英语模块">{directions.map(d=><li><a href={d.path}><strong>{d.name}</strong><span>{d.en}</span></a></li>)}</ul></div><aside class="english-hero__stage"><small>EXPLORE & EXPRESS</small><strong>阅读与成长</strong></aside></header><section class="english-overview"><div><p class="public-eyebrow">LANGUAGE & KNOWLEDGE</p><h2 class="public-section-title">从语言基础，到阅读与表达</h2><p>用主题组织词汇，用课程梳理语法，用文章理解世界和记录自己。</p></div><dl><div><dt>来源词条记录</dt><dd>{vocabularyEntries.length.toLocaleString()}</dd></div><div><dt>已识别词汇主题</dt><dd>{vocabularyTaxonomy.categories.flatMap(c=>c.topics).length}</dd></div><div><dt>语法课节</dt><dd>{lessons.length}</dd></div><div><dt>世界知识主题</dt><dd>{worldTaxonomy.categories.flatMap(c=>c.topics).length}</dd></div></dl></section><section class="english-section"><header><div><p class="public-eyebrow">EXPLORE ENGLISH</p><h2 class="public-section-title">四条路径，自由探索</h2></div></header><div class="direction-grid direction-grid--static">{directions.map(d=><a href={d.path} class="direction-card public-interactive"><div><span aria-hidden="true">{d.icon}</span><small>{d.en}</small></div><h3>{d.name}</h3><p>{d.description}</p><strong>进入{d.name} →</strong></a>)}</div></section></div>
