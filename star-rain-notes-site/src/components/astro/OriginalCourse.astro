---
import {type Course} from '../../utils/content';
interface Props {course:Course}
const {course}=Astro.props;
const chapters=course.groups.flatMap(g=>g.chapters);
const date=course.publishedAt?`${Number(course.publishedAt.slice(0,4))}/${Number(course.publishedAt.slice(5,7))}/${Number(course.publishedAt.slice(8,10))}`:'—';
---
<section class="page-container tutorial-detail"><div class="tutorial-detail__main"><nav class="tutorial-detail__breadcrumb" aria-label="面包屑"><a href="/tutorials/">教程</a> / <a href={`/tutorials/?categorySlug=${course.categorySlug}`}>{course.category}</a></nav><h1>{course.title}</h1><p class="tutorial-detail__summary">{course.description}</p><p class="tutorial-detail__meta">发布于 {date} · {chapters.length} 个公开章节</p>{chapters.length>0&&<a href={chapters[0].path} class="tutorial-detail__start">开始学习 →</a>}<h2>课程目录</h2>{course.groups.map(group=><div class="tutorial-detail__group"><h3>{group.title}</h3>{group.chapters.map((chapter,index)=><a href={chapter.path}><span>{index+1}</span>{chapter.title}<span>→</span></a>)}</div>)}{!chapters.length&&<p class="notice">原站已建立本课程目录，目前尚未发布章节。</p>}</div><aside class="tutorial-detail__aside"><h2>教程信息</h2><dl><dt>分类</dt><dd>{course.category}</dd><dt>公开章节</dt><dd>{chapters.length}</dd><dt>发布于</dt><dd>{date}</dd></dl>{chapters.length>0&&<a href={chapters[0].path}>开始学习 →</a>}</aside></section>
