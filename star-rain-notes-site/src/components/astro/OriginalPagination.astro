---
interface Props {total:number;size?:number;unit?:string;locale?:'zh'|'en';}
const {total,size=12,unit='条',locale='zh'}=Astro.props;
const en=locale==='en';
const unitLabel=en&&unit==='essays'&&total===1?'essay':unit;
const pageCount=Math.ceil(total/size),numbers=[...new Set([1,2,pageCount])].filter(n=>n>0&&n<=pageCount);
---
<nav class="public-pagination" data-page-locale={locale} aria-label={en?'Pagination':'内容分页'}><span class="public-pagination__total" data-page-range>{total?1:0}–{Math.min(size,total)} {en?'of':'/ 共'} {total.toLocaleString()} {unitLabel}</span><div class="public-pagination__pages"><button type="button" class="public-pagination__arrow" data-page-previous disabled aria-label={en?'Previous page':'上一页'}><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m12 5-5 5 5 5"/></svg></button>{numbers.map((n,index)=><>{index>0&&n-numbers[index-1]>1&&<span class="public-pagination__gap">…</span>}<button type="button" data-page-number={n} aria-label={en?`Page ${n}`:`第 ${n} 页`} aria-current={n===1?'page':undefined}>{n}</button></>)}<button type="button" class="public-pagination__arrow" data-page-next disabled={total<=size} aria-label={en?'Next page':'下一页'}><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m8 5 5 5-5 5"/></svg></button></div><div class="public-pagination__size"><span>{en?'Per page':'每页'}</span><select data-page-size aria-label={en?'Page size':'每页数量'}>{[size,...[12,24,48].filter(n=>n!==size)].map(n=><option value={n} selected={n===size}>{n}</option>)}</select></div></nav>
