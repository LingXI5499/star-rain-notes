---
interface Props{items:string[];}
const {items}=Astro.props;
const list=items.filter(Boolean),count=list.length>8?3:Math.min(2,list.length);
const rows=Array.from({length:count},(_,i)=>[...list.slice(i),...list.slice(0,i)]);
---
<div class="tech-flow" aria-label="当前关注点">{rows.map((row,index)=><div class:list={['tech-flow__row',{'tech-flow__row--reverse':index%2===1}]} style={`--speed:${24+index*7}s`}><ul class="tech-flow__track">{row.map(item=><li>{item}</li>)}</ul><ul class="tech-flow__track" aria-hidden="true">{row.map(item=><li>{item}</li>)}</ul></div>)}</div>
