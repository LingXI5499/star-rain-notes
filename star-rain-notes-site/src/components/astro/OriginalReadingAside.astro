---
interface Props {items:{id:string;title:string;depth:number}[];charCount:number;minutes:number;curriculum?:boolean;extra?:{label:string;value:string}[];class?:string;}
const {items,charCount,minutes,curriculum=false,extra=[],class:extraClass=''}=Astro.props;
const minimum=Math.min(...items.map(i=>i.depth));
const flat=items.every(i=>i.depth===minimum);
const groups:{heading:typeof items[number];children:typeof items}[]=[];
for(const item of items){if(item.depth===minimum||!groups.length)groups.push({heading:item,children:[]});else groups[groups.length-1].children.push(item)}
---
<aside class:list={['reading-aside',extraClass,{'reading-aside--curriculum':curriculum}]}>{items.length>0&&<div class="reading-aside__card"><p class="reading-aside__title">本页导航</p><nav class:list={['article-outline','article-outline--embedded',{'article-outline--curriculum':curriculum}]} aria-label="文章目录">{curriculum?(flat?<ol class="article-outline__chapters">{items.map((item,index)=><li><a class="article-outline__chapter" href={`#${item.id}`} title={item.title}><span class="article-outline__index">{String(index+1).padStart(2,'0')}</span><span class="article-outline__chapter-title">{item.title}</span></a></li>)}</ol>:<div class="article-outline__groups">{groups.map(group=><section class="article-outline__group"><a class="article-outline__group-title" href={`#${group.heading.id}`} title={group.heading.title}>{group.heading.title}</a>{group.children.length>0&&<ol class="article-outline__chapters">{group.children.map((item,index)=><li><a class="article-outline__chapter" href={`#${item.id}`} title={item.title}><span class="article-outline__index">{String(index+1).padStart(2,'0')}</span><span class="article-outline__chapter-title">{item.title}</span></a></li>)}</ol>}</section>)}</div>):<ul class="article-outline__list">{items.map(item=><li class:list={['article-outline__item',`article-outline__item--h${item.depth}`]}><a href={`#${item.id}`}>{item.title}</a></li>)}</ul>}</nav></div>}<div class="reading-aside__card"><p class="reading-aside__title">{curriculum?'阅读信息':'学习信息'}</p><dl class="reading-aside__info"><div><dt>字数</dt><dd>{charCount}</dd></div><div><dt>预计阅读</dt><dd>{minutes} 分钟</dd></div>{extra.map(row=><div><dt>{row.label}</dt><dd>{row.value}</dd></div>)}</dl></div></aside>
