---
import {themes,grammar,readJSON,renderBody} from '../../utils/content';
import ThemeHero from './ThemeHero.astro';
import OriginalPagination from './OriginalPagination.astro';
interface Props{kind:string;slug?:string;}
const {kind,slug}=Astro.props;
const layers=[...new Set(themes.map(t=>t.layer))];
const total=themes.reduce((n,t)=>n+t.wordCount,0);
interface Word{word:string;partOfSpeech:string;phoneticUs:string;phoneticUk:string;translation:string;sceneMeaning:string;}
const theme=kind==='theme'?readJSON(`english/vocabulary/${slug}.json`) as {title:string;layer:string;wordCount:number;words:Word[]}:undefined;
const lessons=grammar.sections.flatMap(s=>s.lessons),lesson=lessons.find(l=>l.slug===slug),lessonIndex=lessons.findIndex(l=>l.slug===slug);
const lessonBody=kind==='lesson'&&lesson?await renderBody(`english/grammar/${lesson.slug}/body.html`):undefined;
const steps=grammar.roadmapMarkdown.split('\n').map(s=>s.replace(/^\d+\.\s*/, '').trim()).filter(Boolean);
---
{kind==='english'&&<div class="english-home"><header class="english-hero"><ThemeHero src="/brand/themes/english-hero.webp"/><div class="english-hero__copy"><p class="public-eyebrow">STAR RAIN NOTES · ENGLISH</p><h1>英语能力成长路径</h1><p class="english-hero__lead">从单词和语法打好基础，持续积累语言知识。</p><div class="english-hero__actions"><a class="is-primary" href="/english/vocabulary/">浏览词库 <span aria-hidden="true">→</span></a><a href="/english/grammar/">语法教程 <span aria-hidden="true">↗</span></a></div><p class="english-hero__quote">Knowledge leaves a trail.</p><ul class="english-hero__traits" aria-label="英语学习方向"><li><a href="/english/vocabulary/"><strong>词汇</strong><span>VOCABULARY</span></a></li><li><a href="/english/grammar/"><strong>语法</strong><span>GRAMMAR</span></a></li></ul></div><aside class="english-hero__stage" aria-label="当前阶段"><small>CURRENT STAGE</small><strong>基础积累</strong></aside></header><section class="english-overview"><div><p class="public-eyebrow">WHY ENGLISH</p><h2 class="public-section-title">为什么学英语</h2><p>技术世界以英语为主，长期投资英语是职业与认知的复利。</p></div><dl><div><dt>词汇主题</dt><dd>{themes.length}</dd></div><div><dt>主题词汇</dt><dd>{total}</dd></div><div><dt>语法章节</dt><dd>{grammar.sections.length}</dd></div><div><dt>语法课节</dt><dd>{lessons.length}</dd></div></dl></section><section class="english-section"><header><div><p class="public-eyebrow">FOUNDATIONS</p><h2 class="public-section-title">从词汇与语法开始</h2></div></header><div class="direction-grid direction-grid--static"><a href="/english/vocabulary/" class="direction-card public-interactive" data-kind="vocabulary"><div><span>Aa</span><small>VOCABULARY</small></div><h3>词汇</h3><p>按主题分类浏览单词、音标与释义，建立自己的词汇地图。</p><strong>浏览词库 →</strong></a><a href="/english/grammar/" class="direction-card public-interactive" data-kind="grammar"><div><span>◇</span><small>GRAMMAR</small></div><h3>语法</h3><p>{grammar.summary}</p><strong>进入语法教程 →</strong></a></div></section><section class="vocab-gateway"><div><p class="public-eyebrow">VOCABULARY ATLAS</p><h2>让词汇回到主题与语境</h2><p>按生活场景与知识层次，浏览公开的英语词汇资料。</p><div><a href="/english/vocabulary/">浏览主题</a><a href="/english/grammar/">探索语法 →</a></div></div><span aria-hidden="true">Aa</span></section></div>}
{kind==='vocabulary'&&<section class="vocabulary-page" data-filter-scope data-static-pagination data-pagination-size="12" data-pagination-unit="个主题"><header class="vocabulary-page__hero"><p class="public-eyebrow">VOCABULARY · THEMED</p><h1>词汇</h1><p class="vocabulary-page__subtitle">按主题分类的英语词汇库 · {layers.length} 个分类组 / {total.toLocaleString()} 条分类词汇</p></header><section class="public-filters" aria-label="词类筛选"><div class="public-filters__row"><div class="public-filter-tabs" role="group" aria-label="词类筛选"><button type="button" data-filter="全部" aria-pressed="true">全部</button>{layers.map(layer=><button type="button" data-filter={layer} aria-pressed="false">{layer}</button>)}</div><div class="public-filters__summary"><span data-filter-status>{themes.length} 个主题</span></div></div></section>{layers.map(layer=><section class="vocabulary-page__group" data-filter-group><h2>{layer}</h2><div class="vocabulary-page__grid">{themes.filter(t=>t.layer===layer).map(t=><a href={t.path} class="vocabulary-page__card" data-filter-item data-category={t.layer}><span class="vocabulary-page__card-name">{t.title}</span><span class="vocabulary-page__card-count">{t.wordCount} 词</span></a>)}</div></section>)}<OriginalPagination total={themes.length} size={12} unit="个主题"/><p class="vocabulary-page__state" data-filter-empty hidden>词库暂无匹配主题。</p></section>}
{kind==='theme'&&theme&&<section class="theme-words" data-filter-scope data-static-pagination data-pagination-size="12" data-pagination-unit="词"><header class="theme-words__header"><div><a class="theme-words__back" href="/english/vocabulary/">← 词汇总览</a><p class="public-eyebrow">{theme.layer}</p><h1>{theme.title}</h1><p class="theme-words__intro">浏览主题词汇、音标和中文释义。</p></div></header><section class="theme-words__tools" aria-label="词汇搜索与筛选"><div class="theme-words__filters"><div class="public-search"><span class="public-search__label">搜索单词或释义</span><div class="public-search__field"><svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5"/><path d="m13 13 4 4"/></svg><input type="search" data-filter-query aria-label="搜索单词或释义" placeholder="搜索单词或中文释义…"/></div></div></div><div class="theme-words__toolbar"><div class="theme-words__display" role="group" aria-label="全部词卡显示"><span>显示</span><button type="button" class="is-active" data-word-display="all" aria-pressed="true">全部</button><button type="button" data-word-display="en" aria-pressed="false">英文</button><button type="button" data-word-display="zh" aria-pressed="false">中文</button></div></div></section><div class="theme-words__results"><span data-filter-status>{theme.wordCount} 个匹配词汇</span></div><div class="theme-words__grid">{theme.words.map(word=><article class="vocabulary-card" data-filter-item><div class="vocabulary-card__toolbar"><span class="vocabulary-card__status">主题词汇</span></div><section class="vocabulary-card__english" aria-label="英文信息"><div class="vocabulary-card__heading"><span class="vocabulary-card__pos">{word.partOfSpeech}</span><h2 lang="en">{word.word}</h2></div><p class="vocabulary-card__phonetics">{word.phoneticUk&&<span>英 {word.phoneticUk}</span>}{word.phoneticUs&&<span>美 {word.phoneticUs}</span>}</p></section><section class="vocabulary-card__chinese" aria-label="中文信息"><p class="vocabulary-card__translation">{word.translation}</p>{word.sceneMeaning&&word.sceneMeaning!==word.translation&&<p class="vocabulary-card__scene"><span>本主题用法</span>{word.sceneMeaning}</p>}</section></article>)}</div><OriginalPagination total={theme.wordCount} size={12} unit="词"/><p class="theme-words__empty" data-filter-empty hidden>没有符合条件的词汇。</p></section>}
{kind==='grammar'&&<section class="grammar-page"><header class="grammar-page__hero"><div><p class="public-eyebrow">ENGLISH GRAMMAR · SYSTEMATIC COURSE</p><h1>{grammar.title}</h1><h2>{grammar.subtitle}</h2><p>{grammar.summary}</p><a href={lessons[0].path}>从第一课开始 →</a></div><div class="grammar-page__count"><strong>{lessons.length}</strong><span>课节</span><small>{grammar.sections.length} CHAPTERS</small></div></header><section class="grammar-page__intro"><div><p class="public-eyebrow">COURSE PURPOSE</p><h2>建立能用于分析与表达的语法框架</h2></div><p>{grammar.introduction}</p></section><section class="grammar-page__roadmap"><p class="public-eyebrow">LEARNING PATH</p><h2>九阶段学习路线</h2><ol>{steps.map((step,index)=><li><b>{String(index+1).padStart(2,'0')}</b>{step}</li>)}</ol></section><section class="grammar-page__curriculum"><header><div><p class="public-eyebrow">CURRICULUM</p><h2>完整课程目录</h2></div><span>{grammar.sections.length} 章 · {lessons.length} 课</span></header><div class="grammar-page__sections">{grammar.sections.map((section,index)=><article><h3><span>{String(index+1).padStart(2,'0')}</span>{section.title}</h3><p>{section.lessons.length} 个课节</p><ol>{section.lessons.map(l=><li><a href={l.path}><span>{l.slug}</span><strong>{l.title}</strong><span>→</span></a></li>)}</ol></article>)}</div></section></section>}
{kind==='lesson'&&lesson&&lessonBody&&<section class="grammar-lesson"><div class="grammar-lesson__layout"><aside class="grammar-lesson__course" data-reading-course><a href="/english/grammar/" class="grammar-lesson__course-title">{grammar.title}</a><p>第 {lessonIndex+1} / {lessons.length} 课</p>{grammar.sections.map(section=><section><h2>{section.title}</h2>{section.lessons.map(item=><a href={item.path} class:list={{active:item.slug===lesson.slug}} aria-current={item.slug===lesson.slug?'page':undefined}><span>{item.slug}</span>{item.title}</a>)}</section>)}</aside><article data-reading-content><nav class="grammar-lesson__crumb"><a href="/english/">英语</a><span>/</span><a href="/english/grammar/">语法教程</a><span>/</span>{lesson.section}</nav><header><p class="public-eyebrow">GRAMMAR LESSON · {lesson.slug}</p><h1>{lesson.title}</h1><p>{lesson.description}</p><small>{lesson.section} · 第 {lessonIndex+1} / {lessons.length} 课</small></header><div class="blog-prose markdown-body" set:html={lessonBody.html}/><nav class="grammar-lesson__prev-next">{lessons[lessonIndex-1]?<a href={lessons[lessonIndex-1].path}><small>上一篇</small><strong>← {lessons[lessonIndex-1].title}</strong></a>:<span/>}{lessons[lessonIndex+1]&&<a href={lessons[lessonIndex+1].path}><small>下一篇</small><strong>{lessons[lessonIndex+1].title} →</strong></a>}</nav></article><aside class="grammar-lesson__aside"><p>当前章节</p><strong>{lesson.section}</strong><a href="/english/grammar/">查看完整路线 →</a></aside></div></section>}
<script>const displays=[...document.querySelectorAll<HTMLButtonElement>('[data-word-display]')];displays.forEach(button=>button.addEventListener('click',()=>{displays.forEach(b=>{b.classList.toggle('is-active',b===button);b.setAttribute('aria-pressed',String(b===button))});document.querySelectorAll<HTMLElement>('.vocabulary-card__english').forEach(el=>el.hidden=button.dataset.wordDisplay==='zh');document.querySelectorAll<HTMLElement>('.vocabulary-card__chinese').forEach(el=>el.hidden=button.dataset.wordDisplay==='en')}));</script>
