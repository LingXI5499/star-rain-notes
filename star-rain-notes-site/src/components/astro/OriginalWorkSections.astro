---
import {readJSON,prepareBody} from '../../utils/content';
interface Item{title?:string;description?:string;name?:string;group?:string;value?:string;label?:string;url?:string;date?:string;}
interface Block{id:string;title:string;type:string;html:string;data:{items?:Item[];author?:string};media:{src:string;caption:string}[];}
interface Props{slug:string;}
const {slug}=Astro.props;
const blocks=readJSON(`portfolio/${slug}/sections.json`) as Block[];
const prepared=await Promise.all(blocks.map(async block=>({...block,body:await prepareBody(block.html)})));
---
<div class="work-sections">{prepared.map(block=><section id={`work-section-${block.id}`} class="work-block">{block.title&&<h2>{block.title}</h2>}{['MARKDOWN','CUSTOM','CODE'].includes(block.type)&&<div class="blog-prose markdown-body" set:html={block.body.html}/>} {block.type==='FEATURE_LIST'&&<div class="work-block__grid">{block.data.items?.map(item=><article class="work-block__tile"><h3>{item.title}</h3><p>{item.description}</p></article>)}</div>}{block.type==='TECH_STACK'&&<div class="work-block__tech">{block.data.items?.map(item=><span>{item.name}{item.group&&<small>{item.group}</small>}</span>)}</div>}{block.type==='STATS'&&<div class="work-block__grid">{block.data.items?.map(item=><div class="work-block__tile work-block__stat"><strong>{item.value}</strong><span>{item.label}</span></div>)}</div>}{block.type==='LINKS'&&<div class="work-block__grid work-block__links">{block.data.items?.map(item=><article class="work-block__tile">{item.url&&/^https?:/.test(item.url)&&<a href={item.url} target="_blank" rel="noopener noreferrer">{item.label} ↗</a>}<p>{item.description}</p></article>)}</div>}{block.type==='TIMELINE'&&<ol class="work-block__timeline">{block.data.items?.map(item=><li><time>{item.date}</time><h3>{item.title}</h3><p>{item.description}</p></li>)}</ol>}{block.type==='QUOTE'&&<blockquote><div set:html={block.body.html}/>{block.data.author&&<cite>— {block.data.author}</cite>}</blockquote>}{['IMAGE','GALLERY'].includes(block.type)&&<div class:list={{'work-block__gallery':block.type==='GALLERY'}}>{block.media.map(media=><figure><img src={media.src} alt={media.caption||block.title} width="1200" height="750" loading="lazy"/>{media.caption&&<figcaption>{media.caption}</figcaption>}</figure>)}</div>}</section>)}</div>
