---
const primary=[{label:'首页',icon:'⌂',href:'/'},{label:'教程',icon:'▤',href:'/tutorials/'},{label:'博客',icon:'✎',href:'/blog/'},{label:'英语',icon:'Aa',href:'/english/'}];
---
<nav class="mobile-public-nav" aria-label="移动端主导航">{primary.map(item=><button type="button" class:list={{'is-active':item.href==='/'?Astro.url.pathname==='/':Astro.url.pathname.startsWith(item.href)}} data-mobile-href={item.href} aria-current={item.href==='/'?Astro.url.pathname==='/':Astro.url.pathname.startsWith(item.href)?'page':undefined}><span aria-hidden="true">{item.icon}</span><small>{item.label}</small></button>)}<button id="mobile-more" type="button" aria-expanded="false" aria-controls="mobile-navigation-sheet"><span aria-hidden="true">•••</span><small>更多</small></button></nav><div id="mobile-overlay" class="mobile-navigation-overlay" hidden><section id="mobile-navigation-sheet" class="mobile-navigation-sheet" role="dialog" aria-modal="true" aria-label="更多页面"><header><strong>更多</strong><button id="mobile-close" type="button" aria-label="关闭导航">×</button></header><nav aria-label="更多页面"><a href="/portfolio/"><span><strong>作品</strong><small>用真实项目验证学习</small></span><span>→</span></a><a href="/about/"><span><strong>关于</strong><small>了解作者与知识系统</small></span><span>→</span></a><a href="/search/"><strong>全站搜索</strong><span>→</span></a></nav></section></div>
<script>document.querySelectorAll<HTMLButtonElement>('[data-mobile-href]').forEach(b=>b.addEventListener('click',()=>location.href=b.dataset.mobileHref!));const overlay=document.querySelector<HTMLElement>('#mobile-overlay')!,more=document.querySelector<HTMLButtonElement>('#mobile-more')!;function close(){overlay.hidden=true;more.setAttribute('aria-expanded','false')}more.addEventListener('click',()=>{overlay.hidden=!overlay.hidden;more.setAttribute('aria-expanded',String(!overlay.hidden));if(!overlay.hidden)document.querySelector<HTMLButtonElement>('#mobile-close')?.focus()});document.querySelector('#mobile-close')?.addEventListener('click',close);overlay.addEventListener('click',e=>{if(e.target===overlay)close()});document.addEventListener('keydown',e=>{if(e.key==='Escape')close()});</script>
