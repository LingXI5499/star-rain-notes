---
import { site, profile } from '../../utils/content';
const nav=[{label:'教程',href:'/tutorials/'},{label:'博客',href:'/blog/'},{label:'作品',href:'/portfolio/'},{label:'英语',href:'/english/'},{label:'关于',href:'/about/'}];
---
<footer class="site-footer"><div class="site-footer__inner"><section class="site-footer__lead" aria-labelledby="footer-brand"><div class="site-footer__brand"><img class="site-footer__mark" src="/brand/mark.svg" alt="" aria-hidden="true" width="42" height="42"/><div><p id="footer-brand" class="site-footer__name">{site.name}</p><p class="site-footer__tagline">Knowledge · Code · Growth</p></div></div><p class="site-footer__statement">在知识、代码与成长之间，留下可以回看的坐标。</p></section><section class="site-footer__links"><div><p class="site-footer__label">EXPLORE</p><nav class="site-footer__nav" aria-label="页脚导航">{nav.map(item=><a href={item.href} class="site-footer__link">{item.label}</a>)}</nav></div><div><p class="site-footer__label">CONNECT</p><nav class="site-footer__connect" aria-label="作者公开链接">{profile.socialLinks.map(link=><a class="site-footer__link" href={link.url} target={link.url.startsWith('mailto:')?undefined:'_blank'} rel="noopener noreferrer">{link.label} <span aria-hidden="true">↗</span></a>)}</nav></div></section><div class="site-footer__legal"><p>© {new Date().getUTCFullYear()} {site.name} · Built with Astro &amp; Vue</p><nav class="site-footer__policies" aria-label="协议与政策"><a href="/terms/">用户协议</a><a href="/privacy/">隐私政策</a></nav><button type="button" aria-label="返回页面顶部" data-scroll-top>返回顶部 <span aria-hidden="true">↑</span></button></div><div class="site-footer__icp" aria-label="网站域名"><span>© {new Date().getUTCFullYear()} {site.name} · yulanlin.cn</span></div></div></footer>
<script>const scrollButton=document.querySelector('[data-scroll-top]');scrollButton?.setAttribute('aria-label','返回顶部');scrollButton?.addEventListener('click',()=>scrollTo({top:0,behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'}));</script>
