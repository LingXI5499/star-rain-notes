---
import { site } from '../../utils/content';
const nav = [{ label: '教程', href: '/tutorials/' }, { label: '博客', href: '/blog/' }, { label: '作品', href: '/portfolio/' }, { label: '英语', href: '/english/' }, { label: '关于', href: '/about/' }];
---
<header class="site-header"><div class="site-header__inner">
  <a href="/" class="site-header__brand"><img class="site-header__logo" src="/brand/mark.svg" alt="" aria-hidden="true" width="26" height="26"/><span>{site.name}</span></a>
  <nav class="site-header__nav" aria-label="主导航">{nav.map(item => <a href={item.href} class:list={['site-header__link', { 'site-header__link--active': Astro.url.pathname.startsWith(item.href) }]} aria-current={Astro.url.pathname.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>)}</nav>
  <div class="site-header__actions">
    <div class="search-launcher">
      <form id="header-search-form" class="search-launcher__trigger" role="search" aria-label="全站搜索" action="/search/" method="get">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.6-3.6"/></svg>
        <input id="header-search-input" class="search-launcher__input" name="q" type="search" placeholder="搜索知识…" aria-label="全站搜索" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="header-search-hits" autocomplete="off" maxlength="100"/>
        <kbd class="search-launcher__kbd" aria-hidden="true">Ctrl K</kbd>
      </form>
      <div id="header-search-panel" class="search-launcher__panel" hidden>
        <p id="header-search-status" class="search-launcher__pending-text" role="status" aria-live="polite">输入关键词，搜索教程、博客、作品与英语内容。</p>
        <ul id="header-search-hits" class="search-launcher__links" role="listbox" aria-label="搜索建议"></ul>
        <a id="header-search-all" class="search-launcher__all" href="/search/" hidden>查看全部结果 →</a>
      </div>
    </div>
    <button id="theme-toggle" class="theme-control" type="button" data-theme-toggle data-theme-icon="light" aria-label="切换到夜间模式" title="切换到夜间模式" aria-pressed="false"><svg class="theme-control__moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg><svg class="theme-control__sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></button>
  </div>
</div></header>
<script>
import { loadSearchEngine } from '../../utils/site-search';
const launcher = document.querySelector<HTMLElement>('.search-launcher')!;
const form = launcher.querySelector<HTMLFormElement>('#header-search-form')!;
const panel = launcher.querySelector<HTMLElement>('#header-search-panel')!;
const input = launcher.querySelector<HTMLInputElement>('#header-search-input')!;
const status = launcher.querySelector<HTMLElement>('#header-search-status')!;
const hits = launcher.querySelector<HTMLElement>('#header-search-hits')!;
const all = launcher.querySelector<HTMLAnchorElement>('#header-search-all')!;
let timer: ReturnType<typeof setTimeout>, generation = 0, active = -1;
function open() { panel.hidden = false; input.setAttribute('aria-expanded', 'true'); }
function close() { panel.hidden = true; input.setAttribute('aria-expanded', 'false'); input.removeAttribute('aria-activedescendant'); }
function activate(index: number) {
  const links = [...hits.querySelectorAll<HTMLAnchorElement>('a')];
  active = index;
  links.forEach((a, i) => { a.classList.toggle('is-active', i === index); a.setAttribute('aria-selected', String(i === index)); });
  if (links[index]) { input.setAttribute('aria-activedescendant', links[index].id); links[index].scrollIntoView({ block: 'nearest' }); }
  else input.removeAttribute('aria-activedescendant');
}
async function search() {
  const current = ++generation, query = input.value.trim();
  active = -1; input.removeAttribute('aria-activedescendant'); hits.replaceChildren();
  all.hidden = !query; all.href = '/search/?q=' + encodeURIComponent(query);
  if (!query) { status.textContent = '输入关键词，搜索教程、博客、作品与英语内容。'; return; }
  status.textContent = '正在搜索…';
  try {
    const engine = await loadSearchEngine();
    if (current !== generation) return;
    const found = engine.search(query, { limit: 6 });
    status.textContent = found.length ? '相关内容' : '没有找到相关内容，试试其他关键词。';
    found.forEach(({ item }, index) => {
      const li = document.createElement('li'), a = document.createElement('a'), title = document.createElement('strong'), type = document.createElement('small');
      li.setAttribute('role', 'presentation'); a.href = item.path; a.id = `header-search-option-${index}`; a.setAttribute('role', 'option'); a.setAttribute('aria-selected', 'false'); a.tabIndex = -1;
      title.textContent = item.title; type.textContent = item.type; a.append(type, title); li.append(a); hits.append(li);
    });
  } catch { if (current === generation) status.textContent = '搜索暂不可用，请按回车打开搜索页重试。'; }
}
input.addEventListener('focus', () => { open(); void search(); });
input.addEventListener('input', () => { clearTimeout(timer); generation++; open(); timer = setTimeout(search, 160); });
input.addEventListener('keydown', event => {
  if (event.key === 'Escape') { event.preventDefault(); close(); return; }
  const links = [...hits.querySelectorAll<HTMLAnchorElement>('a')];
  if (event.key === 'ArrowDown' || event.key === 'ArrowUp') { event.preventDefault(); open(); if (links.length) activate(active < 0 ? event.key === 'ArrowDown' ? 0 : links.length - 1 : (active + (event.key === 'ArrowDown' ? 1 : -1) + links.length) % links.length); }
  if (event.key === 'Enter' && !panel.hidden && active >= 0 && links[active]) { event.preventDefault(); location.href = links[active].href; }
});
form.addEventListener('submit', event => { if (!input.value.trim()) { event.preventDefault(); input.focus(); open(); } });
form.addEventListener('click', () => { if (document.activeElement !== input) input.focus(); });
launcher.addEventListener('focusout', event => { if (!launcher.contains(event.relatedTarget as Node | null)) close(); });
document.addEventListener('click', event => { if (!launcher.contains(event.target as Node)) close(); });
document.addEventListener('keydown', event => {
  const typing = event.target instanceof HTMLInputElement || event.target instanceof HTMLTextAreaElement || (event.target instanceof HTMLElement && event.target.isContentEditable);
  if (((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') || (event.key === '/' && !typing && !event.ctrlKey && !event.metaKey)) { event.preventDefault(); input.focus(); open(); }
  if (event.key === 'Escape') close();
});
if (location.pathname === '/search/') input.value = new URLSearchParams(location.search).get('q') || '';
</script>
