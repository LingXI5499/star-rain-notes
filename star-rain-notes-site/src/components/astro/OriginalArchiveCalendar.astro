---
import {catalog} from '../../utils/content';
const months=[...new Set(catalog.blogs.map(b=>b.publishedAt.slice(0,7)))];
---
<section class="archive-calendar" aria-label="发布日历"><header class="archive-calendar__head"><div><span>发布日期</span><h2 data-calendar-title>{months[0].slice(0,4)} 年 {Number(months[0].slice(5))} 月</h2></div><select data-calendar-select aria-label="选择归档月份">{months.map(month=><option value={month}>{month.slice(0,4)} 年 {Number(month.slice(5))} 月 · {catalog.blogs.filter(p=>p.publishedAt.startsWith(month)).length} 篇</option>)}</select></header>{months.map((month,index)=>{const year=Number(month.slice(0,4)),m=Number(month.slice(5)),blanks=(new Date(Date.UTC(year,m-1,1)).getUTCDay()+6)%7,days=new Date(Date.UTC(year,m,0)).getUTCDate();return <div class="archive-calendar__grid" id={`month-${month}`} data-calendar-grid={month} role="grid" aria-label={`${year} 年 ${m} 月发布日历`} hidden={index>0}>{['一','二','三','四','五','六','日'].map(day=><span class="archive-calendar__weekday">{day}</span>)}{Array.from({length:blanks}).map(()=><span aria-hidden="true"/>)}{Array.from({length:days},(_,i)=>i+1).map(day=>{const date=`${month}-${String(day).padStart(2,'0')}`,count=catalog.blogs.filter(p=>p.publishedAt===date).length;return <button type="button" class="archive-calendar__day" data-calendar-day={date} disabled={!count} aria-pressed="false" aria-label={`${m} 月 ${day} 日，${count} 篇文章`}><strong>{day}</strong>{count>0&&<small>{count} 篇</small>}</button>})}</div>})}</section>
<script>
document.querySelectorAll<HTMLElement>('.archive-calendar').forEach(calendar=>{const select=calendar.querySelector<HTMLSelectElement>('[data-calendar-select]')!,title=calendar.querySelector<HTMLElement>('[data-calendar-title]')!,scope=calendar.closest<HTMLElement>('[data-filter-scope],[data-blog-filter]')!;const initial=new URLSearchParams(location.search).get('month')||location.hash.match(/^#month-(\d{4}-\d{2})$/)?.[1];function show(month:string){select.value=month;calendar.querySelectorAll<HTMLElement>('[data-calendar-grid]').forEach(grid=>grid.hidden=grid.dataset.calendarGrid!==month);title.textContent=`${month.slice(0,4)} 年 ${Number(month.slice(5))} 月`}if(initial)show(initial.slice(0,7));select.addEventListener('change',()=>{show(select.value);scope.dispatchEvent(new CustomEvent('static-date-filter',{detail:select.value}))});calendar.querySelectorAll<HTMLButtonElement>('[data-calendar-day]').forEach(button=>button.addEventListener('click',()=>{const active=button.getAttribute('aria-pressed')!=='true';calendar.querySelectorAll<HTMLButtonElement>('[data-calendar-day]').forEach(b=>{b.setAttribute('aria-pressed',String(active&&b===button));b.classList.toggle('is-selected',active&&b===button)});scope.dispatchEvent(new CustomEvent('static-date-filter',{detail:active?button.dataset.calendarDay:select.value}))}))});
</script>
